# Exact-source admission for both fetched and offline Jolt trees.
# The manifest is metadata derived from the hash-verified upstream archive.
function(cyrus_collision_verify_jolt_source source_root manifest_path)
    if(NOT IS_DIRECTORY "${source_root}")
        message(FATAL_ERROR "Cyrus collision: Jolt source directory is unavailable: ${source_root}")
    endif()
    file(STRINGS "${manifest_path}" records ENCODING UTF-8)
    set(expected_paths)
    set(verified_count 0)
    foreach(record IN LISTS records)
        if(record MATCHES "^#" OR record STREQUAL "")
            continue()
        endif()
        if(NOT record MATCHES "^([0-9a-f]+)  (.+)$")
            message(FATAL_ERROR "Cyrus collision: invalid source-manifest record")
        endif()
        set(expected_hash "${CMAKE_MATCH_1}")
        set(relative_path "${CMAKE_MATCH_2}")
        string(LENGTH "${expected_hash}" hash_length)
        if(NOT hash_length EQUAL 64 OR relative_path MATCHES "(^|/)\\.\\.(/|$)" OR IS_ABSOLUTE "${relative_path}")
            message(FATAL_ERROR "Cyrus collision: invalid source-manifest identity")
        endif()
        set(input_path "${source_root}/${relative_path}")
        if(NOT EXISTS "${input_path}" OR IS_DIRECTORY "${input_path}" OR IS_SYMLINK "${input_path}")
            message(FATAL_ERROR "Cyrus collision: missing/nonregular pinned Jolt file: ${relative_path}")
        endif()
        file(SHA256 "${input_path}" actual_hash)
        if(NOT actual_hash STREQUAL expected_hash)
            message(FATAL_ERROR "Cyrus collision: pinned Jolt source mismatch in ${relative_path}; expected ${expected_hash}, got ${actual_hash}. Use an unchanged exact-archive extraction.")
        endif()
        list(APPEND expected_paths "${relative_path}")
        math(EXPR verified_count "${verified_count} + 1")
    endforeach()
    # Reject extra source/build files, not merely changes to the expected ones.
    file(GLOB_RECURSE actual_paths LIST_DIRECTORIES false RELATIVE "${source_root}"
        "${source_root}/Jolt/*" "${source_root}/Build/*")
    list(APPEND actual_paths "LICENSE")
    list(SORT actual_paths)
    list(SORT expected_paths)
    if(NOT actual_paths STREQUAL expected_paths)
        message(FATAL_ERROR "Cyrus collision: source file inventory differs from the pinned Jolt/Build/LICENSE manifest; use an out-of-source build and an unchanged archive extraction.")
    endif()
    message(STATUS "Cyrus collision: verified ${verified_count} exact Jolt source/build/license files at 1b2e77e3c6c09709e5edc79dc208459b8ff32051")
endfunction()

# Optional direct integrity check, independent of compiler or network.
if(DEFINED CYRUS_JOLT_VERIFY_ROOT)
    cyrus_collision_verify_jolt_source("${CYRUS_JOLT_VERIFY_ROOT}" "${CMAKE_CURRENT_LIST_DIR}/jolt-source.sha256")
endif()
