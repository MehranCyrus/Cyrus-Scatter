{
  "$defs": {
    "DisplaySettings": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "proxy",
          "enum": [
            "point_cloud",
            "proxy",
            "mesh",
            "centres"
          ],
          "title": "Mode",
          "type": "string"
        },
        "proxy_shape": {
          "default": "box",
          "enum": [
            "box",
            "sphere",
            "pyramid"
          ],
          "title": "Proxy Shape",
          "type": "string"
        },
        "instances_per_population": {
          "default": 2000,
          "maximum": 100000,
          "minimum": 1,
          "title": "Instances Per Population",
          "type": "integer"
        },
        "faces_per_population": {
          "default": 2000000,
          "maximum": 20000000,
          "minimum": 12,
          "title": "Faces Per Population",
          "type": "integer"
        },
        "point_budget": {
          "default": 20000,
          "maximum": 500000,
          "minimum": 1000,
          "title": "Point Budget",
          "type": "integer"
        },
        "points_per_plant": {
          "default": 80,
          "maximum": 10000,
          "minimum": 10,
          "title": "Points Per Plant",
          "type": "integer"
        },
        "show_preview": {
          "default": true,
          "title": "Show Preview",
          "type": "boolean"
        },
        "update_mode": {
          "default": "manual",
          "enum": [
            "manual",
            "real_time"
          ],
          "title": "Update Mode",
          "type": "string"
        }
      },
      "title": "DisplaySettings",
      "type": "object"
    },
    "Layer": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]*$",
          "title": "Name",
          "type": "string"
        },
        "region_id": {
          "pattern": "^[A-Za-z0-9_-]{1,96}$",
          "title": "Region Id",
          "type": "string"
        },
        "count": {
          "maximum": 2000,
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "seed": {
          "maximum": 2147483646,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "scale": {
          "items": {
            "maximum": 10.0,
            "minimum": 0.01,
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Scale",
          "type": "array"
        },
        "yaw_degrees": {
          "items": {
            "maximum": 360.0,
            "minimum": -360.0,
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Yaw Degrees",
          "type": "array"
        },
        "underfill": {
          "enum": [
            "allow",
            "reject"
          ],
          "title": "Underfill",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/LayerSettings"
        },
        "exclude_region_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,96}$",
            "type": "string"
          },
          "maxItems": 6,
          "title": "Exclude Region Ids",
          "type": "array"
        }
      },
      "required": [
        "name",
        "region_id",
        "count",
        "seed",
        "sources",
        "scale",
        "yaw_degrees",
        "underfill"
      ],
      "title": "Layer",
      "type": "object"
    },
    "LayerSettings": {
      "additionalProperties": false,
      "properties": {
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "self_spacing_enabled": {
          "default": false,
          "title": "Self Spacing Enabled",
          "type": "boolean"
        },
        "self_radius_factor": {
          "default": 1,
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Self Radius Factor",
          "type": "number"
        },
        "self_gap_m": {
          "default": 0,
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Self Gap M",
          "type": "number"
        },
        "self_planar": {
          "default": false,
          "title": "Self Planar",
          "type": "boolean"
        },
        "cleanup_enabled": {
          "default": false,
          "title": "Cleanup Enabled",
          "type": "boolean"
        },
        "neighbor_radius_m": {
          "default": 1,
          "maximum": 1000.0,
          "minimum": 1e-06,
          "title": "Neighbor Radius M",
          "type": "number"
        },
        "minimum_neighbors": {
          "default": 2,
          "maximum": 10000,
          "minimum": 0,
          "title": "Minimum Neighbors",
          "type": "integer"
        },
        "minimum_island": {
          "default": 5,
          "maximum": 100000,
          "minimum": 0,
          "title": "Minimum Island",
          "type": "integer"
        },
        "planar_cleanup": {
          "default": true,
          "title": "Planar Cleanup",
          "type": "boolean"
        },
        "align_normal": {
          "default": true,
          "title": "Align Normal",
          "type": "boolean"
        },
        "scale_x": {
          "default": [
            1,
            1
          ],
          "items": {
            "maximum": 10.0,
            "minimum": 0.01,
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Scale X",
          "type": "array"
        },
        "scale_y": {
          "default": [
            1,
            1
          ],
          "items": {
            "maximum": 10.0,
            "minimum": 0.01,
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Scale Y",
          "type": "array"
        },
        "scale_z": {
          "default": [
            1,
            1
          ],
          "items": {
            "maximum": 10.0,
            "minimum": 0.01,
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Scale Z",
          "type": "array"
        },
        "rotation_x_degrees": {
          "default": [
            0,
            0
          ],
          "items": {
            "maximum": 360.0,
            "minimum": -360.0,
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Rotation X Degrees",
          "type": "array"
        },
        "rotation_y_degrees": {
          "default": [
            0,
            0
          ],
          "items": {
            "maximum": 360.0,
            "minimum": -360.0,
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Rotation Y Degrees",
          "type": "array"
        },
        "movement_x_m": {
          "default": [
            0,
            0
          ],
          "items": {
            "maximum": 100.0,
            "minimum": -100.0,
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Movement X M",
          "type": "array"
        },
        "movement_y_m": {
          "default": [
            0,
            0
          ],
          "items": {
            "maximum": 100.0,
            "minimum": -100.0,
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Movement Y M",
          "type": "array"
        }
      },
      "title": "LayerSettings",
      "type": "object"
    },
    "PairRule": {
      "additionalProperties": false,
      "properties": {
        "a": {
          "maximum": 2,
          "minimum": 0,
          "title": "A",
          "type": "integer"
        },
        "b": {
          "maximum": 2,
          "minimum": 0,
          "title": "B",
          "type": "integer"
        },
        "gap_m": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Gap M",
          "type": "number"
        },
        "radius_factor": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Radius Factor",
          "type": "number"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "planar": {
          "title": "Planar",
          "type": "boolean"
        }
      },
      "required": [
        "a",
        "b",
        "gap_m",
        "radius_factor",
        "planar"
      ],
      "title": "PairRule",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^[A-Za-z0-9_-]{1,96}$",
          "title": "Source Id",
          "type": "string"
        },
        "weight": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Weight",
          "type": "number"
        },
        "settings": {
          "$ref": "#/$defs/SourceSettings"
        }
      },
      "required": [
        "source_id",
        "weight"
      ],
      "title": "Source",
      "type": "object"
    },
    "SourceSettings": {
      "additionalProperties": false,
      "properties": {
        "scale": {
          "default": 1,
          "maximum": 10.0,
          "minimum": 0.01,
          "title": "Scale",
          "type": "number"
        },
        "z_offset_m": {
          "default": 0,
          "maximum": 100.0,
          "minimum": -100.0,
          "title": "Z Offset M",
          "type": "number"
        },
        "radius_m": {
          "default": 0,
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Radius M",
          "type": "number"
        },
        "radius_follows_scale": {
          "default": true,
          "title": "Radius Follows Scale",
          "type": "boolean"
        },
        "show_radius": {
          "default": false,
          "title": "Show Radius",
          "type": "boolean"
        },
        "forward_axis": {
          "default": 1,
          "maximum": 4,
          "minimum": 1,
          "title": "Forward Axis",
          "type": "integer"
        }
      },
      "title": "SourceSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.73",
      "enum": [
        "0.73"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "context_id": {
      "pattern": "^[A-Za-z0-9_-]{1,96}$",
      "title": "Context Id",
      "type": "string"
    },
    "name": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f]*$",
      "title": "Name",
      "type": "string"
    },
    "layers": {
      "items": {
        "$ref": "#/$defs/Layer"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Layers",
      "type": "array"
    },
    "controller_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_-]{1,96}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Controller Id"
    },
    "generation_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_-]{1,96}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generation Id"
    },
    "clearance_m": {
      "default": 0,
      "maximum": 100.0,
      "minimum": 0.0,
      "title": "Clearance M",
      "type": "number"
    },
    "display": {
      "$ref": "#/$defs/DisplaySettings"
    },
    "pair_rules": {
      "items": {
        "$ref": "#/$defs/PairRule"
      },
      "maxItems": 3,
      "title": "Pair Rules",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "context_id",
    "name",
    "layers"
  ],
  "title": "DesignPlan",
  "type": "object"
}
