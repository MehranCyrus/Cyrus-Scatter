{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cyrus://plan-schema",
  "title": "Cyrus approved scatter plan 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "context_id", "name", "layers"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "context_id": {"$ref": "#/$defs/id"},
    "name": {"$ref": "#/$defs/label"},
    "controller_id": {"$ref": "#/$defs/id"},
    "generation_id": {"$ref": "#/$defs/id"},
    "clearance_m": {"type": "number", "minimum": 0, "maximum": 100},
    "layers": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/layer"}}
  },
  "dependentRequired": {"controller_id": ["generation_id"], "generation_id": ["controller_id"]},
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,96}$"},
    "label": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f]*$"},
    "scale": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0.01, "maximum": 10}},
    "yaw": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -360, "maximum": 360}},
    "layer": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "region_id", "count", "seed", "sources", "scale", "yaw_degrees", "underfill"],
      "properties": {
        "name": {"$ref": "#/$defs/label"},
        "region_id": {"$ref": "#/$defs/id"},
        "count": {"type": "integer", "minimum": 0, "maximum": 2000},
        "seed": {"type": "integer", "minimum": 0, "maximum": 2147483646},
        "scale": {"$ref": "#/$defs/scale"},
        "yaw_degrees": {"$ref": "#/$defs/yaw"},
        "underfill": {"enum": ["allow", "reject"]},
        "sources": {"type": "array", "minItems": 1, "maxItems": 3, "items": {
          "type": "object", "additionalProperties": false, "required": ["source_id", "weight"],
          "properties": {"source_id": {"$ref": "#/$defs/id"}, "weight": {"type": "number", "minimum": 0, "maximum": 1}}
        }}
      }
    }
  }
}
