# ============================================
# Cyrus Scatter - Git Ignore
# ============================================

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Temporary / backup files
*.tmp
*.temp
*.bak
*.backup
*.log
# Keep deliberately archived build logs needed to verify research manifests.
!docs/**/evidence/**/*.log
*~
~$*

# 3ds Max temporary / backup files
autoback/
Autoback/
*.max.bak

# Visual Studio
.vs/
bin/
obj/
Debug/
Release/
x64/
x86/

# Visual Studio user-specific
*.user
*.suo
*.userosscache
*.sln.docstates

# Build artifacts
*.pdb
*.ilk
*.iobj
*.ipdb

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# Build / distribution output
build/
dist/
artifacts/
out/

# Local scenes, handoffs, exports and one-off scratch work are not source backups.
/_local/
/Test Scene/
/output/
/tmp/
/Boss Handoff - Max 2026/
/*.zip

# Compiled plugins, SDK binaries, installers and scene assets belong in local output.
*.dlx
*.dlm
*.dlo
*.dlh
*.dll
*.exe
*.lib
*.obj
*.mzp
*.max
*.cgeo
*.7z
*.rar

# Environment / secrets
.env
.env.*
!.env.example

# Licensing secrets
secrets/
private/
*.pem
*.pfx
*.p12
*.key

# Code signing
certificates/
signing/

# Local configuration
*.local.json
config.local.*
settings.local.*
