    try{ra::Json out={{"version",1},{"layers",ra::Json::array()}};const double unit=GetSystemUnitScale(UNITS_METERS);std::size_t charged=0;
        for(int i=0;i<owners->size;++i){type_check(owners->data[i],Array,_T("recipe owner"));auto* owner=static_cast<Array*>(owners->data[i]);if(owner->size!=3)throw std::invalid_argument("Invalid recipe Edit owner");auto found=m->layers.find(owner->data[0]->to_int());if(found==m->layers.end())continue;auto layer=found->second;if(!layer.hasAuthored()&&!layer.recipeUnbound)continue;
            const auto expected=std::wstring(owner->data[2]->to_string());if(!layer.recipeUnbound){if(!layer.input||!layer.input->native)throw std::invalid_argument("Update this edited scatter before saving its recipe");bindStable(layer,expected,ce::make<EditDerived>(*layer.input));}
            if(!layer.sourceAware||!layer.lineages||!layer.legacyProof.empty())throw std::invalid_argument("Recipe edits require resolved source history. Update the matching original setup first");const auto descriptor=cyrus::editbinding::parse(receiverUTF8(layer.signature));ra::Json rows=ra::Json::array();
            for(std::size_t j=0;j<layer.rows.size();++j){const auto& r=layer.rows.get(j);const auto index=layer.input?layer.source(r):UINT_MAX;if(!authoredEdit(r)&&!r.recipeLocal&&(index==UINT_MAX||r.order==index))continue;
                if(!r.lineage)throw std::invalid_argument("Recipe Edit has unresolved source lineage");const auto& lineage=layer.lineages->ids.at(r.lineage-1);const auto source=receiverUTF8(std::wstring(lineage.begin(),lineage.end()));auto rev=cyrus::editbinding::sourceRevision(descriptor,source);if(!rev)throw std::invalid_argument("Recipe Edit source evidence is missing");auto matrix=r.delta;bool local=r.recipeLocal;if(!local&&index!=UINT_MAX){auto base=layer.input->matrix(index);matrix=base*matrix*recipeEditInverse(base);local=true;}
                ra::Json encoded={{"input",receiverUTF8(r.inputId.text())},{"output",receiverUTF8(r.outputId.text())},{"source",source},{"revision",*rev},{"order",r.order},{"delta",recipeMatrix(matrix,unit)},{"deleted",r.deleted},{"local",local}};charged+=encoded.dump().size()+1;if(charged>ra::maxBytes)throw std::length_error("Recipe Edit exceeds 8 MiB; save fewer edited layers");rows.push_back(std::move(encoded));}
            if(!rows.empty())out["layers"].push_back({{"owner",receiverUTF8(owner->data[1]->to_string())},{"rows",std::move(rows)}});
        }ra::validateEdits(out);if(out["layers"].empty())return new String(_T(""));auto text=out.dump();if(text.size()>ra::maxBytes)throw std::length_error("Recipe Edit exceeds 8 MiB; save fewer edited layers");return new String(receiverWide(text).c_str());
    }catch(const std::exception& e){throw RuntimeError(MSTR::FromACP(e.what()));}}
def_visible_primitive(cyrusEditRecipeCloneMap,"cyrusEditRecipeCloneMap");
Value* cyrusEditRecipeCloneMap_cf(Value** a,int n){check_arg_count(cyrusEditRecipeCloneMap,1,n);type_check(a[0],Array,_T("Edit recipe payloads"));try{ra::Json map=ra::Json::object();auto* array=static_cast<Array*>(a[0]);for(int i=0;i<array->size;++i){auto data=ra::parseEdits(receiverUTF8(array->data[i]->to_string()));for(const auto& l:data["layers"])for(const auto& r:l["rows"])if(r["input"]!=r["output"]){const auto key=r["output"].get<std::string>();if(!map.contains(key))map[key]=receiverUTF8(pointId());}}return new String(receiverWide(map.dump()).c_str());}catch(const std::exception& e){throw RuntimeError(MSTR::FromACP(e.what()));}}
