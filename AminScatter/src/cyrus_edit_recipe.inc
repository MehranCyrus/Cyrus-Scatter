        for(const auto& saved:document["layers"]){Array* binding=nullptr;for(int k=0;k<bindings->size;++k){type_check(bindings->data[k],Array,_T("Edit owner binding"));auto* row=static_cast<Array*>(bindings->data[k]);if(row->size!=3)throw std::invalid_argument("Invalid Edit owner binding");if(receiverUTF8(row->data[0]->to_string())==saved["owner"].get<std::string>()){if(binding)throw std::invalid_argument("Duplicate recipe owner binding");binding=row;}}if(!binding)throw std::invalid_argument("Missing recipe Edit layer binding");const auto key=binding->data[1]->to_int();if(key<=0||next.count(key))throw std::invalid_argument("Recipe Edit layer already has records");type_check(binding->data[2],Array,_T("recipe source bindings"));auto* sourceMap=static_cast<Array*>(binding->data[2]);EditLayer layer;layer.sourceAware=true;layer.recipeUnbound=true;auto ids=ce::make<EditLineages>();cyrus::editbinding::Descriptor descriptor;
