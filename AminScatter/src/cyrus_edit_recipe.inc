static ra::Json recipeMatrix(Matrix3 m,double unit){ra::Json v=ra::Json::array();for(int k=0;k<4;++k)for(int c=0;c<3;++c)v.push_back(double(m.GetRow(k)[c])*(k==3?unit:1.));return v;}
static Matrix3 recipeMatrix(const ra::Json& j,double unit){Matrix3 m(1);for(int k=0;k<4;++k)m.SetRow(k,Point3(float(j[k*3].get<double>()/(k==3?unit:1.)),float(j[k*3+1].get<double>()/(k==3?unit:1.)),float(j[k*3+2].get<double>()/(k==3?unit:1.))));if(!finiteEditMatrix(m))throw std::invalid_argument("Recipe Edit transform exceeds host precision");return m;}
