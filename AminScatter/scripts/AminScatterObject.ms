        spinner movZMaxSpin "" range:[-100000,100000,0] type:#worldUnits pos:[((randomUI_8.width+18)/2),512] fieldWidth:((randomUI_8.width-38)/2) width:((randomUI_8.width-38)/2)
        checkbox projectCheck "Keep on surface" pos:[4,576] width:(randomUI_8.width-8)
