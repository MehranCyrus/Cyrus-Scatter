fn CyrusInteractionHeld = (try((dotNetClass "System.Windows.Forms.Control").MouseButtons != (dotNetClass "System.Windows.Forms.MouseButtons").None)catch(false))
global CyrusFallPack,CyrusFallUnpack,CyrusOpenFalloffGraph,CyrusFallValidPackedGraph,CyrusFallGraphsEqual
-- PB2 curve samples and editable coordinates are Float values. Nine significant
-- digits retain those values; ordinary display formatting is not serialization.
fn CyrusFallPack values = (local s=stringStream "";for i=1 to values.count do format "% %" (formattedPrint (values[i] as float) format:".9g" userLocale:false) (if i<values.count then "," else "") to:s;s as string)
fn CyrusFallUnpack data = (for v in filterString data "," collect (v as float))
fn CyrusFallValidPackedGraph packed = (
    if packed.count<16 or packed.count>2056 or mod packed.count 8!=0 do return false
    local previous=-1.0
    for i=1 to packed.count by 8 do (
        for j=0 to 7 do if packed[i+j]!=packed[i+j] or abs packed[i+j]>1e8 do return false
        if packed[i]<0 or packed[i]>1 or packed[i]<=previous do return false
        if findItem #(0,1) packed[i+6]==0 or findItem #(0,1) packed[i+7]==0 do return false
        previous=packed[i]
    )
    packed[1]==0 and packed[packed.count-7]==1
)
fn CyrusFallGraphsEqual a b = (
    if a==b do return true
    if a=="" or b=="" or a.count>65536 or b.count>65536 do return false
    local left=try(CyrusFallUnpack a)catch(undefined),right=try(CyrusFallUnpack b)catch(undefined)
    if left==undefined or right==undefined do return false
    if not CyrusFallValidPackedGraph left or not CyrusFallValidPackedGraph right or left.count!=right.count do return false
    for i=1 to left.count where left[i]!=right[i] do return false
    true
)
global CyrusFalloffGraph,CyrusFallGraphTarget,CyrusFallGraphArea,CyrusFallGraphDensity,CyrusFallGraphBandID=0,CyrusFallGraphMeshMask=false,CyrusFallGraphImageMask=false
global CyrusFallGraphOwnerRoot,CyrusFallGraphOwnerNode
fn CyrusOpenFalloffGraph target areaNode density bandID:0 meshMask:false imageMask:false = (
    local bandRoot=undefined,bandNode=undefined
    if bandID>0 and findItem target.strokeIDs bandID==0 do throw "The selected Band no longer exists."
    for node in refs.dependentNodes target where isValidNode node and classof node.baseObject==AminScatterObject do (
        local candidate=node.baseObject,parent=try(candidate.logicalParent target)catch(undefined)
        if parent!=undefined and findItem candidate.layerObjects parent>0 do (
            if bandNode!=undefined and bandNode!=node do throw "The curve owner must belong to one Scatter controller."
            bandRoot=candidate;bandNode=node
        )
    )
    if bandRoot==undefined do throw "The curve controller is no longer in this scene."
    if CyrusFalloffGraph!=undefined do try(destroyDialog CyrusFalloffGraph)catch()
    rollout editor "Area Falloff - Edit Graph" width:760 height:505 (
        local obj,area,isDensity=false,isMeshMask=false,isImageMask=false,loading=true,ownerRoot=undefined,ownerNode=undefined,ownerLayerID="",ownerBandID=0,ownerPathID=0,invalidated=false,curveTimer=undefined,pendingCurve=false,lastGraphTrace="",lastPresetTrace="",presetStoredValues=undefined,presetStoredGraph="",graphEdited=false
        curveControl graph "" pos:[8,8] width:744 height:396 numCurves:1 x_range:[0,1] y_range:[0,100] commandMode:#move_xy asPopup:false
        button presetsButton "Presets..." pos:[12,464] width:120
        button applyButton "Apply" pos:[538,424] width:100
        button doneButton "Close" pos:[648,424] width:100
        label help "X: distance along ramp (0 to 1). Y: percent. Drag points / edit Bezier handles." pos:[12,424] width:510 height:36
        fn bandTargetRow = (
            if ownerBandID==0 do return 0
            if invalidated do return 0
            local row=0,valid=false
            try (
                row=findItem obj.strokeIDs ownerBandID
                valid=isValidNode ownerNode and ownerNode.baseObject==ownerRoot and findItem ownerRoot.layerObjects obj>0 and obj.layerID==ownerLayerID and row>0
                if valid do valid=obj.strokePathIDs[row]==ownerPathID
            )catch(valid=false)
            if not valid do (invalidated=true;applyButton.enabled=false;help.text="This Band target is no longer available. Close and reopen its graph.")
            if valid then row else 0
        )
        fn bandSamples = (if isDensity then obj.strokeCurveSamples else obj.strokeScaleSamples)
        fn bandGraphs = (if isDensity then obj.strokeCurveGraphs else obj.strokeScaleGraphs)
        fn curveTrace = (
            local curve=graph.curves[1],packed=#()
            if curve.numPoints<2 do return undefined
            if curve.numPoints>257 do (help.text="Curves support at most 257 control points. Remove excess points before Apply.";return undefined)
            for i=1 to curve.numPoints do (
                local p=curve.points[i]
                join packed #(p.value.x,p.value.y,p.inTangent.x,p.inTangent.y,p.outTangent.x,p.outTangent.y,(if p.bezier then 1 else 0),(if p.corner then 1 else 0))
            )
            local values=for i=0 to 256 collect (
                local v=amax 0.0 ((getValue curve 0 (i/256.0))/100.0)
                if ownerBandID>0 and not isDensity and (v>100 or v!=v) do throw "Band scale curve exceeds 10000% or is non-finite."
                if isDensity or obj.isPaintArea then amin 1.0 v else v
            )
            #(values,CyrusFallPack values,CyrusFallPack packed)
        )
        fn storeCurve = (
            pendingCurve=false
            if curveTimer!=undefined do curveTimer.Stop()
            if invalidated do return false
            if not loading do (
                -- Loading a saved graph does not authorize resampling it or
                -- replacing an older packed representation on Apply/Close.
                if not graphEdited do return true
                local bandRow=bandTargetRow()
                if ownerBandID>0 and bandRow==0 do return false
                local trace=curveTrace()
                if trace==undefined do return false
                local values=trace[1],packedValues=trace[2],packedGraph=trace[3],identity=trace[3]
                if isMeshMask do (
                    if not isValidNode ownerNode or ownerNode.baseObject!=ownerRoot or findItem ownerRoot.layerObjects obj==0 or obj.layerID!=ownerLayerID do (
                        invalidated=true;applyButton.enabled=false;help.text="This mesh mask owner was removed. Close and reopen its graph.";return false
                    )
                    if identity==lastGraphTrace do return true
                    local changed=(CyrusFallPack (if isImageMask then (if obj.densityResponseSamples.count==0 then #(0.0,1.0) else obj.densityResponseSamples as array) else obj.meshMaskCurve()))!=packedValues
                    undo "Cyrus mesh density curve" on (
                        if isImageMask then (if changed do obj.densityResponseSamples=values;obj.densityResponseGraph=packedGraph)
                        else (if changed do obj.meshMaskSamples=values;obj.meshMaskGraph=packedGraph)
                    )
                    lastGraphTrace=identity
                    if changed do CyrusViewportRedraw()
                    return true
                )
                -- Compare the canonical saved representation, not rounded
                -- control geometry, not the SDK's deferred sample cache.
                -- A close after external Undo must not reapply an unchanged UI.
                local cfg=if ownerBandID>0 then undefined else obj.getFallConfig area
                local curveIndex=if isDensity then 8 else 5
                local oldValues=if ownerBandID>0 then CyrusFallUnpack ((bandSamples())[bandRow]) else cfg[curveIndex]
                local oldGraph=if ownerBandID>0 then (bandGraphs())[bandRow] else obj.getFallGraph area isDensity
                if presetStoredValues!=undefined and ((CyrusFallPack oldValues)!=presetStoredValues or oldGraph!=presetStoredGraph) do (
                    invalidated=true;applyButton.enabled=false;presetsButton.enabled=false
                    help.text="This curve changed outside the graph. Close and reopen it to continue."
                    return false
                )
                if identity==lastPresetTrace do return true
                lastPresetTrace="";presetStoredValues=undefined
                if ownerBandID>0 and identity==lastGraphTrace do return true
                local samplesChanged=oldValues.count!=values.count
                if not samplesChanged do for i=1 to values.count where oldValues[i]!=values[i] do samplesChanged=true
                -- Browsing an already stored curve has no authored or display
                -- effect. In particular, do not force pending post-save native
                -- presentation work from an unchanged editor close.
                if not samplesChanged and CyrusFallGraphsEqual oldGraph packedGraph do (lastGraphTrace=identity;return true)
                if ownerBandID==0 do cfg[curveIndex]=values
                if ownerBandID>0 then (
                    local samples=bandSamples(),graphs=bandGraphs()
                    if samples[bandRow]!=packedValues or graphs[bandRow]!=packedGraph do undo "Cyrus Band curve" on (
                        if isDensity then (obj.strokeCurveSamples[bandRow]=packedValues;obj.strokeCurveGraphs[bandRow]=packedGraph)
                        else (obj.strokeScaleSamples[bandRow]=packedValues;obj.strokeScaleGraphs[bandRow]=packedGraph)
                    )
                    lastGraphTrace=identity
                ) else if obj.isPaintArea then (
                    -- Max can update its sampled values after the point-change event.
                    -- Apply/Close must also compare samples, even for identical handles.
                    if samplesChanged or (obj.getFallGraph area isDensity)!=packedGraph do undo "Cyrus vector curve" on (
                        obj.setFallConfig area cfg
                        obj.setFallGraph area isDensity packedGraph
                    )
                ) else (
                    if samplesChanged or (obj.getFallGraph area isDensity)!=packedGraph do (
                        obj.setFallConfig area cfg
                        obj.setFallGraph area isDensity packedGraph
                    )
                )
                CyrusViewportRedraw()
            )
            true
        )
        fn presetTargetValid = (
            if invalidated do return false
            local valid=isValidNode ownerNode and ownerNode.baseObject==ownerRoot and obj.layerID==ownerLayerID
            if valid do (
                local parent=try(ownerRoot.logicalParent obj)catch(undefined)
                valid=parent!=undefined and findItem ownerRoot.layerObjects parent>0
                if valid and obj.isPaintArea do valid=findItem parent.paintAreas obj>0
                if valid and area!=undefined do valid=isValidNode area and findItem obj.areaNodes area>0
                if valid and ownerBandID>0 do valid=bandTargetRow()>0
            )
            valid
        )
        fn presetEnabled = (
            if not presetTargetValid() do return false
            if ownerBandID>0 then (local row=bandTargetRow();if isDensity then obj.strokeCurveEnabled[row] else obj.strokeScaleModes[row]==3)
            else (obj.getFallConfig area)[if isDensity then 6 else 3]
        )
        fn presetValues = (
            if not presetTargetValid() do throw "The curve target was removed or replaced."
            local trace=curveTrace()
            if trace==undefined do throw "The curve has no valid editable representation."
            #(trace[1],CyrusFallUnpack trace[3],not isDensity and not obj.isPaintArea)
        )
        fn presetLoadGraph values = (
            local c=graph.curves[1],samples=values[1],packed=values[2]
            graph.y_range=[0,(if isDensity or obj.isPaintArea then 100 else amax 200.0 ((amax samples)*100))]
            c.numPoints=if packed.count>0 then packed.count/8 else samples.count
            for i=1 to c.numPoints do (
                -- ccPoint is detached. Editing c.points[i] updates the live SDK
                -- point on every property assignment, before setPoint's flags.
                local point=ccPoint [0,0] [0,0] [0,0] end:(i==1 or i==c.numPoints),j=(i-1)*8
                if packed.count>0 then (
                    point.value=[packed[j+1],packed[j+2]];point.inTangent=[packed[j+3],packed[j+4]];point.outTangent=[packed[j+5],packed[j+6]]
                    point.bezier=packed[j+7]>0;point.corner=packed[j+8]>0
                ) else (point.value=[(i-1.0)/(samples.count-1),samples[i]*100];point.bezier=false;point.corner=true)
                -- Full typed preset data is validated before this restoration.
                -- Initial SDK neighbors are not the destination graph yet.
                point.lock_x=(i==1 or i==c.numPoints);setPoint c i point checkConstraints:false
            )
            zoom graph #all
        )
        fn presetRestore state = (
            loading=true
            undo off (presetLoadGraph state[1])
            lastGraphTrace=state[2];lastPresetTrace=state[3];presetStoredValues=state[4];presetStoredGraph=state[5];graphEdited=state[6]
            loading=false;true
        )
        fn presetPrepare values = (
            if not presetTargetValid() do throw "The curve target was removed or replaced."
            if values[3] and (isDensity or obj.isPaintArea) do throw "This target requires a unit-range curve."
            local state=#(presetValues(),lastGraphTrace,lastPresetTrace,presetStoredValues,presetStoredGraph,graphEdited)
            if curveTimer!=undefined do curveTimer.Stop()
            pendingCurve=false;loading=true
            try (
                undo off (presetLoadGraph values)
                local trace=curveTrace(),samples=values[1]
                if trace==undefined do throw "Cannot reconstruct the preset graph."
                for i=1 to trace[1].count do (
                    local position=(i-1.0)*(samples.count-1)/256.0,lo=(floor position) as integer,hi=amin (samples.count-1) (lo+1)
                    local expected=samples[lo+1]+(samples[hi+1]-samples[lo+1])*(position-lo)
                    if abs (trace[1][i]-expected)>0.0001*(amax 1.0 (abs expected)) do throw "Preset handles do not match its sampled curve."
                )
                loading=false
            )catch(presetRestore state;throw())
            state
        )
        fn presetApply values = (
            graphEdited=true
            lastGraphTrace="";lastPresetTrace="";presetStoredValues=undefined
            if not storeCurve() do throw "The curve could not be stored."
            local trace=curveTrace(),row=bandTargetRow()
            lastPresetTrace=trace[3]
            presetStoredValues=if ownerBandID>0 then (bandSamples())[row] else CyrusFallPack ((obj.getFallConfig area)[if isDensity then 8 else 5])
            presetStoredGraph=if ownerBandID>0 then (bandGraphs())[row] else obj.getFallGraph area isDensity
            true
        )
        on presetsButton pressed do try(CyrusOpenPresets ownerRoot obj (if isDensity then "density_curve" else "scale_curve") editor:editor)catch(messageBox (getCurrentException()) title:"Cyrus presets")
        on editor open do (
            obj=CyrusFallGraphTarget;area=CyrusFallGraphArea;isDensity=CyrusFallGraphDensity;ownerBandID=CyrusFallGraphBandID;isImageMask=CyrusFallGraphImageMask;isMeshMask=CyrusFallGraphMeshMask or isImageMask
            ownerRoot=CyrusFallGraphOwnerRoot;ownerNode=CyrusFallGraphOwnerNode;ownerLayerID=obj.layerID
            if ownerBandID>0 do (
                local row=findItem obj.strokeIDs ownerBandID
                if row==0 do throw "The selected Band no longer exists."
                ownerPathID=obj.strokePathIDs[row]
            )
            editor.title=(if isDensity then "Area Density Falloff" else "Area Scale Falloff")+" - "+(if area==undefined then (if obj.isPaintArea then obj.paintSetName+" / Vector Border" else "Analyzer Boundary") else area.name)
            local row=bandTargetRow(),cfg=if ownerBandID>0 or isMeshMask then undefined else obj.getFallConfig area
            if ownerBandID>0 do (editor.title=(if isDensity then "Band Density - " else "Band Scale - ")+obj.bandName row;help.text="Band "+(ownerBandID as string)+". X: normalized Start to End. Y: "+(if isDensity then "density 0-100%." else "size percent; 100% = unchanged.")+" Drag applies on release.")
            local packed=CyrusFallUnpack (if isMeshMask then (if isImageMask then obj.densityResponseGraph else obj.meshMaskGraph) else if ownerBandID>0 then (bandGraphs())[row] else obj.getFallGraph area isDensity)
            local values=if isMeshMask then (if isImageMask then (if obj.densityResponseSamples.count==0 then #(0.0,1.0) else obj.densityResponseSamples as array) else obj.meshMaskCurve()) else if ownerBandID>0 then CyrusFallUnpack ((bandSamples())[row]) else cfg[if isDensity then 8 else 5]
            if isMeshMask do (
                editor.title=(if isImageMask then "Image Density - " else "Mesh Channel Density - ")+(ownerRoot.layerCaption obj)
                help.text="X: remapped channel value (after Invert). Y: planting eligibility 0-100%. Apply or release to update."
                presetsButton.enabled=false
            )
            local c=graph.curves[1];c.color=red
            graph.y_range=[0,(if isDensity then 100 else amax 200.0 ((amax values)*100))]
            -- Fit the full density domain before loading the authored curve.
            -- Zoom extents on a constant curve hides almost all of 0-100%.
            local densityZoom=undefined,densityScroll=undefined
            if ownerBandID>0 or isMeshMask do (
                c.numPoints=2
                local low=c.points[1],high=c.points[2]
                low.value=[0,0];high.value=[1,(if isDensity then 100 else amax 200.0 ((amax values)*100))]
                c.points[1]=low;c.points[2]=high
                zoom graph #all
                densityZoom=graph.zoomValues;densityScroll=graph.scrollValues
            )
            if packed.count>0 and not CyrusFallValidPackedGraph packed do throw "The stored curve graph is invalid or exceeds 257 points. Its saved settings were preserved."
            if packed.count>0 then (
                c.numPoints=packed.count/8
                for i=1 to c.numPoints do (
                    local j=(i-1)*8,p=ccPoint [0,0] [0,0] [0,0] end:(i==1 or i==c.numPoints)
                    p.value=[packed[j+1],packed[j+2]];p.inTangent=[packed[j+3],packed[j+4]];p.outTangent=[packed[j+5],packed[j+6]]
                    p.bezier=packed[j+7]>0;p.corner=packed[j+8]>0;p.lock_x=(i==1 or i==c.numPoints)
                    setPoint c i p checkConstraints:false
                )
            ) else (
                c.numPoints=values.count
                for i=1 to c.numPoints do (
                    local p=ccPoint [(i-1.0)/(c.numPoints-1),values[i]*100] [0,0] [0,0] corner:true end:(i==1 or i==c.numPoints)
                    p.lock_x=(i==1 or i==c.numPoints);setPoint c i p checkConstraints:false
                )
            )
            if ownerBandID>0 or isMeshMask then (graph.zoomValues=densityZoom;graph.scrollValues=densityScroll) else zoom graph #all
            if ownerBandID>0 or isMeshMask do (local trace=curveTrace();if trace!=undefined do lastGraphTrace=trace[3])
            loading=false
        )
        fn flushCurve sender args = (
            if pendingCurve and not (CyrusInteractionHeld()) do (pendingCurve=false;if curveTimer!=undefined do curveTimer.Stop();storeCurve())
        )
        fn retainCurveUndo = (
            -- View history remains live even after its authored owner has been
            -- invalidated. Retention must not depend on model edit permission.
            if loading or not theHold.Holding() do return false
            cyrusPresetTrackCurveUndo graph.curves[1]
        )
        fn queueCurve = (
            if loading do return false
            retainCurveUndo()
            graphEdited=true
            if ownerBandID==0 and not isMeshMask then storeCurve() else (
                pendingCurve=true
                if curveTimer==undefined do (curveTimer=dotNetObject "System.Windows.Forms.Timer";curveTimer.Interval=100;dotNet.addEventHandler curveTimer "Tick" flushCurve)
                -- Point-change callbacks can precede the control's sampled
                -- curve update. Commit in the next timer event, after release.
                curveTimer.Start()
            )
        )
        on graph selChanged ci val do retainCurveUndo()
        on graph ptChanged ci val do queueCurve()
        on graph tangentChanged ci val kind do queueCurve()
        on graph ptInserted ci val do queueCurve()
        on graph deleted ci val do queueCurve()
        on graph reset ci do queueCurve()
        on applyButton pressed do storeCurve()
        on doneButton pressed do (storeCurve();destroyDialog editor)
        on editor close do (if curveTimer!=undefined do (curveTimer.Stop();dotNet.removeEventHandler curveTimer "Tick" flushCurve;curveTimer.Dispose();curveTimer=undefined);pendingCurve=false;storeCurve();CyrusFalloffGraph=undefined)
    )
    CyrusFallGraphTarget=target;CyrusFallGraphArea=areaNode;CyrusFallGraphDensity=density;CyrusFallGraphBandID=bandID;CyrusFallGraphMeshMask=meshMask;CyrusFallGraphImageMask=imageMask
    CyrusFalloffGraph=editor
    CyrusFallGraphOwnerRoot=bandRoot;CyrusFallGraphOwnerNode=bandNode
    try(createDialog editor style:#(#style_titlebar,#style_sysmenu,#style_minimizebox) pos:[200,160])catch(
        editor.loading=true
        try(destroyDialog editor)catch()
        if CyrusFalloffGraph==editor do CyrusFalloffGraph=undefined
        throw()
    )
    editor
)

/* Scene object UI for the native AminScatter C++ engine. */
global AminScatterObject
global AminScatterObjectDraw
global CyrusAnalyzerFilter
fn CyrusAnalyzerFilter n = (isValidNode n and isProperty n #boundaryVertices and isProperty n #pathVertices and isProperty n #samplePoints)
global AminScatterAreaFilter
fn AminScatterAreaFilter n = (try(isValidNode n and aminScatterValidArea n)catch(false))
global AminScatterSourceFilter
fn AminScatterSourceFilter n = (
    isValidNode n and classof n.baseObject!=AminScatterObject and canConvertTo n Editable_Mesh
)
try(unRegisterRedrawViewsCallback AminScatterObjectDraw)catch()

global AminScatterSurfaceFilterFields=#(#slopeEnabled,#slopeMinimum,#slopeMaximum,#slopeLowerFade,#slopeUpperFade,#altitudeEnabled,#altitudeMinimum,#altitudeMaximum,#altitudeLowerFade,#altitudeUpperFade)
-- Reserve the documented session heap before large script transports can force
-- automatic full collection. This never changes the saved initial heap setting.
global CyrusScriptWorkspaceReserved=0L
global CyrusNativeCollectionMark=0L,CyrusNativeCollections=0L
fn CyrusNativeWorkingSetCheckpoint force:false = (
    -- Native payload is invisible to Max's script-heap pressure. Collect only
    -- after 64 MiB of placement allocation churn, at bounded stage boundaries.
    -- This bounds unrooted wrappers without a full scene scan on every edit.
    -- Live publications/history remain rooted. Never call from passive views.
    local allocated=(cyrusPlacementMemoryStats())[3]
    if force or allocated-CyrusNativeCollectionMark>=67108864L do (
        gc light:true
        CyrusNativeCollectionMark=allocated;CyrusNativeCollections+=1
    )
    true
)
fn CyrusReserveScriptWorkspace required = (
    if required<0 do throw "Invalid Update working-memory request."
    if heapFree<required do gc light:true
    if heapFree<required do (
        local before=heapSize,target=undefined,failure=""
        try (
            target=cyrusScriptMemoryTarget heapSize heapFree required
            heapSize=target
        ) catch(failure=getCurrentException())
        if failure!="" do throw ("Cannot reserve Update working memory without risking Undo: "+failure+". The previous complete result is retained.")
        CyrusScriptWorkspaceReserved+=amax 0L (heapSize-before)
    )
    if heapFree<required do throw "Update workspace reservation was insufficient. The previous complete result and Undo history are retained."
    true
)
global AminScatterLayerFields, AminScatterLayerTabs
global AminScatterCopyLayer, AminScatterRefreshLayerPanels
global CyrusReceiverVariationDomains,CyrusRemapLayerCorrespondence
global AminScatterMeshMaskFields=#(#meshMaskEnabled,#meshMaskChannel,#meshMaskComponent,#meshMaskMinimum,#meshMaskMaximum,#meshMaskInvert,#meshMaskSamples,#meshMaskGraph,#meshMaskSource)
AminScatterOrientationFields=#(#alignNormal,#orientationMode,#orientationBlend,#orientationX,#orientationY,#orientationZ,#orientationTarget,#sourceForwardAxes)
global AminScatterGridFields=#(#placementMode,#gridColumnWU,#gridRowWU,#gridOriginXWU,#gridOriginYWU,#gridHeading,#gridJitter)
AminScatterLayerFields=#(#placementMode,#gridColumnWU,#gridRowWU,#gridOriginXWU,#gridOriginYWU,#gridHeading,#gridJitter,#orientationMode,#orientationBlend,#orientationX,#orientationY,#orientationZ,#orientationTarget,#meshMaskEnabled,#meshMaskChannel,#meshMaskComponent,#meshMaskMinimum,#meshMaskMaximum,#meshMaskInvert,#meshMaskSamples,#meshMaskGraph,#slopeEnabled,#slopeMinimum,#slopeMaximum,#slopeLowerFade,#slopeUpperFade,#altitudeEnabled,#altitudeMinimum,#altitudeMaximum,#altitudeLowerFade,#altitudeUpperFade,#procOrder,#procSetOrder,#procSamplingSalt,#procPopulation,#procAttemptFactor,#procRounds,#procRepair,#procSelfOverride,#procSelfEnabled,#procSelfMultiplier,#procSelfGap,#procSelfPlanar,#procLayerSelfEnabled,#procLayerSelfMultiplier,#procLayerSelfGap,#procLayerSelfPlanar,#procSiblingEnabled,#procSiblingMultiplier,#procSiblingGap,#procSiblingPlanar,#procRadiusIDs,#procRadiusModes,#procRadiusValues,#procRadiusDistances,#procRadiusBinding,#procSourceNodes,#procSourceIDs,#procSourceSlots,#procReceiverNodes,#procReceiverIDs,#procReceiverVariationIDs,#procReceiverID,#containerMode,#containerNodes,#logicalParentID,#paintSetName,#paintSetEnabled,#paintSetVisible,#paintView,#paintColor,#paintDocument,#paintEnabled,#paintDensity,#streetTrimStart,#streetTrimEnd,#centerStreetOffset,#areaAnalyzer,#areaUseLine,#areaLineWidth,#areaLineCaps,#areaUsePoints,#areaPointRadius,#wholeScaleMin,#wholeScaleMax,#fallScaleGraph,#fallDensityGraph,#areaFallConfigs,#areaFallDeleteWidths,#areaFallScaleWidths,#areaFallDensityWidths,#areaFallScaleGraphs,#areaFallDensityGraphs,#fallAnalyzer,#fallDelete,#fallDeleteWidth,#fallScale,#fallScaleWidth,#fallScaleCurve,#fallDensity,#fallDensityWidth,#fallDensityCurve,#edgeRotX,#edgeRotY,#edgeRotZ,#edgeKeepCorners,#edgeCornerAngle,#edgeCornerCount,#edgeFaceOut,#edgeCornerRadius,#edgeOffsetsWU,#edgeAlongWU,#edgeAcrossWU,#borderFaceOut,#streetFaceOut,#borderCornerRadius,#streetCornerRadius,#sourceForwardAxes,#finalCleanup,#finalNeighborRadius,#finalMinNeighbors,#finalMinIsland,#finalRelax,#finalStrength,#finalIterations,#finalMaxMove,#sourceRadiiWU,#sourceAutoRadius,#sourceFollowScale,#sourceShowRadius,#streetStraight,#sourcePoint,#sourceEmpty,#cleanupPlanar,#sourceZOffsetsWU,#sourceScales,#sourceWeights,#showCenters,#relaxEnabled,#relaxSpacing,#relaxIterations,#relaxStrength,#sources,#bakedNodes,#amount,#randomSeed,#scaleMinimum,#scaleMaximum,#tiltDegrees,#yawMinimum,#yawMaximum,#movementRange,#alignNormal,#showPoints,#pointsPerPlant,#updateMode,#populationMode,#plantsPerM2,#advancedAxes,#projectMove,#rotXMin,#rotXMax,#rotYMin,#rotYMax,#rotZMin,#rotZMax,#sclXMin,#sclXMax,#sclYMin,#sclYMax,#sclZMin,#sclZMax,#movXMinWU,#movXMaxWU,#movYMinWU,#movYMaxWU,#movZMinWU,#movZMaxWU,#distributionMode,#densityMap,#invertDensity,#densityUVChannel,#densityResolution,#diversityMode,#diversitySize,#diversitySeed,#roughness,#blurryEdge,#diversityNoise,#autoRender,#previewBudget,#pointColorMode,#solidPointColor,#areaNodes,#areaModes,#sourceColors,#patternLines,#patternWidths,#fieldFalloff,#fieldBoundaries,#fieldCombined,#fieldSamples,#fieldBandID)
AminScatterImageDensityFields=#(#densityCoordinateMode,#densityWrapMode,#densityTileXWU,#densityTileYWU,#densityTileLock,#densityRepeatX,#densityRepeatY,#densityHeading,#densityOffsetXWU,#densityOffsetYWU,#densityUOffset,#densityVOffset,#densityPatternID,#densityPatternRevision,#densityResponseSamples,#densityResponseGraph,#densityMapProvenance,#densityFrameBasis,#densityFrameOriginWU)
join AminScatterLayerFields AminScatterImageDensityFields
append AminScatterLayerFields #meshMaskSource
AminScatterLayerTabs=#(#meshMaskSamples,#procRadiusIDs,#procRadiusModes,#procRadiusValues,#procRadiusDistances,#procSourceNodes,#procSourceIDs,#procSourceSlots,#procReceiverNodes,#procReceiverIDs,#procReceiverVariationIDs,#containerNodes,#areaFallConfigs,#areaFallDeleteWidths,#areaFallScaleWidths,#areaFallDensityWidths,#areaFallScaleGraphs,#areaFallDensityGraphs,#fallScaleCurve,#fallDensityCurve,#edgeRotX,#edgeRotY,#edgeRotZ,#edgeOffsetsWU,#edgeAlongWU,#edgeAcrossWU,#sourceForwardAxes,#sourceRadiiWU,#sourceAutoRadius,#sourceFollowScale,#sourceShowRadius,#sourcePoint,#sourceEmpty,#sourceZOffsetsWU,#sourceScales,#sourceWeights,#sources,#bakedNodes,#areaNodes,#areaModes,#sourceColors,#patternLines,#patternWidths)
appendIfUnique AminScatterLayerTabs #densityResponseSamples
appendIfUnique AminScatterLayerTabs #densityFrameBasis
appendIfUnique AminScatterLayerTabs #densityFrameOriginWU
fn CyrusReceiverVariationDomains owner = (
    local ids=owner.procReceiverIDs as array,domains=owner.procReceiverVariationIDs as array
    if ids.count>128 or ids.count!=owner.procReceiverNodes.count do throw "Receiver correspondence history is incomplete."
    if domains.count==0 then domains=ids
    else if domains.count!=ids.count do throw "Receiver variation history is incomplete; the previous result is retained."
    local seen=#(),allowed="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.:"
    for value in domains do (
        if value.count==0 or value.count>256 or (trimLeft value allowed)!="" or findItem seen value>0 do throw "Receiver variation domains must be unique bounded identifiers."
        append seen value
    )
    domains
)
global CyrusClearanceFields=#(#clearanceSourceIDs,#clearanceCopies,#clearanceOthers,#clearanceExternal,#clearanceTargets,#clearancePreferred,#clearanceFactors,#clearanceGapsWU,#clearancePlanar)
join AminScatterLayerFields CyrusClearanceFields
join AminScatterLayerTabs CyrusClearanceFields
fn CyrusRemapLayerCorrespondence owner variation:#same = (
    if findItem #(#same,#new) variation==0 do throw "Choose Same or New variation."
    for key in #(#sourceRowIDs,#procSourceIDs,#procReceiverIDs) do (
        local seen=#()
        for value in (getProperty owner key) do (
            if value.count==0 or value.count>256 or findItem seen value>0 do throw "Copy/import requires complete unique correspondence identities."
            append seen value
        )
    )
    local domains=CyrusReceiverVariationDomains owner,before=#(),after=#()
    for key in #(#sourceRowIDs,#clearanceSourceIDs,#interactionSourceIDs,#interactionProxySourceIDs,#visualSourceKeys,#strokeSourceIDs,#procSourceIDs,#procSourceSlots,#procReceiverIDs) do (
        local values=(getProperty owner key) as array
        for i=1 to values.count do if not matchPattern values[i] pattern:"placeholder:*" do (
            local index=findItem before values[i]
            if index==0 do (append before values[i];append after (CyrusNewLayerID());index=before.count)
            values[i]=after[index]
        )
        setProperty owner key values
    )
    owner.procReceiverVariationIDs=if variation==#same then domains else owner.procReceiverIDs as array
    owner.procReceiverID="";for value in owner.procReceiverIDs do owner.procReceiverID+=value+"|"
    true
)
fn AminScatterCopyLayer origin destination variation:#same = (
    origin.procAssertSchema()
    if origin.paintAreas.count>128 do throw "Copy exceeds the Paint Area capacity."
    for area in origin.paintAreas where area.paintAreas.count>0 do throw "Nested Paint Areas are not supported; the scene is preserved."
    if not origin.isPaintArea do origin.procEnsureCorrespondence()
    destination.setLayerTransfer true
    try (
        for key in AminScatterLayerFields do (
            if findItem AminScatterLayerTabs key>0 then (
                setProperty destination key ((getProperty origin key) as array)
            ) else (
                local ctrl=try(getPropertyController origin key)catch(undefined)
                if ctrl!=undefined then setPropertyController destination key (copy ctrl)
                else (
                    local previous=try(getPropertyController destination key)catch(undefined)
                    if previous!=undefined do setPropertyController destination key undefined
                    setProperty destination key (if key==#paintDocument and origin.paintDocument!=undefined then copy origin.paintDocument else getProperty origin key)
                )
            )
        )
        origin.syncStrokes()
        for key in #(#sourceRowIDs,#visualSourceKeys,#visualSourceLabels,#visualSourceColors,#visualSourceColorSet,#strokeSides,#strokeModes,#strokeColorRows,#strokeColorKeys,#strokeSourceRows,#strokeSourceIDs,#strokeMin,#strokeMax,#patternPaths,#pathIDs,#pathJoins,#strokeIDs,#strokePathIDs,#strokeStarts,#strokeEnds,#strokeStrengths,#strokeCurveEnabled,#strokeScaleModes,#strokeScaleSamples,#strokeCurveSamples,#strokeScaleGraphs,#strokeCurveGraphs,#strokeDisplayColors) do setProperty destination key ((getProperty origin key) as array)
        destination.nextPathID=origin.nextPathID;destination.nextBandID=origin.nextBandID
        destination.bandArrangement=origin.bandArrangement
        destination.analyzerNode=origin.analyzerNode
        destination.layerIDColor=origin.layerIDColor
        for key in #(#interactionCollider,#interactionReact,#interactionCoverRoots,#interactionGapWU,#interactionStiffness,#interactionColliderMode,#interactionMinimumWU,#interactionMinimumM,#interactionUnitsPending,#interactionUnitsNotice,#interactionFoliage,#interactionDefinitionRevision,#interactionMaxVertices,#interactionMaxTriangles,#interactionMaxParts,#interactionMaxGuides,#interactionMaxPreview,#interactionMemoryMiB,#interactionWorkMillions,#interactionConnectionM) do setProperty destination key (getProperty origin key)
        destination.interactionSourceIDs=origin.interactionSourceIDs as array;destination.interactionDefinitions=origin.interactionDefinitions as array
        destination.interactionProxySourceIDs=origin.interactionProxySourceIDs as array;destination.interactionProxyNodes=origin.interactionProxyNodes as array
        destination.surfaceNodes=origin.validSurfaces();destination.surface=undefined
        destination.paintAreas=#();destination.uiAreaID=""
        for area in origin.paintAreas do (
            local duplicate=createInstance AminScatterObject
            if theHold.Holding() do cyrusRecipeTrackCreated duplicate
            duplicate.layerID=CyrusNewLayerID()
            AminScatterCopyLayer area duplicate variation:variation
            duplicate.isPaintArea=true;duplicate.logicalParentID=destination.layerID
            duplicate.areaTarget=area.areaTarget;duplicate.bakedNodes=#()
            append destination.paintAreas duplicate
        )
        CyrusRemapLayerCorrespondence destination variation:variation
        destination.setLayerTransfer false
    ) catch(destination.setLayerTransfer false;throw())
)
fn AminScatterRefreshLayerPanels obj reopen:true = (obj.bindNativeUI())
global CyrusEditStackKey,CyrusEditApplyLayer
fn CyrusEditStackKey root = (root.procEditKey())
fn CyrusEditApplyLayer root layer rows = (
 local owners=if root==undefined then #() else (for n in refs.dependentNodes root where n.baseObject==root collect n)
 local mods=if owners.count==0 then #() else owners[1].modifiers
 local active=for m in mods where classof m==CyrusScatterEdit and m.enabled collect m
 local index=if layer.editLayerKey>0 then layer.editLayerKey else if root==undefined then 0 else findItem root.layerObjects layer
 local signature=layer.procBindingKey
 cyrusEditStack active rows index signature
)

global CyrusFlowRolloutExtent,CyrusFlowLayerSummary
global CyrusRetainListItems
fn CyrusRetainListItems control values = (
    local previous=control.items,changed=previous.count!=values.count
    if not changed do for i=1 to values.count while not changed do changed=previous[i]!=values[i]
    if changed do control.items=values
    changed
)
global CyrusSourceContainer,CyrusContainerPanel,CyrusContainerRefreshAll,CyrusContainerRefreshPresentation,CyrusContainerRefreshLabels,CyrusSourceContainerFilter
fn CyrusSourceContainerFilter node = (isValidNode node and (classof node.baseObject==CyrusSourceContainer or classof node.baseObject==Rectangle) and node.modifiers.count==0 and (not isProperty node #cornerRadius or node.cornerRadius==0))
-- Native rollup headers occupy 21 logical pixels with 2 pixels between pages.
-- Body heights remain MAXScript logical units; automatic layout applies DPI.
fn CyrusFlowRolloutExtent r = (23+(if r.open then r.height else 0))
fn CyrusFlowLayerSummary root parent = (
    local index=findItem root.layerObjects parent
    if index==0 do return #(0,0,"Removed")
    local state=parent.uiLayerStats(),status=CyrusUILayerState state (root.enabledLayer index) root.cyrusEnabled (root.visibleLayer index)
    #((if state.hasResult then state.placements else 0),(if state.hasResult then state.previewCount else 0),status[1])
)

global CyrusBrushSessionRoot,CyrusStopBrush
global CyrusPreparationContext
fn CyrusOpenPreparationEditor target node = (
    if not CyrusLicenseCanEdit() do throw "Active Cyrus authoring license required."
    if not isValidNode node or findItem (target.validSources()) node==0 do throw "Choose an original source model."
    local root=target.interactionsRoot(),ownerNode=CyrusRecipeOwnerNode (target.interactionsRoot())
    if not isValidNode ownerNode do throw "The Scatter owner is no longer in this scene."
    local row=target.sourceRow node,id=target.sourceRowIDs[row],slot=findItem target.interactionSourceIDs target.sourceRowIDs[row]
    local saved=if slot>0 then target.interactionDefinitions[slot] else undefined
    local settings=target.interactionsSettings(),captured=cyrusInteractionSource node undefined settings 4
    cyrusPreparationEditorOpen captured saved ((root.layerCaption target)+" / "+node.name) ownerNode target.interactionStiffness
    CyrusPreparationContext=#(target,node,id,saved,settings as string,ownerNode,root)
    true
)
fn CyrusPreparationEditorCommit = (
    try(
        if not CyrusLicenseCanEdit() do throw "Active Cyrus authoring license required."
        if CyrusPreparationContext==undefined do throw "The editor owner is no longer available."
        local ctx=CyrusPreparationContext,target=ctx[1],node=ctx[2],root=ctx[7]
        if not isValidNode ctx[6] or ctx[6].baseObject!=root or not isValidNode node do throw "The editor source or Scatter controller was removed."
        if findItem root.layerObjects target==0 and target!=root do throw "The source layer was removed."
        local row=target.sourceRow node
        if row<1 or target.sourceRowIDs[row]!=ctx[3] do throw "The original source slot was removed or replaced."
        local slot=findItem target.interactionSourceIDs ctx[3],current=if slot>0 then target.interactionDefinitions[slot] else undefined
        if current!=ctx[4] do throw "Preparation changed outside this editor. Close and reopen to edit that revision."
        if (target.interactionsSettings() as string)!=ctx[5] do throw "Layer preparation settings changed. Close and reopen the editor. Your draft has not replaced them."
        local definition=cyrusPreparationEditorDefinition()
        -- Capture verifies current source geometry and the exact saved binding.
        local verified=cyrusInteractionSource node definition (target.interactionsSettings()) 1
        local beforeIDs=for value in target.interactionSourceIDs collect value
        local beforeDefs=for value in target.interactionDefinitions collect value
        local beforeRevision=target.interactionDefinitionRevision
        undo "Edit Cyrus preparation" on (
            try(
                local ids=for value in beforeIDs collect value,defs=for value in beforeDefs collect value
                if slot==0 then (append ids ctx[3];append defs definition) else defs[slot]=definition
                target.interactionSourceIDs=ids;target.interactionDefinitions=defs;target.interactionDefinitionRevision+=1
                target.interactionSourceCache=#()
                target.interactionsChanged();root.interactionsEnsure()
            )catch(
                target.interactionSourceIDs=beforeIDs;target.interactionDefinitions=beforeDefs;target.interactionDefinitionRevision=beforeRevision
                target.interactionSourceCache=#();target.interactionsChanged()
                throw()
            )
        )
        cyrusPreparationEditorCommitResult true ""
        CyrusPreparationContext=undefined;CyrusViewportRecordsDirty=true
        if CyrusScheduleUI!=undefined do CyrusScheduleUI()
        redrawViews();true
    )catch(
        local message=getCurrentException()
        cyrusPreparationEditorCommitResult false message
        false
    )
)

plugin simpleObject AminScatterObject
name:"Cyrus Scatter"
classID:#(0x617d43a1,0x395c2e17)
category:"Cyrus"
version:62
initialRollupState:0x8
(
    local layerTransfer=false
    local cachedPoints=undefined
    local cachedAnalyzerRun=-1
    local cachedPointCount=0
    local dirty = true
    local diagnosticCauseID=0L
    -- Session-only validity. Scene identities and publication records are unchanged.
    local procOrientationReceivers=#()
    local orientationTimeValidity=undefined,orientationTimeStamp=0,orientationTimeObserved=0,orientationTargetObserved=undefined
    local inputTimeValidity=undefined,inputTimeStamp=0,inputTimeObserved=0
    local inputTimeQueries=0,inputTimeInvalidations=0
    -- Deleted nodes may no longer resolve from the callback's handles. Retain
    -- only the dependency handles of the complete published result, not nodes.
    local procDependencyHandles=#()
    local timeOwnerRegistered=false
    fn ensureTimeOwner = (
        if not timeOwnerRegistered do (
            for node in refs.dependentNodes this where isValidNode node and node.baseObject==this do (
                CyrusRegisterTimeOwner node;timeOwnerRegistered=true
            )
        )
    )
    fn markInputDirty = (
        if cyrusDiagnosticActive() do try (
            if CyrusActiveActionID>0 or not dirty do diagnosticCauseID=CyrusActiveActionID
            local controller=if this.overlapOwner==undefined then this else this.overlapOwner
            controller.diagnosticCauseID=diagnosticCauseID
            CyrusDiagnosticEmit "input.invalidated" "setting" this.layerID this.procEpoch "authored_or_dependency_edit" correlation:diagnosticCauseID
        )catch()
        inputTimeValidity=undefined;orientationTimeValidity=undefined;dirty=true;CyrusViewportRecordsDirty=true
    )
    fn inputTimeExpired = (
        if inputTimeValidity==undefined do return false
        local tick=currentTime as integer
        tick<inputTimeValidity[1] or tick>inputTimeValidity[2] or inputTimeStamp!=inputTimeObserved
    )
    fn inputTimeKey = (
        local tick=currentTime as integer
        if inputTimeValidity==undefined or tick<inputTimeValidity[1] or tick>inputTimeValidity[2] do (
            if cyrusScatterInputValidity==undefined do throw "This Scatter script requires matching native binaries with input validity support. Restart Max with the complete script/native pair."
            local nodes=this.validSurfaces(),settings=#(this),maps=#()
            join nodes (this.sources as array);join nodes (this.areaNodes as array);join nodes (this.patternLines as array)
            -- Analyzer is a cached producer. checkAnalyzerRevision() observes
            -- its published output; its icon/receiver clock must not bypass
            -- the Analyzer's own Manual mode or real-time scheduling.
            join nodes (this.effectiveContainers())
            nodes=for n in nodes where isValidNode n collect n
            if this.overlapOwner==undefined do join settings (this.procModifiers())
            this.procWatchDensity()
            if this.densityMap!=undefined and this.distributionMode==3 do append maps this.densityMap
            local interval=cyrusCandidateInputValidity settings nodes maps
            inputTimeQueries+=1
            -- Keep one key throughout a validity interval, including stepped keys.
            -- FOREVER has no time component. A dirty notification re-arms the
            -- interval without unnecessarily changing a still-valid time stamp.
            if interval[3] then inputTimeStamp=0
            else if inputTimeStamp<interval[1] or inputTimeStamp>interval[2] do inputTimeStamp=tick
            inputTimeValidity=interval
        )
        inputTimeStamp
    )
    fn invalidateInputTime = (
        if not this.inputTimeExpired() do return false
        inputTimeInvalidations+=1
        CyrusDiagnosticEmit "time.invalidated" "host_callback" this.layerID inputTimeInvalidations "dependency_interval_expired"
        this.markInputDirty();true
    )
    fn liveTimeChanged = (
        if not this.cyrusEnabled do return false
        if this.updateMode!=2 do (
            -- Manual placements remain frozen, but an explicitly enabled field
            -- view follows animated inputs and labels them as pending.
            local changed=false
            for i=1 to this.layerObjects.count where this.enabledLayer i do (
                local leaf=this.layerObjects[i]
                if leaf.fieldPreviewEnabled() and leaf.invalidateInputTime() do changed=true
            )
            return changed
        )
        local rootChanged=this.invalidateInputTime(),changed=rootChanged
        for i=1 to this.layerObjects.count where this.enabledLayer i do (
            local leaf=this.layerObjects[i]
            if rootChanged then leaf.markInputDirty()
            else if leaf.invalidateInputTime() do changed=true
            if leaf.invalidateOrientationTime() do changed=true
        )
        changed
    )
    fn inputTimeStats = (#(inputTimeQueries,inputTimeInvalidations,inputTimeStamp,inputTimeObserved,inputTimeValidity))
    fn publishedInputTime = inputTimeObserved
    fn orientationTimeKey = (
        local tick=currentTime as integer
