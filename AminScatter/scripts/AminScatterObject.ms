        on gridJitter preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=gridJitter and not (cyrusLicenseAllows()) then gridJitter else value)
    )
    -- Append a parameter block: existing saved parameter block IDs stay intact.
    parameters imageDensitySettings (
        densityCoordinateMode type:#integer default:0
        densityWrapMode type:#integer default:0
        densityTileXWU type:#worldunits default:100
        densityTileYWU type:#worldunits default:100
        densityTileLock type:#boolean default:true
        densityRepeatX type:#float default:1
        densityRepeatY type:#float default:1
        densityHeading type:#float default:0
        densityOffsetXWU type:#worldunits default:0
        densityOffsetYWU type:#worldunits default:0
        densityUOffset type:#float default:0
        densityVOffset type:#float default:0
        densityPatternID type:#string default:""
        densityPatternRevision type:#string default:""
        densityResponseSamples type:#floatTab tabSize:0 tabSizeVariable:true
        densityResponseGraph type:#string default:""
        densityMapProvenance type:#string default:""
        densityFrameBasis type:#floatTab tabSize:0 tabSizeVariable:true
        densityFrameOriginWU type:#worldUnitsTab tabSize:0 tabSizeVariable:true
        on densityCoordinateMode postSet v do this.imageDensityChanged()
        on densityWrapMode postSet v do this.imageDensityChanged()
        on densityTileXWU postSet v do this.imageDensityChanged()
        on densityTileYWU postSet v do this.imageDensityChanged()
        on densityTileLock postSet v do this.imageDensityChanged()
        on densityRepeatX postSet v do this.imageDensityChanged()
        on densityRepeatY postSet v do this.imageDensityChanged()
        on densityHeading postSet v do this.imageDensityChanged()
        on densityOffsetXWU postSet v do this.imageDensityChanged()
        on densityOffsetYWU postSet v do this.imageDensityChanged()
        on densityUOffset postSet v do this.imageDensityChanged()
        on densityVOffset postSet v do this.imageDensityChanged()
        on densityResponseSamples set v i do this.imageDensityChanged()
        on densityFrameBasis set v i do this.imageDensityChanged()
        on densityFrameOriginWU set v i do this.imageDensityChanged()

        on densityCoordinateMode preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=densityCoordinateMode and not (cyrusLicenseAllows()) then densityCoordinateMode else value)
        on densityWrapMode preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=densityWrapMode and not (cyrusLicenseAllows()) then densityWrapMode else value)
        on densityTileXWU preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=densityTileXWU and not (cyrusLicenseAllows()) then densityTileXWU else value)
        on densityTileYWU preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=densityTileYWU and not (cyrusLicenseAllows()) then densityTileYWU else value)
        on densityTileLock preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=densityTileLock and not (cyrusLicenseAllows()) then densityTileLock else value)
        on densityRepeatX preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=densityRepeatX and not (cyrusLicenseAllows()) then densityRepeatX else value)
        on densityRepeatY preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=densityRepeatY and not (cyrusLicenseAllows()) then densityRepeatY else value)
        on densityHeading preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=densityHeading and not (cyrusLicenseAllows()) then densityHeading else value)
        on densityOffsetXWU preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=densityOffsetXWU and not (cyrusLicenseAllows()) then densityOffsetXWU else value)
        on densityOffsetYWU preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=densityOffsetYWU and not (cyrusLicenseAllows()) then densityOffsetYWU else value)
        on densityUOffset preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=densityUOffset and not (cyrusLicenseAllows()) then densityUOffset else value)
        on densityVOffset preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=densityVOffset and not (cyrusLicenseAllows()) then densityVOffset else value)
        on densityPatternID preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=densityPatternID and not (cyrusLicenseAllows()) then densityPatternID else value)
        on densityPatternRevision preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=densityPatternRevision and not (cyrusLicenseAllows()) then densityPatternRevision else value)
        on densityResponseGraph preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=densityResponseGraph and not (cyrusLicenseAllows()) then densityResponseGraph else value)
        on densityMapProvenance preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=densityMapProvenance and not (cyrusLicenseAllows()) then densityMapProvenance else value)
    )
    local densityNotifiedFrame=undefined
    -- Append only: the saved IDs of every preceding parameter block are stable.
    parameters sourceClearanceSettings (
        clearanceUpgradePending type:#boolean default:false
        clearanceSourceIDs type:#stringTab tabSize:0 tabSizeVariable:true
        clearanceCopies type:#intTab tabSize:0 tabSizeVariable:true
        clearanceOthers type:#intTab tabSize:0 tabSizeVariable:true
        clearanceExternal type:#intTab tabSize:0 tabSizeVariable:true
        clearanceTargets type:#stringTab tabSize:0 tabSizeVariable:true
        clearancePreferred type:#boolTab tabSize:0 tabSizeVariable:true
        clearanceFactors type:#floatTab tabSize:0 tabSizeVariable:true
        clearanceGapsWU type:#worldUnitsTab tabSize:0 tabSizeVariable:true
        clearancePlanar type:#boolTab tabSize:0 tabSizeVariable:true
        on clearanceSourceIDs set v i do markInputDirty()
        on clearanceCopies set v i do markInputDirty()
        on clearanceOthers set v i do markInputDirty()
        on clearanceExternal set v i do markInputDirty()
        on clearanceTargets set v i do markInputDirty()
        on clearancePreferred set v i do markInputDirty()
        on clearanceFactors set v i do markInputDirty()
        on clearanceGapsWU set v i do markInputDirty()
        on clearancePlanar set v i do markInputDirty()

        on clearanceUpgradePending preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=clearanceUpgradePending and not (cyrusLicenseAllows()) then clearanceUpgradePending else value)
    )
    fn clearanceRow row = (
        local index=if row>0 and row<=sourceRowIDs.count then findItem clearanceSourceIDs sourceRowIDs[row] else 0
        if index==0 then #(0,0,0,"",false,1.0,0.0,false)
        else #(clearanceCopies[index],clearanceOthers[index],clearanceExternal[index],clearanceTargets[index],clearancePreferred[index],clearanceFactors[index],clearanceGapsWU[index],clearancePlanar[index])
    )
    fn validateClearance = (
        if clearanceSourceIDs.count>1024 do throw "Too many saved model clearance policies."
        for key in #(#clearanceCopies,#clearanceOthers,#clearanceExternal,#clearanceTargets,#clearancePreferred,#clearanceFactors,#clearanceGapsWU,#clearancePlanar) do
            if (getProperty this key).count!=clearanceSourceIDs.count do throw "Model clearance settings are incomplete."
        local seen=#()
        for id in clearanceSourceIDs do (
            if id=="" or findItem seen id>0 or findItem sourceRowIDs id==0 do throw "Model clearance has an invalid source identity."
            append seen id
        )
        true
    )
    fn setSourceClearance rows field value = (
        if findItem #(#clearanceCopies,#clearanceOthers,#clearanceExternal,#clearanceTargets,#clearancePreferred,#clearanceFactors,#clearanceGapsWU,#clearancePlanar) field==0 do throw "Unknown model clearance field."
        local selectedIDs=for row in rows where row>0 and row<=sourceRowIDs.count collect sourceRowIDs[row]
        this.validateClearance()
        undo "Cyrus model clearance" on (
            for id in selectedIDs do (
                local index=findItem clearanceSourceIDs id
                if index==0 do (
                    append clearanceSourceIDs id;append clearanceCopies 0;append clearanceOthers 0;append clearanceExternal 0
                    append clearanceTargets "";append clearancePreferred false;append clearanceFactors 1.0;append clearanceGapsWU 0.0;append clearancePlanar false
                    index=clearanceSourceIDs.count
                )
                (getProperty this field)[index]=value
            )
        )
        this.markInputDirty();true
    )
    fn removeSourceClearance id = (
        local index=findItem clearanceSourceIDs id
        if index>0 do for key in #(#clearanceSourceIDs,#clearanceCopies,#clearanceOthers,#clearanceExternal,#clearanceTargets,#clearancePreferred,#clearanceFactors,#clearanceGapsWU,#clearancePlanar) do deleteItem (getProperty this key) index
    )
    fn procClearanceSpecs plants = (
        this.validateClearance()
        if plants.count==0 do return #(#("unassigned:1","unassigned:1",0,0,0,#(),false,#(true,1.0,0.0,false)))
        for plant in plants collect (
            local row=this.sourceRow plant,policy=this.clearanceRow row
            if row<1 or row>sourceRowIDs.count or row>procSourceSlots.count do throw "Clearance source correspondence is incomplete."
            #(sourceRowIDs[row],procSourceSlots[row],policy[1],policy[2],policy[3],filterString policy[4] "|",policy[5],#(true,policy[6],policy[7],policy[8]))
        )
    )
    -- Append-only scene data. Prepared definitions are source-local, never poses.
    parameters interactionSettings (
        interactionCollider type:#boolean default:false
        interactionReact type:#boolean default:false
        interactionCoverRoots type:#boolean default:false
        interactionGapWU type:#worldUnits default:0.0
        interactionStiffness type:#float default:0.5
        interactionColliderMode type:#integer default:1
        interactionMinimumWU type:#worldUnits default:(units.decodeValue "5mm")
        interactionMinimumM type:#float default:0.005
        interactionUnitsPending type:#boolean default:false
        interactionUnitsNotice type:#string default:""
        interactionProxySourceIDs type:#stringTab tabSize:0 tabSizeVariable:true
        interactionProxyNodes type:#nodeTab tabSize:0 tabSizeVariable:true
        interactionFoliage type:#float default:0.05
        interactionSourceIDs type:#stringTab tabSize:0 tabSizeVariable:true
        interactionDefinitions type:#stringTab tabSize:0 tabSizeVariable:true
        interactionDefinitionRevision type:#integer default:0
        -- Keep all original parameter IDs above unchanged for saved schema 61.
        interactionMaxVertices type:#integer default:2000000
        interactionMaxTriangles type:#integer default:4000000
        interactionMaxParts type:#integer default:100000
        interactionMaxGuides type:#integer default:8192
        interactionMaxPreview type:#integer default:500000
        interactionMemoryMiB type:#integer default:2048
        interactionWorkMillions type:#integer default:256
        interactionConnectionM type:#float default:0.15
        on interactionCollider postSet v do this.interactionsChanged()
        on interactionReact postSet v do this.interactionsChanged()
        on interactionCoverRoots postSet v do this.interactionsChanged()
        on interactionGapWU postSet v do this.interactionsChanged()
        on interactionStiffness postSet v do this.interactionsChanged()
        on interactionColliderMode postSet v do this.interactionsChanged()

        on interactionCollider preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=interactionCollider and not (cyrusLicenseAllows()) then interactionCollider else value)
        on interactionReact preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=interactionReact and not (cyrusLicenseAllows()) then interactionReact else value)
        on interactionCoverRoots preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=interactionCoverRoots and not (cyrusLicenseAllows()) then interactionCoverRoots else value)
        on interactionGapWU preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=interactionGapWU and not (cyrusLicenseAllows()) then interactionGapWU else value)
        on interactionStiffness preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=interactionStiffness and not (cyrusLicenseAllows()) then interactionStiffness else value)
        on interactionColliderMode preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=interactionColliderMode and not (cyrusLicenseAllows()) then interactionColliderMode else value)
        on interactionMinimumWU preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=interactionMinimumWU and not (cyrusLicenseAllows()) then interactionMinimumWU else value)
        on interactionMinimumM preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=interactionMinimumM and not (cyrusLicenseAllows()) then interactionMinimumM else value)
        on interactionUnitsPending preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=interactionUnitsPending and not (cyrusLicenseAllows()) then interactionUnitsPending else value)
        on interactionUnitsNotice preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=interactionUnitsNotice and not (cyrusLicenseAllows()) then interactionUnitsNotice else value)
        on interactionFoliage preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=interactionFoliage and not (cyrusLicenseAllows()) then interactionFoliage else value)
        on interactionDefinitionRevision preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=interactionDefinitionRevision and not (cyrusLicenseAllows()) then interactionDefinitionRevision else value)
        on interactionMaxVertices preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=interactionMaxVertices and not (cyrusLicenseAllows()) then interactionMaxVertices else value)
        on interactionMaxTriangles preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=interactionMaxTriangles and not (cyrusLicenseAllows()) then interactionMaxTriangles else value)
        on interactionMaxParts preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=interactionMaxParts and not (cyrusLicenseAllows()) then interactionMaxParts else value)
        on interactionMaxGuides preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=interactionMaxGuides and not (cyrusLicenseAllows()) then interactionMaxGuides else value)
        on interactionMaxPreview preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=interactionMaxPreview and not (cyrusLicenseAllows()) then interactionMaxPreview else value)
        on interactionMemoryMiB preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=interactionMemoryMiB and not (cyrusLicenseAllows()) then interactionMemoryMiB else value)
        on interactionWorkMillions preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=interactionWorkMillions and not (cyrusLicenseAllows()) then interactionWorkMillions else value)
        on interactionConnectionM preSet value do (if not loading and not (cyrusLicenseRestoring()) and value!=interactionConnectionM and not (cyrusLicenseAllows()) then interactionConnectionM else value)
    )
    local interactionState=undefined,interactionStateKey="",interactionError="",interactionOutputNodes=#(),interactionOutputKey=""
    local interactionSourceCache=#(),interactionReview=undefined,interactionReviewNode=undefined,interactionGuides=#(),interactionReviewKind=undefined,interactionReviewApproved=false
    fn interactionsRoot = (if overlapOwner==undefined then this else overlapOwner)
    fn interactionsChanged = (
        if this.getLayerTransfer() do return true
        local root=this.interactionsRoot()
        root.interactionStateKey="";CyrusViewportRecordsDirty=true
        if CyrusScheduleUI!=undefined do CyrusScheduleUI()
        true
    )
    fn interactionsClearGuides = (
        undo off for node in interactionGuides where isValidNode node do delete node
        interactionGuides=#();interactionReviewKind=undefined;true
    )
    fn interactionsReviewVisible kind node = (interactionReviewKind==kind and interactionReviewNode==node and (for n in interactionGuides where isValidNode n collect n).count>0)
    fn interactionsReady plants = (
        if plants.count==0 or interactionDefinitions.count!=interactionSourceIDs.count do return false
        for node in plants do (
            if not isValidNode node do return false
            local row=this.sourceRow node,slot=if row>0 then findItem interactionSourceIDs sourceRowIDs[row] else 0
            if slot==0 or interactionDefinitions[slot]=="" do return false
        )
        true
    )
    fn interactionsPreparationStatus = (
        local plants=this.validSources(),ready=0
        for node in plants where isValidNode node do (local row=this.sourceRow node;if row>0 and findItem interactionSourceIDs sourceRowIDs[row]>0 do ready+=1)
        if plants.count==0 then "Add a source model in Models & Points."
        else if ready<plants.count then ((ready as string)+" / "+(plants.count as string)+" sources prepared. Select each source and click Prepare model. Instances react when all sources are ready.")
        else "All source models prepared. Contact changes update automatically; Manual placement edits still wait for Update scatter."
    )
    fn interactionsRepairSettings = (
        local minimum=if interactionUnitsPending then interactionMinimumWU/(units.decodeValue "1m") else interactionMinimumM
        local repaired=minimum<0.001 or minimum>0.10000001
        undo "Repair Cyrus preparation units" on (
            if repaired do (minimum=0.005;interactionSourceIDs=#();interactionDefinitions=#();interactionDefinitionRevision+=1)
            interactionMinimumM=minimum;interactionMinimumWU=minimum*(units.decodeValue "1m");interactionUnitsPending=false
            interactionUnitsNotice=if repaired then "Legacy minimum was outside 1-100 mm; repaired to 5 mm. Click Prepare model again." else "Preparation distance stored in metres; scene geometry was not rescaled."
            if interactionFoliage<0.01 or interactionFoliage>1.0 do (interactionFoliage=0.05;interactionSourceIDs=#();interactionDefinitions=#();interactionDefinitionRevision+=1)
        )
        interactionSourceCache=#();interactionReview=undefined;this.interactionsChanged();interactionUnitsNotice
    )
    fn interactionsSettings = (
        if interactionUnitsPending do throw "Legacy preparation units need review. Click Repair settings or Analyze model; scene geometry will not be rescaled."
        if interactionMinimumM<0.001 or interactionMinimumM>0.10000001 do throw "Minimum stem must be between 1 mm and 100 mm. Use Repair settings to restore 5 mm."
        if interactionFoliage<0.01 or interactionFoliage>1.0 do throw "Preview leaves / blades must be between 1% and 100%."
        #(interactionMinimumM,interactionFoliage,1,this.interactionsLimits(),interactionConnectionM)
    )
    fn interactionsLimits = (#(interactionMaxVertices,interactionMaxTriangles,interactionMaxParts,interactionMaxGuides,interactionMaxPreview,interactionMemoryMiB,interactionWorkMillions))
    fn interactionsLimitsChanged = (
        interactionSourceCache=#();interactionReview=undefined;interactionDefinitionRevision+=1;this.interactionsChanged();true
    )
    fn interactionsColliderValue node = (
        if interactionColliderMode==1 then cyrusInteractionSource node undefined #(0.005,0.05,1,this.interactionsLimits()) 2
        else cyrusInteractionColliderSource node (this.interactionsProxy node) interactionColliderMode
    )
    fn interactionsCleanProxies = (
        local ids=#(),nodes=#(),removed=0
        for i=1 to interactionProxySourceIDs.count do (
            if findItem sourceRowIDs interactionProxySourceIDs[i]>0 then (append ids interactionProxySourceIDs[i];append nodes interactionProxyNodes[i]) else removed+=1
        )
        undo "Clean unused Cyrus collider links" on (interactionProxySourceIDs=ids;interactionProxyNodes=nodes;interactionDefinitionRevision+=1)
        this.interactionsChanged();removed
    )
    fn interactionsSourceCaption node = (
        local row=this.sourceRow node,id=if row>0 then sourceRowIDs[row] else "",slot=findItem interactionSourceIDs id
        node.name+" | "+(if interactionCollider then (if interactionColliderMode==1 then "Full source" else if interactionColliderMode==2 then "Box" else if this.interactionsProxy node==undefined then "Missing collider" else "Separate collider") else if slot>0 then "Saved guides" else "Needs preparation")
    )
    fn interactionsCanAccept node:undefined = (
        if interactionReview==undefined or interactionReviewApproved or (node!=undefined and node!=interactionReviewNode) do return false
        local value=(dotNetClass "System.Text.RegularExpressions.Regex").IsMatch (cyrusInteractionSourceInfo interactionReview) "\"can_prepare\"\\s*:\\s*true"
        value
    )
    fn interactionsProxy node = (
        if interactionProxySourceIDs.count!=interactionProxyNodes.count do throw "Collider source bindings are incomplete; restore the saved scene or repair its source links."
        local row=this.sourceRow node,slot=if row>0 then findItem interactionProxySourceIDs sourceRowIDs[row] else 0
        if slot>0 and slot<=interactionProxyNodes.count and isValidNode interactionProxyNodes[slot] then interactionProxyNodes[slot] else undefined
    )
    fn interactionsValidateProxy node proxy = (
        if not isValidNode proxy do throw "Pick a closed mesh, or cancel to keep the current collider."
        if this.sourceRow node<1 do throw "Choose the visual source model first."
        if node==proxy then cyrusInteractionSource node undefined #(0.005,0.05,1,this.interactionsLimits()) 2
        else cyrusInteractionColliderSource node proxy 3
        true
    )
    fn interactionsSetProxy node proxy = (
        this.interactionsValidateProxy node proxy
        if node==proxy do (
            interactionColliderMode=1;this.interactionsChanged();return true
        )
        local row=this.sourceRow node
        if row<1 do throw "Choose the visual source model first."
        local id=sourceRowIDs[row],slot=findItem interactionProxySourceIDs id
        if slot==0 then (if interactionProxySourceIDs.count>=512 do throw "Collider assignment budget: 512 source bindings.";append interactionProxySourceIDs id;append interactionProxyNodes proxy)
        else interactionProxyNodes[slot]=proxy
        -- Validate every source before switching the layer to custom mode. A
        -- partial assignment is saved without breaking its current collider.
        local complete=true
        for source in (this.validSources()) where this.interactionsProxy source==undefined do complete=false
        if complete do interactionColliderMode=3
        interactionDefinitionRevision+=1;this.interactionsChanged();true
    )
    fn interactionsValidateColliderMode mode = (
        if mode<1 or mode>3 do throw "Choose a collider shape."
        for node in (this.validSources()) do (
            if not isValidNode node do throw "Collider layers require mesh source models."
            if mode==3 and this.interactionsProxy node==undefined do throw ("Assign a custom collider for "+node.name+" first. The current shape is still active.")
            if mode==1 then cyrusInteractionSource node undefined #(0.005,0.05,1,this.interactionsLimits()) 2
            else cyrusInteractionColliderSource node (this.interactionsProxy node) mode
        )
        true
    )
    fn interactionsSetColliderMode mode = (
        this.interactionsValidateColliderMode mode
        interactionColliderMode=mode;this.interactionsClearGuides();true
    )
    fn interactionsBuildTrunks = (
        local created=#(),pending=#(),previousIDs=interactionProxySourceIDs as array,previousNodes=interactionProxyNodes as array,previousRevision=interactionDefinitionRevision
        try (
            for node in (this.validSources()) where this.interactionsProxy node==undefined do (
                local proxy=cyrusInteractionBuildTrunk node
                append created proxy;proxy.name=uniqueName (node.name+" - Trunk collider");setUserProp proxy "CyrusColliderProxy" true;append pending #(node,proxy)
            )
            for pair in pending do this.interactionsSetProxy pair[1] pair[2]
            interactionColliderMode=3;interactionCollider=true;interactionReact=false
        )catch(interactionProxySourceIDs=previousIDs;interactionProxyNodes=previousNodes;interactionDefinitionRevision=previousRevision;undo off for node in created where isValidNode node do delete node;throw())
        true
    )
    fn interactionsReviewCollider node = (
        local value=this.interactionsColliderValue node
        this.interactionsClearGuides()
        undo off (local model=cyrusInteractionReviewModel value node.transform true;model.wirecolor=(color 60 240 90);model.isFrozen=true;model.showFrozenInGray=false;model.xray=true;setUserProp model "CyrusInteractionTransient" true;interactionGuides=#(model))
        interactionReview=undefined;interactionReviewApproved=false;interactionReviewNode=node;interactionReviewKind=#collider
        true
    )
    fn interactionsShowGuides node = (
        if not isValidNode node or findItem (this.validSources()) node==0 do throw "Choose a current source model."
        if interactionReview==undefined or interactionReviewNode!=node do (
            local row=this.sourceRow node,slot=findItem interactionSourceIDs sourceRowIDs[row]
            if slot==0 do throw "Analyze this source model first."
            interactionReview=cyrusInteractionSource node interactionDefinitions[slot] (this.interactionsSettings()) 1
            interactionReviewNode=node;interactionReviewApproved=true
        )
        local value=interactionReview,paths=cyrusInteractionGuides value
        this.interactionsClearGuides()
        -- Source-local preparation is reviewed at the original source. Hidden
        -- library sources get a transient display copy without visibility edits.
        undo off (
            if node.isHidden do (local model=cyrusInteractionReviewModel value node.transform;setUserProp model "CyrusInteractionTransient" true;append interactionGuides model)
            if paths.count>0 do (
                local shape=splineShape name:"Cyrus_Interaction_Source_Guides" wirecolor:(color 80 240 90)
                append interactionGuides shape
                for path in paths do (addNewSpline shape;for p in path do addKnot shape (numSplines shape) #corner #line p;updateShape shape)
                shape.transform=node.transform;shape.renderable=false;shape.isFrozen=true;shape.showFrozenInGray=false;setUserProp shape "CyrusInteractionTransient" true
            )
        )
        interactionReviewNode=node;interactionReviewKind=#guides;true
    )
    fn interactionsAnalyze node = (
        if not CyrusLicenseCanEdit() do throw "Active Cyrus authoring license required to prepare a model."
        if cyrusInteractionVersion==undefined or cyrusInteractionVersion()!=8 do throw "Load the revised matched CyrusScatter 0.87.4 native modules and restart Max."
        if not isValidNode node or findItem (this.validSources()) node==0 do throw "Choose a current mesh model in this layer."
        if interactionUnitsPending do this.interactionsRepairSettings()
        this.interactionsClearGuides()
        local next=cyrusInteractionSource node undefined (this.interactionsSettings()) 1
        interactionReview=next;interactionReviewNode=node;interactionReviewApproved=false
        this.interactionsShowGuides node
        format "Cyrus source analysis:\n%\n" (cyrusInteractionSourceInfo next)
        cyrusInteractionSourceInfo next
    )
    fn interactionsAccept = (
        if interactionReview==undefined or not isValidNode interactionReviewNode do throw "Analyze a model and inspect its roots and branch guides first."
        if not this.interactionsCanAccept() do throw "This source is not ready. Inspect its retained analysis report and repair unresolved guides/attachments before accepting."
        local row=this.sourceRow interactionReviewNode
        if row<1 or row>sourceRowIDs.count do throw "The reviewed source was removed. Analyze again."
        -- Recapture verifies geometry, units and settings before acceptance.
        local current=cyrusInteractionSource interactionReviewNode undefined (this.interactionsSettings()) 1
        if (cyrusInteractionSourceInfo current)!=(cyrusInteractionSourceInfo interactionReview) do throw "The source changed after analysis. Analyze and review again."
        local accepted=cyrusInteractionAccept current,id=sourceRowIDs[row],slot=findItem interactionSourceIDs id
        undo "Accept Cyrus source guides" on (
            if slot==0 then (append interactionSourceIDs id;append interactionDefinitions (cyrusInteractionSerialize accepted))
            else interactionDefinitions[slot]=cyrusInteractionSerialize accepted
            interactionDefinitionRevision+=1
            interactionReact=true;interactionCollider=false
        )
        interactionSourceCache=#();interactionReview=accepted;interactionReviewApproved=true;this.interactionsClearGuides();this.interactionsChanged();true
    )
    fn interactionsPrepare nodes rebuild:true enable:true = (
        if not CyrusLicenseCanEdit() do throw "Active Cyrus authoring license required to prepare a model."
        if nodes.count==0 do return true
        if interactionUnitsPending do this.interactionsRepairSettings()
        -- ParamBlock2 tabs expose ArrayParameter wrappers; collect values, not the block.
        local settings=this.interactionsSettings()
        local ids=for value in interactionSourceIDs collect value
        local definitions=for value in interactionDefinitions collect value
        local reviewNode=if interactionReviewKind==#guides then interactionReviewNode else undefined
        -- Capture/validate every successor before changing persistent definitions.
        -- Instances share these source-local definitions; no placement is rebuilt.
        for node in nodes do (
            if not isValidNode node or findItem (this.validSources()) node==0 do throw "Choose a current source model."
            local row=this.sourceRow node,id=sourceRowIDs[row],slot=findItem ids id
            local saved=if slot>0 then definitions[slot] else undefined
            local value=cyrusInteractionSource node saved settings 1 rebuild
            local accepted=cyrusInteractionAccept value
            local definition=cyrusInteractionSerialize accepted
            if slot==0 then (append ids id;append definitions definition) else definitions[slot]=definition
        )
        interactionSourceIDs=ids;interactionDefinitions=definitions;interactionDefinitionRevision+=1
        if enable do (interactionReact=true;interactionCollider=false)
        interactionSourceCache=#();interactionReview=undefined;interactionReviewApproved=false;this.interactionsClearGuides();this.interactionsChanged()
        if isValidNode reviewNode and findItem nodes reviewNode>0 do this.interactionsShowGuides reviewNode
        true
    )
    fn interactionsRefreshPreparation rebuild:false = (
        local prepared=for node in this.validSources() where isValidNode node and findItem interactionSourceIDs sourceRowIDs[this.sourceRow node]>0 collect node
        if prepared.count>0 then this.interactionsPrepare prepared rebuild:rebuild enable:false else (this.interactionsLimitsChanged();true)
    )
    fn interactionsSources plants role = (
        if role==0 do return #()
        local result=#(),flags=(if bit.get role 1 then 2 else 0)+(if bit.get role 2 then 1 else 0),settings=if role==2 then this.interactionsSettings() else undefined,nextCache=#()
        if interactionDefinitions.count!=interactionSourceIDs.count do throw "Prepared model data is incomplete. Analyze again."
        for node in plants do (
            if not isValidNode node do throw "Interactions require mesh models; Points and Empty sources are unsupported."
            local row=this.sourceRow node,slot=if row>0 then findItem interactionSourceIDs sourceRowIDs[row] else 0
            local saved=if bit.get role 2 then (if slot>0 then interactionDefinitions[slot] else throw ("Click Prepare model for "+node.name+" before enabling React to colliders.")) else undefined
            local value=if role==1 then this.interactionsColliderValue node else cyrusInteractionSource node saved settings flags
            append result value;append nextCache #(node,value)
        )
        interactionSourceCache=nextCache;result
    )
    fn interactionsKey owners epoch = (
        local stream=stringStream ""
        format "%|%|" epoch cyrusEnabled to:stream
        for leaf in owners do (
            local parent=this.logicalParent leaf
            format "%:%:%:%:%:%:%:%:%:%:%:%:%|" leaf.layerID parent.interactionCollider parent.interactionReact parent.interactionCoverRoots parent.interactionGapWU parent.interactionStiffness parent.interactionColliderMode parent.interactionMinimumM parent.interactionFoliage parent.interactionDefinitionRevision leaf.autoRender (parent.interactionsLimits()) parent.interactionConnectionM to:stream
        )
        stream as string
    )
    fn interactionsStage rows owners plants previous:undefined retargetEdits:false = (
        local active=false
        for leaf in owners do (local parent=this.logicalParent leaf;if parent.interactionCollider or parent.interactionReact do active=true)
        if not active and previous!=undefined and cyrusInteractionHasEdits!=undefined do active=cyrusInteractionHasEdits previous
        if not active or not cyrusEnabled do return undefined
        if cyrusInteractionVersion==undefined or cyrusInteractionVersion()!=8 do throw "CyrusScatter 0.87.4 requires its revised matched native interaction modules. Restart after installing."
        local payload=for i=1 to owners.count collect (
            local leaf=owners[i],parent=this.logicalParent leaf
            local role=(if parent.interactionCollider then 1 else 0)+(if parent.interactionReact then 2 else 0)
            -- React is an authored intent. Incomplete source preparation stays
            -- visibly pending; it cannot fail an unrelated layer publication.
            if role==2 and not (parent.interactionsReady plants[i]) do role=0
            if not this.enabledLayer (findItem layerObjects leaf) do role=0
            #(leaf.layerID,leaf.editLayerKey,rows[i],(parent.interactionsSources plants[i] role),role,parent.interactionCoverRoots,parent.interactionGapWU/(units.decodeValue "1m"),parent.interactionStiffness,leaf.autoRender)
        )
        if retargetEdits then cyrusInteractionRestage (CyrusRecipeOwnerNode this) payload previous else cyrusInteractionStageFrom (CyrusRecipeOwnerNode this) payload previous
    )
    fn interactionsEnsure = (
        if procPublishedOwners.count==0 do return undefined
        if interactionState!=undefined and not (cyrusInteractionOwner interactionState (CyrusRecipeOwnerNode this)) do (interactionState=undefined;interactionStateKey="";interactionOutputNodes=#();interactionOutputKey="")
        if interactionState!=undefined and not (cyrusInteractionSourcesFresh interactionState) do interactionStateKey=""
        local key=this.interactionsKey procPublishedOwners procEpoch,owner=CyrusRecipeOwnerNode this
        local outputKey=key+"|hidden:"+(if isValidNode owner then owner.isHidden as string else "true")
        local outputsValid=true
        for node in interactionOutputNodes where not isValidNode node do outputsValid=false
        if key==interactionStateKey and outputKey==interactionOutputKey and outputsValid do return interactionState
        if key!=interactionStateKey do for i=1 to procPublishedOwners.count do procPublishedOwners[i].procCheckPublishedGeometry procPublishedSources[i] procPublishedMetadata[i]
        local stage=if key==interactionStateKey then interactionState else this.interactionsStage groupSnapshotRows procPublishedOwners procPublishedSources previous:interactionState retargetEdits:true
        -- Source bindings and numeric solve must succeed before replacing state.
        local outputs=if stage==undefined or not isValidNode owner or owner.isHidden then #() else cyrusInteractionRenderNodes stage (for n in interactionOutputNodes where isValidNode n collect n)
        undo off for node in outputs do setUserProp node "CyrusInteractionTransient" true
        if stage==undefined and interactionState!=undefined do cyrusInteractionLive interactionState false
        undo off for node in interactionOutputNodes where isValidNode node and findItem outputs node==0 do delete node
        interactionOutputNodes=outputs;interactionState=stage;interactionStateKey=key;interactionOutputKey=outputKey;interactionError=""
        stage
    )
    fn interactionsRestRows leaf original = (
        local state=this.interactionsEnsure(),slot=findItem procPublishedOwners leaf
        if state==undefined or slot==0 then original else leaf.filterSourceRowsByPolicy (cyrusInteractionRows state slot) procPublishedFinalKeep[slot]
    )
    fn interactionsStatus = (
        if interactionError!="" do return ("Previous contact result retained: "+interactionError)
        if interactionState==undefined then "Choose a layer role. Prepare reacting source models once; contact updates are automatic."
        else cyrusInteractionSummary interactionState
    )
    fn interactionsStatistics = (if interactionState==undefined then throw "No active interaction publication" else cyrusInteractionInfo interactionState)
    fn interactionsRelease = (
        this.interactionsClearGuides()
        interactionState=undefined;interactionStateKey="";interactionOutputKey="";interactionSourceCache=#();interactionReview=undefined;interactionReviewNode=undefined
        interactionOutputNodes=#();true
    )
    fn interactionsBeforeSave = (
        this.interactionsClearGuides()
        -- Layer objects are reference targets, not scene nodes: the scene's
        -- save callback reaches the root only. Review helpers belong to leaves.
        if overlapOwner==undefined do for leaf in layerObjects where leaf!=undefined and leaf!=this do leaf.interactionsBeforeSave()
        undo off for node in interactionOutputNodes where isValidNode node do delete node
        interactionOutputNodes=#();interactionOutputKey="";true
    )
    fn needsClearanceUpgrade = (
        if clearanceUpgradePending do return true
        for leaf in layerObjects where leaf.clearanceUpgradePending do return true
        false
    )
    fn upgradeClearanceScene = (
        if not procSchemaValid do throw "Only the preceding schema 58 scene can be upgraded."
        for leaf in layerObjects do (if not leaf.procSchemaValid do throw "A layer uses an unsupported scene schema.";leaf.validateClearance())
        undo "Upgrade Cyrus scene to 0.87.4" on (
            clearanceUpgradePending=false
            for leaf in layerObjects do (leaf.clearanceUpgradePending=false;for area in leaf.paintAreas do area.clearanceUpgradePending=false)
        )
        this.markInputDirty();this.bindNativeUI();true
    )
    fn imageDensityChanged = (CyrusInvalidateMeshMaskPreview this;markInputDirty())
    fn densityFrameChanged = (
        if distributionMode!=3 or densityCoordinateMode!=2 do return false
        local frame=(this.densityMappingPayload())[10]
        if densityNotifiedFrame!=undefined and frame==densityNotifiedFrame do return false
        densityNotifiedFrame=copy frame
        this.imageDensityChanged();true
    )
    fn requiresDensityUV = (distributionMode==3 and densityCoordinateMode==0)
    fn requiresReceiverMap = (distributionMode==3 and densityCoordinateMode==3)
    fn densityProjectionFrame = (
        local controller=if overlapOwner==undefined then this else overlapOwner
        local node=CyrusRecipeOwnerNode controller,offset=matrix3 1
        if densityFrameBasis.count!=0 or densityFrameOriginWU.count!=0 do (
            if densityFrameBasis.count!=9 or densityFrameOriginWU.count!=3 do throw "Image projection frame is incomplete."
            local b=densityFrameBasis,o=densityFrameOriginWU
            offset=matrix3 [b[1],b[2],b[3]] [b[4],b[5],b[6]] [b[7],b[8],b[9]] [o[1],o[2],o[3]]
        )
        local frame=offset*node.objectTransform
        if abs(dot frame.row1 (cross frame.row2 frame.row3))<1e-12 do throw "Image projection frame is singular."
        frame
    )
    fn densityMappingPayload = (
        local frame=if densityCoordinateMode==2 then inverse (this.densityProjectionFrame()) else matrix3 1
        #(densityCoordinateMode,densityWrapMode,densityTileXWU,(if densityTileLock then densityTileXWU else densityTileYWU),densityRepeatX,(if densityTileLock then densityRepeatX else densityRepeatY),densityHeading,(if densityCoordinateMode==0 then densityUOffset else densityOffsetXWU),(if densityCoordinateMode==0 then densityVOffset else densityOffsetYWU),frame,(if densityResponseSamples.count==0 then #(0.0,1.0) else densityResponseSamples as array))
    )

    local procGridCache=#()
    fn gridPayload = (for key in AminScatterGridFields collect getProperty this key)
    fn gridKey = (cyrusGridKey (this.gridPayload()))
    fn gridSnapshot slot = (
        for entry in procGridCache where entry[1]==slot do return entry[3]
        undefined
    )

    fn selectedPaintArea parent = (
        if parent==undefined do return undefined
        for area in parent.paintAreas where area.layerID==parent.uiAreaID do return area
        if parent.paintAreas.count>0 then parent.paintAreas[1] else undefined
    )
    fn addPaintArea parent target:undefined = (CyrusRequireAuthor();
        if parent==undefined or findItem layerObjects parent==0 or parent.logicalParentID!="" do throw "Select an owning layer first."
        if parent.paintAreas.count>=128 do throw "A layer supports up to 128 Paint Areas."
        local targets=parent.validSurfaces(),area
        if target==undefined and targets.count==1 do target=targets[1]
        if target!=undefined and findItem targets target==0 do throw "Choose a surface assigned to this layer."
        CyrusStopBrush()
        undo "Cyrus add Paint Area" on (
            area=createInstance AminScatterObject
            if theHold.Holding() do cyrusRecipeTrackCreated area
            area.isPaintArea=true;area.layerID=CyrusNewLayerID();area.logicalParentID=parent.layerID
            area.paintSetName="Area "+((parent.paintAreas.count+1) as string)
            area.areaTarget=target;area.paintEnabled=true;area.setOverlapOwner this
            if isValidNode target do area.paintDocument=cyrusBrushCreate target
            append parent.paintAreas area;parent.uiAreaID=area.layerID;parent.paintEnabled=true
        )
        parent.markInputDirty();this.bindNativeUI();CyrusViewportRedraw();area
    )
    fn removePaintArea parent area = (CyrusRequireAuthor();
        local index=findItem parent.paintAreas area
        if index==0 do return false
        CyrusStopBrush()
        undo "Cyrus remove Paint Area" on (deleteItem parent.paintAreas index;parent.uiAreaID="";parent.paintDocument=undefined)
        parent.markInputDirty();this.bindNativeUI();CyrusViewportRedraw();true
    )
    fn setPaintAreaTarget parent area target = (CyrusRequireAuthor();
        if findItem parent.paintAreas area==0 or findItem (parent.validSurfaces()) target==0 do throw "Choose a surface in this layer."
        if area.areaTarget==target do return false
        if area.paintDocument!=undefined and ((cyrusBrushStats area.paintDocument)[2]>0) do throw "This area already has paint. Add another area for a different surface; existing paint is preserved."
        CyrusStopBrush()
        undo "Cyrus Paint Area surface" on (area.areaTarget=target;area.paintDocument=cyrusBrushCreate target)
        parent.markInputDirty();this.bindNativeUI();CyrusViewportRedraw();true
    )
    fn setLayerSurfaces parent nodes = (CyrusRequireAuthor();
        if parent==undefined or findItem layerObjects parent==0 or parent.logicalParentID!="" do throw "Select an owning layer first."
        local targets=#()
        for node in nodes do (
            if not isValidNode node or classof node.baseObject==AminScatterObject do throw "Invalid receiving surface."
            if findItem targets node==0 do append targets node
        )
        if targets.count>128 do throw "A layer supports up to 128 receiving surfaces."
        CyrusStopBrush()
        undo "Cyrus layer surfaces" on (
            parent.surfaceNodes=targets;parent.surface=undefined
        )
        parent.markInputDirty();this.bindNativeUI();CyrusViewportRedraw();true
    )
    fn validatePaintConversion area = (
        if cyrusOrientationVersion==undefined or cyrusOrientationVersion()!=1 or cyrusCandidateInputValidity==undefined or cyrusOrientationInputValidity==undefined or cyrusDiagnosticBegin==undefined or cyrusDiagnosticEnd==undefined or cyrusRecipeVersion==undefined or cyrusRecipeVersion()!=8 or cyrusBrushRecipeExport==undefined or cyrusBrushRecipeImport==undefined or cyrusMeshDensityVersion==undefined or cyrusMeshDensityVersion()!=2 or cyrusBrushConversionVersion==undefined or cyrusBrushConversionVersion()!=2 do throw "Paint/spline conversion requires the matching Cyrus native plugins. Restart Max with the complete pair."
        local parent=if area==undefined then undefined else this.logicalParent area
        if parent==undefined or findItem layerObjects parent==0 or findItem parent.paintAreas area==0 do throw "Select a Paint Area owned by this setup."
        if area.paintDocument==undefined or not isValidNode area.areaTarget or findItem (parent.validSurfaces()) area.areaTarget==0 do throw "Choose a valid receiving surface for this Paint Area."
        if cyrusBrushTarget area.paintDocument!=area.areaTarget do throw "Paint Area and stored receiver do not match."
        true
    )
    fn exportPaintSpline area optimized:false tolerance:0.1 = (
        this.validatePaintConversion area
        local name=(substring area.paintSetName 1 90)+"_Paint_Snapshot"
        if optimized then cyrusBrushExportOptimizedSpline area.paintDocument name tolerance
        else cyrusBrushExportSpline area.paintDocument name
    )
    fn importPaintSpline area node add:false tolerance:0.1 = (
        this.validatePaintConversion area
        local changed=cyrusBrushImportSpline area.paintDocument node add tolerance
        if changed do area.publishPaint()
        changed
    )
    fn sourceVisualIndex row create:false = (
        if row<1 or row>this.sources.count do return 0
        this.ensureSourceRows()
        for values in #(visualSourceLabels,visualSourceColors,visualSourceColorSet) where values.count!=visualSourceKeys.count do throw "Incomplete current source presentation records."
        local index=findItem visualSourceKeys sourceRowIDs[row]
        if index==0 and create do (
            append visualSourceLabels ""
            append visualSourceKeys sourceRowIDs[row]
            append visualSourceColors (this.sourceColor row);append visualSourceColorSet false
            index=visualSourceKeys.count
        )
        index
    )
    fn sourceLabel row = (
        local index=this.sourceVisualIndex row
        if index>0 and visualSourceLabels[index]!="" then visualSourceLabels[index]
        else if this.isPointSource row then "[Point]" else if this.isEmptySource row then "[Empty]"
        else if row>0 and row<=this.sources.count and isValidNode this.sources[row] then this.sources[row].name else "<deleted>"
    )
    fn sourceIDColor row = (
        local index=this.sourceVisualIndex row
        if index>0 and visualSourceColorSet[index] then visualSourceColors[index] else this.sourceColor row
    )
    fn setSourceLabel row value = (
        undo "Cyrus source label" on (local index=this.sourceVisualIndex row create:true;if index>0 do visualSourceLabels[index]=value)
        true
    )
    fn setSourceIDColor rows value = (
        if classof value!=Color and classof value!=Point3 do throw "Source identification color requires a Color or Point3 value."
        undo "Cyrus source identification color" on for row in rows do (
            local index=this.sourceVisualIndex row create:true
            if index>0 do (visualSourceColors[index]=value;visualSourceColorSet[index]=true)
        )
        this.refreshIdentification()
    )
    fn refreshIdentification = (
        local controller=if this.overlapOwner==undefined then this else this.overlapOwner
        if controller.groupSnapshotKey!="" do controller.procEnsureDisplay pending:(controller.groupSnapshotKey!=controller.procInputKey())
        CyrusViewportRedraw();true
    )
    fn getLayerTransfer = layerTransfer
    fn setLayerTransfer state = (layerTransfer=state)
    fn performanceTraceVersion = 1
    fn cacheSnapshot = (#(cachedPoints,cachedPointCount,dirty,previewError,generatedCount,previewBuildCount,previewBuildMs,requestedCount,densityCapped))
    fn restoreCache state = (
        uiPreviewMode=0
        cachedPoints=state[1];cachedPointCount=state[2];dirty=state[3];previewError=state[4]
        generatedCount=state[5];previewBuildCount=state[6];previewBuildMs=state[7]
        requestedCount=state[8];densityCapped=state[9]
    )
    fn forcePreviewUpdate = (markInputDirty();if updateMode==2 or cachedPoints==undefined do previewBuildCount=0)
    fn ensureLayers = layerObjects.count
    fn viewportPreparationLimit idle navigating = (if idle==0 or navigating==0 then 0 else amax idle navigating)
    fn viewportPointPreparationBudget = (
        local wanted=viewportPreparationLimit previewBudget viewportNavigationPoints,capacity=cyrusViewportPointCapacity()
        if wanted==0 then capacity else amin wanted capacity
    )
    fn viewportPointMemoryReduced = (
        local wanted=viewportPreparationLimit previewBudget viewportNavigationPoints,capacity=cyrusViewportPointCapacity()
        if wanted!=0 and wanted<=capacity do return false
        local total=0L
        for i=1 to procPublishedOwners.count where findItem layerObjects procPublishedOwners[i]>0 do (
            local slot=findItem layerObjects procPublishedOwners[i]
            if this.enabledLayer slot and this.visibleLayer slot do total+=(groupSnapshotRows[i].count as integer64)*(if groupCenters then 1 else pointsPerPlant)
        )
        total>capacity
    )
    fn syncLayerSurface obj targets:undefined layerBudget:undefined = (
        obj.setOverlapOwner this
        if obj.showCenters!=this.groupCenters do undo off obj.showCenters=this.groupCenters
        targets=obj.validSurfaces()
        local equal=obj.surfaceNodes.count==targets.count
        if equal do for i=1 to targets.count where obj.surfaceNodes[i]!=targets[i] do equal=false
        if not equal do undo off (obj.surfaceNodes=targets;obj.surface=undefined)
        if layerBudget==undefined do (
            local enabledCount=(for i=1 to layerObjects.count where this.enabledLayer i collect i).count
            layerBudget=this.viewportPointPreparationBudget()
            layerBudget=if layerBudget==0 then 0 else amax 1 (ceil(layerBudget as float/(amax 1 enabledCount)))
        )
        if obj.previewBudget!=layerBudget do undo off obj.previewBudget=layerBudget
        -- These settings belong to the controller, not an individual layer.
        undo off for key in #(#viewportMode,#proxyShape,#viewportInstances,#viewportFaces,#viewportNavigationInstances,#viewportNavigationFaces,#radiusDisplayLimit,#radiusDisplayAll,#radiusDisplayMetric,#updateMode,#showPoints,#pointsPerPlant,#pointColorMode,#solidPointColor,#autoRender) do (
            if getProperty obj key != getProperty this key do setProperty obj key (getProperty this key)
        )
    )
    local editCacheKey=""
    fn layerEntries includeDisabled:false = (
        this.ensureTimeOwner()
        if cyrusEnabled and updateMode==2 do (
            this.liveTimeChanged()
            this.inputTimeKey();inputTimeObserved=inputTimeStamp
            this.orientationTimeKey();orientationTimeObserved=orientationTimeStamp
        )
        local key=CyrusEditStackKey this
        if key!=editCacheKey do (
            editCacheKey=key
            for layer in layerObjects do layer.markInputDirty()
        )
        local entries=#(),targets=validSurfaces()
        local enabledCount=(for i=1 to layerObjects.count where this.enabledLayer i collect i).count
        local layerBudget=this.viewportPointPreparationBudget()
            layerBudget=if layerBudget==0 then 0 else amax 1 (ceil(layerBudget as float/(amax 1 enabledCount)))
        for i=1 to layerObjects.count where includeDisabled or (cyrusEnabled and this.enabledLayer i) do (
            local obj=layerObjects[i]
            syncLayerSurface obj targets:targets layerBudget:layerBudget
            obj.checkAnalyzerRevision();obj.checkPaintRevision()
            append entries #(i,obj)
        )
        if (for e in entries where this.enabledLayer e[1] and e[2].dirty collect e).count>0 do
            for e in entries where this.enabledLayer e[1] and not e[2].dirty do e[2].markInputDirty()
        entries
    )
    fn viewportLayerEntries held = (
        if not held do return (for entry in layerEntries() where this.visibleLayer entry[1] collect entry)
        for i=1 to layerObjects.count where cyrusEnabled and this.enabledLayer i and this.visibleLayer i collect #(i,layerObjects[i])
    )

    fn selectLayer i = (
        if i<1 or i>layerObjects.count do throw "Invalid scatter layer."
        if CyrusBrushSessionLayer!=undefined do CyrusStopBrush()
        activeLayer=i
    )
    fn newLayer = (CyrusRequireAuthor();
        this.syncLayerIdentity()
        if layerObjects.count>=10 do throw "A scatter controller supports up to 10 layers."
        -- Receivers belong to layers. The old controller-level slots no longer
        -- follow assignment edits, so inherit the selected layer's current set.
        local previous=this.selectedLayer()
        local receivers=if previous==undefined then this.validSurfaces() else (this.logicalParent previous).validSurfaces()
        undo "Cyrus Scatter add layer" on (
            cyrusEditOwnerLayers (this.procModifiers()) (for leaf in layerObjects collect leaf.editLayerKey)
            local obj=createInstance AminScatterObject
            if theHold.Holding() do cyrusRecipeTrackCreated obj
            obj.surfaceNodes=receivers as array;obj.surface=undefined
            obj.editLayerKey=nextEditLayerKey;nextEditLayerKey+=1

            obj.randomSeed=42+layerObjects.count*101
            (obj.procOrder=nextEditLayerKey;obj.procSetOrder=nextEditLayerKey)
            append layerObjects obj
            local number=1;local label=""
            do (label="Layer_"+(formattedPrint number format:"02d");number+=1) while findItem layerNames label>0
            obj.layerID=CyrusNewLayerID()
            append layerNames label;append layerEnabled true;append layerVisible true
            activeLayer=layerObjects.count
            syncLayerSurface obj
        )
        activeLayer
    )
    fn removePopulation = (CyrusRequireAuthor();
        if CyrusBrushSessionLayer!=undefined do CyrusStopBrush()
        if layerObjects.count>0 and activeLayer>0 do (
            if (for n in layerObjects[activeLayer].bakedNodes where isValidNode n collect n).count>0 do throw "Remove this layer's baked output first."
            undo "Cyrus Scatter remove layer" on (
                local i=activeLayer
                this.removeGroupRules layerObjects[i]
                -- Remap surviving indices on deletion.
                for layer in layerObjects do (

                    layer.markInputDirty()
                )
                deleteItem layerObjects i;deleteItem layerNames i;deleteItem layerEnabled i
                if i<=layerVisible.count do deleteItem layerVisible i
                activeLayer=amin i layerObjects.count
                cyrusEditOwnerLayers (this.procModifiers()) (for leaf in layerObjects collect leaf.editLayerKey)
            )
        )
        activeLayer
    )
    fn refreshDisplay = (
        local entries=layerEntries(),pending=groupSnapshotKey!="" and groupSnapshotKey!=this.groupInputKey()
        groupDisplayOnly=updateMode==1
        -- One leaf stages the controller's complete display publication.
        -- Repeating it per leaf repeats the same input/owner validation.
        try (
            if entries.count>0 do entries[1][2].refreshPreview()
            if pending and updateMode==1 do for entry in entries do entry[2].markInputDirty()
        ) catch(groupDisplayOnly=false;throw())
        groupDisplayOnly=false;CyrusViewportRedraw()
    )
    fn refreshAll = (CyrusRequireAuthor();
        procManualRevision+=1
        local previousExplicit=procExplicitUpdate
        procExplicitUpdate=true
        -- One leaf refresh evaluates and atomically installs the entire root.
        -- Repeating it per leaf only repeats root validation and key building.
        try (
            local entries=layerEntries()
            if entries.count>0 do entries[1][2].refreshPreview()
        ) catch(procExplicitUpdate=previousExplicit;throw())
        procExplicitUpdate=previousExplicit
        if (CyrusContainerPanel this).controlsReady do (CyrusContainerPanel this).refreshStats()
        this.refreshBrushEditors()
        CyrusViewportRedraw()
    )
    fn allStatus = (
        local plants=0;local points=0;local errors=0
        for entry in (layerEntries()) do (
            local state=entry[2].cacheSnapshot()
            plants+=state[5];points+=state[2];if state[4]!="" do errors+=1
        )
        (layerObjects.count as string)+" groups; "+(plants as string)+" plants; "+(points as string)+(if viewportMode==1 then " cached points" else " cached instances (draw limits apply)")+(if errors>0 then "; "+(errors as string)+" group(s) have a preview error" else "")+(if CyrusPointLastError!="" then "; "+CyrusPointLastError else if CyrusPointDetailStatus!="" then "; "+CyrusPointDetailStatus else "")
    )
    fn clearAllBaked = (CyrusRequireAuthor();
        local owners=refs.dependentNodes this
        if owners.count==1 do for entry in (layerEntries includeDisabled:true) do entry[2].clearBaked owners[1]
        autoRender=true;showPoints=true;CyrusViewportRedraw()
    )

    fn clearBaked ownerNode = (CyrusRequireAuthor();
        local key=ownerNode.handle as string
        undo "Cyrus Scatter remove baked output" on (
            for n in bakedNodes where isValidNode n do (
                if (getUserProp n "AminScatterOwner" as string)==key do delete n
            )
            bakedNodes=#()
        )
    )
    fn bakeInstances ownerNode = (CyrusRequireAuthor();
        local plants=this.outputSources()
        local controller=this.interactionsRoot(),data=controller.interactionsRestRows this (placements plants),contactSlot=findItem controller.procPublishedOwners this
        local fresh=#()
        local ownerKey=ownerNode.handle as string
        undo "Cyrus Scatter build" on (
            try (
                with redraw off (
                    if controller.interactionState!=undefined and contactSlot>0 do for node in (cyrusInteractionBake controller.interactionState contactSlot) do (
                        append fresh node;setUserProp node "AminScatterOwner" ownerKey
                    )
                    local token=if cyrusPlacementIsNative data then cyrusPlacementToken data else undefined
                    for first=0 to data.count-1 by 500 do (
                     local page=if token!=undefined then cyrusPlacementPage data token first (amin 500 (data.count-first)) else for j=first+1 to (amin data.count (first+500)) collect data[j]
                     for row in page do (
                        local n=instance plants[row[2]]
                        append fresh n
                        n.parent=undefined
                        n.name=uniqueName (ownerNode.name+"_Plant_")
                        n.transform=row[1]
                        n.renderable=true;n.isHidden=false
                        setUserProp n "AminScatterOwner" ownerKey
                     )
                    )
                    for n in bakedNodes where isValidNode n do (
                        if (getUserProp n "AminScatterOwner" as string)==ownerKey do delete n
                    )
                    bakedNodes=fresh
                    showPoints=false;autoRender=false
                )
            ) catch (
                for n in fresh where isValidNode n do delete n
                throw()
            )
        )
        fresh.count
    )
    -- Native rollups: one editor per controller, bound to the selected layer.
    -- UI browsing never rebuilds a rollout or a placement cache.
    fn brushMaskActive = (paintEnabled)
    fn brushRelaxPaused = (false)
    fn checkPaintRevision = (
        for area in paintAreas do (area.setOverlapOwner overlapOwner;area.checkPaintRevision())
        if paintDocument!=undefined do (
            local state=cyrusBrushStats paintDocument
            if state[6]==0 and state[1]!=cachedPaintRevision do (cachedPaintRevision=state[1];markInputDirty();if isPaintArea and overlapOwner!=undefined do (local parent=overlapOwner.logicalParent this;CyrusInvalidateMeshMaskPreview parent;parent.markInputDirty()))
        )
    )
    fn paintKey = (
        if paintDocument==undefined then "none" else ((getHandleByAnim paintDocument as string)+":"+((cyrusBrushStats paintDocument)[1] as string)+":"+((cyrusBrushStats paintDocument)[4] as string))
    )
    fn applyPaint rows = (this.procApplyPaint rows)
    fn paintBaseInputKey plants previewOnly receiverLocal:false = (
        local post=if this.sharedSpacing() then #(#cleanupPlanar,#sourceRadiiWU,#sourceAutoRadius,#sourceFollowScale,#finalCleanup,#finalNeighborRadius,#finalMinNeighbors,#finalMinIsland,#finalRelax,#finalStrength,#finalIterations,#finalMaxMove) else #()
        join post CyrusClearanceFields
        join post #(#procOrder,#procSetOrder,#procPopulation,#procAttemptFactor,#procRounds,#procRepair,#procSelfOverride,#procSelfEnabled,#procSelfMultiplier,#procSelfGap,#procSelfPlanar,#procLayerSelfEnabled,#procLayerSelfMultiplier,#procLayerSelfGap,#procLayerSelfPlanar,#procSiblingEnabled,#procSiblingMultiplier,#procSiblingGap,#procSiblingPlanar,#procRadiusIDs,#procRadiusModes,#procRadiusValues,#procRadiusDistances,#procRadiusBinding,#procSourceNodes,#procSourceIDs,#procSourceSlots,#procReceiverNodes,#procReceiverIDs,#procReceiverVariationIDs,#procReceiverID,#containerMode,#containerNodes)
        local stream=stringStream ""
        with printAllElements on (
            format "%|%|%|%|%|" (this.inputTimeKey()) (if receiverLocal then 0 else procGeometryRevision) (if receiverLocal then 0 else if overlapOwner!=undefined then overlapOwner.procManualRevision else procManualRevision) (this.containerSourceKey plants) previewOnly to:stream
            format "DensityMap:%|" (if densityMap==undefined then 0 else getHandleByAnim densityMap) to:stream
            format "Ownership:%:%:%:%|" logicalParentID paintSetEnabled (if receiverLocal or placementMode>1 then 0 else this.effectivePopulation()) (this.effectiveSeed()) to:stream
            if placementMode>1 do format "Placement:%|" (this.gridKey()) to:stream
            if not receiverLocal do format "Variation:%|" (CyrusReceiverVariationDomains this) to:stream
            format "EffectiveRelax:%|" (relaxEnabled and not this.layerPaintActive()) to:stream
            format "FinalRelax:%:%:%:%|" finalRelax finalStrength finalIterations finalMaxMove to:stream
            format "Texture:%|" (this.procWatchDensity()) to:stream
            if distributionMode==3 do format "ImageMapping:%|" (this.densityMappingPayload()) to:stream
            format "MeshMask:%|" (if meshMaskEnabled then this.meshMaskPayload() else #(false)) to:stream
            for key in AminScatterLayerFields where findItem AminScatterGridFields key==0 and (distributionMode==3 or findItem #(#densityUVChannel,#densityResolution) key==0) and findItem AminScatterOrientationFields key==0 and findItem AminScatterSurfaceFilterFields key==0 and findItem AminScatterMeshMaskFields key==0 and findItem #(#paintDocument,#paintEnabled,#paintDensity,#bakedNodes,#showPoints,#pointsPerPlant,#updateMode,#autoRender,#previewBudget,#pointColorMode,#solidPointColor) key==0 and findItem post key==0 and findItem #(#paintView,#paintColor,#showCenters,#sourceShowRadius,#paintSetName,#paintSetVisible,#fieldFalloff,#fieldBoundaries,#fieldCombined,#fieldSamples,#fieldBandID) key==0 and ((not receiverLocal and placementMode==1) or findItem #(#amount,#plantsPerM2,#populationMode) key==0) do format "%:%|" key (if key==#sources then this.containerSourceKey (sources as array) else getProperty this key) to:stream
            for n in ((if receiverLocal then #() else this.validSurfaces())+(sources as array)+(areaNodes as array)+(patternLines as array)+#(analyzerNode,areaAnalyzer,fallAnalyzer)) where isValidNode n do (
                local tm=n.objectTransform
                if this.containerProvider()!=undefined and findItem sources n>0 do tm.row4=[0,0,0]
                format "%:%|" (getHandleByAnim n) tm to:stream
            )
            for n in #(analyzerNode,areaAnalyzer,fallAnalyzer) where isValidNode n do format "%|" (n.getAnalysisRuns()) to:stream
            format "%|%|%|%|%|%|%|%|%|" strokeSides strokeModes strokeColorRows strokeColorKeys strokeSourceRows strokeMin strokeMax strokeSourceIDs sourceRowIDs to:stream
            if diversityMode==3 do format "Bands2:%|%|%|%|%|%|%|%|%|%|" bandArrangement pathIDs pathJoins strokeIDs strokePathIDs strokeStarts strokeEnds strokeStrengths strokeCurveEnabled strokeCurveSamples to:stream
            if diversityMode==3 do format "BandScale:%|%|" strokeScaleModes strokeScaleSamples to:stream
        )
        stream as string
    )
    fn paintCacheStats = (#(paintBaseBuilds,paintBaseHits,if paintBaseRows==undefined then 0 else paintBaseRows.count))
    fn publishPaint = (
        checkPaintRevision()
        if (CyrusContainerPanel this).controlsReady do (CyrusContainerPanel this).refreshStats()
        CyrusViewportRedraw()
    )

    fn resetRandomization group = (CyrusRequireAuthor();
        local values=case group of (
            #rotation: #(#(#rotXMin,0.0),#(#rotXMax,0.0),#(#rotYMin,0.0),#(#rotYMax,0.0),#(#rotZMin,0.0),#(#rotZMax,0.0),#(#tiltDegrees,0.0),#(#yawMinimum,0.0),#(#yawMaximum,0.0))
            #scale: #(#(#sclXMin,1.0),#(#sclXMax,1.0),#(#sclYMin,1.0),#(#sclYMax,1.0),#(#sclZMin,1.0),#(#sclZMax,1.0),#(#scaleMinimum,1.0),#(#scaleMaximum,1.0))
            #wholeScale: #(#(#wholeScaleMin,1.0),#(#wholeScaleMax,1.0))
            #movement: #(#(#movXMinWU,0.0),#(#movXMaxWU,0.0),#(#movYMinWU,0.0),#(#movYMaxWU,0.0),#(#movZMinWU,0.0),#(#movZMaxWU,0.0),#(#movementRange,0.0))
            default: undefined
        )
        if values==undefined do return false
        local priorTransfer=layerTransfer
        layerTransfer=true
        try (for row in values do setProperty this row[1] row[2]) catch(layerTransfer=priorTransfer;throw())
        layerTransfer=priorTransfer;markInputDirty();true
    )
    fn resetSelectedRandomization group = (CyrusRequireAuthor();
        local layer=this.selectedLayer()
        if layer==undefined do return false
        local caption=case group of (#rotation:"Cyrus reset rotation";#scale:"Cyrus reset XYZ scale";#wholeScale:"Cyrus reset whole scale";#movement:"Cyrus reset movement";default:undefined)
        if caption==undefined do return false
        undo caption on layer.resetRandomization group
        this.bindNativeUI()
        if (CyrusContainerPanel this).controlsReady do (CyrusContainerPanel this).refreshStats()
        CyrusViewportRedraw();true
    )
    fn selectedLayer = (
        if activeLayer>0 and activeLayer<=layerObjects.count then layerObjects[activeLayer] else undefined
    )
    fn syncLayerIdentity = (
        undo off (
            while layerVisible.count<layerObjects.count do append layerVisible true
            while layerVisible.count>layerObjects.count do deleteItem layerVisible layerVisible.count
            for i=1 to layerObjects.count do (
                local layer=layerObjects[i]
                if layer.layerID=="" or layer.layerID=="dotNetObject:System.Guid" do layer.layerID=CyrusNewLayerID()
                if layer.editLayerKey==0 do layer.editLayerKey=i
                if nextEditLayerKey<=layer.editLayerKey do nextEditLayerKey=layer.editLayerKey+1
            )
        )
    )
    fn copySelectedLayer = (CyrusRequireAuthor();
        local leaf=this.selectedLayer()
        if leaf==undefined do return false
        local parent=this.copyLogicalLayer (this.logicalParent leaf)
        activeLayer=findItem layerObjects parent;parent
    )
    fn removeLayer = (CyrusRequireAuthor();
        local leaf=this.selectedLayer()
        if leaf==undefined do return false
        this.removeLogicalLayer leaf
    )
    local updateUI,surfaceUI,previewUI,layersUI,uiRootState=#(),uiPresentationState=#()

    -- One bounded map-only bake, independent of receiver geometry and selected UVs.
    -- A failed successor never replaces a complete sampled image.
    fn densityCacheStats = (#(procDensityBakes,procDensityHits,procDensityInversions,procDensityBakeMs,if procDensityCache.count==0 then 0 else (cyrusDensityImageCount procDensityCache[5])+(if procDensityCache[6]==undefined then 0 else cyrusDensityImageCount procDensityCache[6])))
    fn procDensityWeights = (
        if densityMap==undefined do throw "Choose a density texture map."
        if this.requiresReceiverMap() do return #(densityMap,invertDensity)
        if densityUVChannel<1 or densityUVChannel>99 do throw "Density UV channel must be 1..99."
        if findItem #(64,128,256,512) densityResolution==0 do throw "Density resolution must be 64, 128, 256 or 512."
        local revision=this.procWatchDensity(),tick=currentTime as integer,cached=procDensityCache
        local reusable=cached.count==6 and cached[1]==densityMap and cached[2]==revision and cached[3]==densityResolution
        if reusable do reusable=tick>=cached[4][1] and tick<=cached[4][2]
        if reusable then procDensityHits+=1
        else (
            local image=undefined,weights=#(),started=timeStamp(),interval=cyrusScatterInputValidity #() #() #(densityMap),measurement=CyrusMeasureBegin 11
            try (
                image=renderMap densityMap size:[densityResolution,densityResolution]
                if image==undefined do throw "Density map could not be sampled."
                weights=cyrusCaptureDensityImage image
                close image;image=undefined
            )catch(CyrusMeasureEnd measurement layerID procEpoch "map_bake_failed" failed:true;if image!=undefined do try(close image)catch();throw())
            CyrusMeasureEnd measurement layerID procEpoch "map_baked"
            cached=#(densityMap,revision,densityResolution,interval,weights,undefined)
            procDensityCache=cached;procDensityBakes+=1;procDensityBakeMs=timeStamp()-started
        )
        if not invertDensity do return cached[5]
        if cached[6]==undefined do (cached[6]=cyrusDensityImageInvert cached[5];procDensityInversions+=1)
        cached[6]
    )
    fn procWatchDensity = (
        global CyrusDensityMapChanged
        local watched=if distributionMode==3 then densityMap else undefined
        if procDensityMap!=watched do (
            if procDensityWatch!=undefined do deleteChangeHandler procDensityWatch
            procDensityWatch=undefined;procDensityMap=watched;procDensityRevision+=1;procDensityCache=#()
            if watched!=undefined do procDensityWatch=when parameters watched changes id:#CyrusDensityMap affected do (CyrusDensityMapChanged affected)
        )
        procDensityRevision
    )
    fn procReadSnapshot = (
        -- A reopened scene has no transient publication and reconstructs once.
        -- After that, only Live or explicit Update may publish pending settings.
        if updateMode==2 or groupSnapshotKey=="" do this.evaluateProcedural()
        groupSnapshotRows
    )
    fn outputSources = (
        if overlapOwner==undefined do return this.validSources()
        local root=overlapOwner
        root.procReadSnapshot()
        local i=findItem root.procPublishedOwners this
        if i==0 do return #()
        local plants=root.procPublishedSources[i]
        for n in plants where classof n!=Integer do if not isValidNode n do throw "A published source was deleted. Restore it or Update before exact output."
        plants
    )
    fn procStatistics = (#(procLastStats as array,procLastRounds as array,procPreparedBuilds,procPreparedHits,procEpoch))
    fn procSort members sets:false = (
        local result=members as array
        for i=2 to result.count do (
            local chosen=result[i],j=i-1,key=if sets then chosen.procSetOrder else chosen.procOrder
            while j>0 and (if sets then result[j].procSetOrder else result[j].procOrder)>key do (result[j+1]=result[j];j-=1)
            result[j+1]=chosen
        )
        result
    )
    fn procMove item delta sets:false = (CyrusRequireAuthor();
        local members=if sets then this.layerSets (this.logicalParent item) else this.logicalLayers()
        local i=findItem members item,j=i+delta
        if i==0 or j<1 or j>members.count do return false
        members[i]=members[j];members[j]=item
        undo "Cyrus evaluation order" on for k=1 to members.count do setProperty members[k] (if sets then #procSetOrder else #procOrder) k
        this.invalidateGroups();this.bindNativeUI();true
    )
    fn procModifiers = (
        local result=#()
        for node in refs.dependentNodes this where node.baseObject==this do for m in node.modifiers where classof m==CyrusScatterEdit do appendIfUnique result m
        result
    )
    fn procEditKey = (
        local text="ProceduralEdit1"
        for m in this.procModifiers() do text+="|"+(getHandleByAnim m as string)+":"+(m.enabled as string)+":"+(cyrusEditLocalRevision m as string)
        text
    )
    fn procSyncEditVisibility = (
        for m in this.procModifiers() do (
            cyrusEditActiveLayers m (for i=1 to layerObjects.count where cyrusEnabled and this.enabledLayer i collect layerObjects[i].editLayerKey)
            for i=1 to layerObjects.count do cyrusEditGroupVisibility m layerObjects[i].editLayerKey (cyrusEnabled and this.visibleLayer i)
        )
        true
    )
    fn procEnsureSources = (
        this.syncStrokes()
        this.ensureFallCurves();this.ensureAreaFalloffs()
        this.procEnsureCorrespondence()
    )
    fn procEnsureCorrespondence = (
        this.ensureSourceRows()
        local domains=CyrusReceiverVariationDomains this,previousReceivers=procReceiverNodes.count
        -- Keep correspondence history so replacing a node and Undo can recover
        -- its original binding. This metadata never becomes an artist Undo step.
        undo off (
            local ids=#()
            for i=1 to sources.count do (
                local node=sources[i]
                if isValidNode node then (
                    local index=findItem procSourceNodes node
                    if index==0 do (
                        if procSourceNodes.count>=1024 do throw "Source identity history is full. Create a new setup before enrolling more assets."
                        append procSourceNodes node;append procSourceIDs (CyrusNewLayerID());index=procSourceNodes.count
                    )
                    append ids procSourceIDs[index]
                ) else (
                    -- Retain saved legacy placeholder IDs for provable hydration.
                    -- New Points/gaps use their persistent authored row identity;
                    -- list compaction must never transfer an older row's edits.
                    local id=if i<=procSourceSlots.count then procSourceSlots[i] else ""
                    if not (matchPattern id pattern:"placeholder:*") do id="placeholder:"+sourceRowIDs[i]
                    append ids id
                )
            )
            local same=procSourceSlots.count==ids.count
            if same do for i=1 to ids.count where ids[i]!=procSourceSlots[i] do same=false
            if not same do procSourceSlots=ids
            local receiverKey=""
            for node in this.validSurfaces() do (
                local index=findItem procReceiverNodes node
                if index==0 do (
                    if procReceiverNodes.count>=128 do throw "Receiver identity history is full. Create a new setup before enrolling more surfaces."
                    append procReceiverNodes node;append procReceiverIDs (CyrusNewLayerID());index=procReceiverNodes.count
                    append domains procReceiverIDs[index]
                )
                receiverKey+=procReceiverIDs[index]+"|"
            )
            if procReceiverNodes.count!=previousReceivers do procReceiverVariationIDs=domains
            if procReceiverID!=receiverKey do procReceiverID=receiverKey
        )
    )
    fn procPair scope a b = (
        for i=1 to procRuleA.count where procRuleScope[i]==scope and ((procRuleA[i]==a.layerID and procRuleB[i]==b.layerID) or (procRuleA[i]==b.layerID and procRuleB[i]==a.layerID)) do return i
        0
    )
    fn procSetPair scope a b enabled multiplier gap planar = (CyrusRequireAuthor();
        if scope!=1 and scope!=2 do throw "Unknown spacing scope."
        if a==b or findItem layerObjects a==0 or findItem layerObjects b==0 do throw "Choose two existing owners."
        if scope==1 and (this.logicalParent a)!=(this.logicalParent b) do throw "Paint-set rules require siblings."
        if scope==2 and (a.logicalParentID!="" or b.logicalParentID!="") do throw "Layer rules require logical layers."
        if multiplier<0 or gap<0 do throw "Spacing values must be nonnegative."
        undo "Cyrus scoped spacing" on (
            local i=this.procPair scope a b
            if i==0 do (
                append procRuleScope scope;append procRuleA a.layerID;append procRuleB b.layerID
                append procRuleEnabled false;append procRuleMultiplier 1.0;append procRuleGapWU 0.0;append procRulePlanar false;i=procRuleA.count
            )
            procRuleEnabled[i]=enabled;procRuleMultiplier[i]=multiplier;procRuleGapWU[i]=gap;procRulePlanar[i]=planar
        )
        this.invalidateGroups()
    )
    fn procRemoveRule i = (CyrusRequireAuthor();
        if i>0 do for key in #(#procRuleScope,#procRuleA,#procRuleB,#procRuleEnabled,#procRuleMultiplier,#procRuleGapWU,#procRulePlanar) do deleteItem (getProperty this key) i
    )
    fn procRemoveOwner leaf = (CyrusRequireAuthor();
        for i=procRuleA.count to 1 by -1 where procRuleA[i]==leaf.layerID or procRuleB[i]==leaf.layerID do this.procRemoveRule i
    )
    fn procCopyRelations originals copies = (
        -- Remap references inside the copy; preserve external layer rules.
        (
            for s=1 to copies.count do (
                local leaf=copies[s]
                leaf.procRadiusIDs=#();leaf.procRadiusModes=#();leaf.procRadiusValues=#();leaf.procRadiusDistances=#();leaf.procRadiusBinding=""
                for index=1 to leaf.clearanceTargets.count do (
                    local targets=filterString leaf.clearanceTargets[index] "|",packed=""
                    for id in targets do (
                        local targetID=id
                        for j=1 to originals.count do if id==originals[j].layerID do targetID=copies[j].layerID
                        packed+=targetID+"|"
                    )
                    leaf.clearanceTargets[index]=packed
                )
            )
            local count=procRuleA.count
            for i=1 to count do (
                local a=undefined,b=undefined,changed=false
                for j=1 to originals.count do (
                    if procRuleA[i]==originals[j].layerID do (a=copies[j];changed=true)
                    if procRuleB[i]==originals[j].layerID do (b=copies[j];changed=true)
                )
                if changed do (
                    if a==undefined do for leaf in layerObjects where leaf.layerID==procRuleA[i] do a=leaf
                    if b==undefined do for leaf in layerObjects where leaf.layerID==procRuleB[i] do b=leaf
                    if a!=undefined and b!=undefined do this.procSetPair procRuleScope[i] a b procRuleEnabled[i] procRuleMultiplier[i] procRuleGapWU[i] procRulePlanar[i]
                )
            )
            if copies.count>0 do copies[1].procOrder=nextEditLayerKey
        )
    )
    fn procSelfRule = (
        if procSelfOverride then #(procSelfEnabled,procSelfMultiplier,procSelfGap,procSelfPlanar)
        else (
            local parent=if overlapOwner==undefined then this else overlapOwner.logicalParent this
            #(parent.procLayerSelfEnabled,parent.procLayerSelfMultiplier,parent.procLayerSelfGap,parent.procLayerSelfPlanar)
        )
    )
    fn procAutoRequired i = (
        if not this.sourceUsesAuto i or this.sourceWeight i<=0 do return false
        if this.containerProvider()!=undefined and (i>containerActive.count or not containerActive[i]) do return false
        if diversityMode!=3 and diversityMode!=4 do return true
        this.syncStrokes()
        for band=1 to patternLines.count where isValidNode patternLines[band] do (
            local active=if diversityMode==3 then not isProperty patternLines[band] #samplePoints else patternLines[band]==analyzerNode
            if active and diversityMode==3 do active=(strokeStrengths[band]>0 and (amax (this.bandCurve band))>0 and (if bandArrangement==1 then patternWidths[band]>0 else strokeEnds[band]>strokeStarts[band]))
            if active do (
                if strokeModes[band]==1 then (
                    for k=1 to strokeColorRows.count where strokeColorRows[k]==band and strokeColorKeys[k]==colorKey(this.sourceColor i) do return true
                ) else (
                    for k=1 to strokeSourceRows.count where strokeSourceRows[k]==band and strokeSourceIDs[k]==sourceRowIDs[i] do return true
                )
            )
        )
        false
    )
    fn procRadiusGeometry plants rows:#() enabled:true = (
        -- Validate the whole active lottery before sampling, including missing
        -- original rows which validSources deliberately omits from transport.
        local required=for i=1 to sources.count collect (enabled and this.procAutoRequired i)
        for i=1 to required.count where required[i] and not this.sourceCanAuto i do throw ("Auto Radius: "+this.sourceLabel i+" is missing or has an unqualified source type. Restore supported geometry or choose Manual.")
        local used=#{}
        if cyrusPlacementIsNative rows then (
            local usage=this.procSourceUsage rows
            for i=1 to usage.count where usage[i]>0 do used[i]=true
        ) else if rows.count>0 do throw "Source radius preparation requires native placements."
        local inputs=for k=1 to plants.count collect (
            local i=this.sourceRow plants[k]
            if used[k] or (i>0 and required[i]) then plants[k] else 0
        )
        local info=cyrusSourceGeometryInfo inputs
        for k=1 to plants.count do (
            local i=this.sourceRow plants[k]
            if this.sourceUsesAuto i and (used[k] or required[i]) do (
                if info[k][1]!=1 or not info[k][6] do throw ("Auto Radius: "+this.sourceLabel i+". "+info[k][7]+". The previous result is retained; repair the source or choose Manual.")
            )
        )
        info
    )
    fn procRadii rows plants geometry:undefined inactive:false = (
        if geometry==undefined do geometry=this.procRadiusGeometry plants rows:rows
        local specs=if plants.count==0 then #(#(1,0.0,false,[0,0,0],[0,0,0])) else for k=1 to plants.count collect (
            local i=this.sourceRow plants[k],info=geometry[k]
            #(if this.sourceUsesAuto i and info[1]==1 then 2 else 1,this.sourceRadius i,this.sourceFollows i,info[4],info[5])
        )
        -- Disabled populations have no prepared generation after scene load.
        -- Their empty radii need no replay; keep all saved overrides untouched.
        if inactive and rows.count==0 do return cyrusProceduralRadii rows specs #() #() #()
        if procRadiusIDs.count>0 and procRadiusBinding=="" do throw "Radius overrides have no generation binding. Restore their matching setup before updating."
        if procRadiusDistances.count!=procRadiusIDs.count do throw "Instance distance metadata is incomplete."
        local values=for i=1 to procRadiusIDs.count collect (if procRadiusModes[i]==1 then procRadiusDistances[i] else procRadiusValues[i])
        if procRadiusIDs.count==0 then cyrusProceduralRadii rows specs #() #() #()
        else cyrusProceduralRadii rows specs (procRadiusIDs as array) (procRadiusModes as array) values procBindingKey procRadiusBinding
    )
    fn procSelectedRadius mode value reset:false = (CyrusRequireAuthor();
        if overlapOwner==undefined do throw "Select a paint set using Procedural 0.7."
        if mode<1 or mode>2 or value<0 do throw "Invalid instance radius."
        if procBindingKey=="" do throw "Update a valid binding before assigning radii."
        local ids=cyrusEditSelectedIDs (overlapOwner.procModifiers()) editLayerKey
        if ids.count==0 do throw "Select plant instances in CS Edit first."
        local next=cyrusSourceRadiusEdit procPreparedRows procBindingKey procRadiusBinding (procRadiusIDs as array) (procRadiusModes as array) (procRadiusValues as array) (procRadiusDistances as array) ids mode value reset
        undo "Cyrus selected instance radii" on (
            procRadiusIDs=next[1];procRadiusModes=next[2];procRadiusValues=next[3];procRadiusDistances=next[4];procRadiusBinding=next[5]
        )
        overlapOwner.invalidateGroups()
    )
    fn procClearRadii = (CyrusRequireAuthor();
        undo "Cyrus clear set radius overrides" on (procRadiusIDs=#();procRadiusModes=#();procRadiusValues=#();procRadiusDistances=#();procRadiusBinding="")
        if overlapOwner!=undefined do overlapOwner.invalidateGroups()
    )
    fn procCoverageKey = (
        local stream=stringStream ""
        format "%:%:%|" (this.paintKey()) paintEnabled paintDensity to:stream
        for area in paintAreas do format "Area:%:%:%:%:%|" area.layerID area.areaTarget area.paintSetEnabled area.paintDensity (area.paintKey()) to:stream
        stream as string
    )
    fn procApplyPaint rows = (
        if not paintEnabled do return rows
        if rows.count==0 do return rows
        local docs=#(),densities=#(),targets=this.validSurfaces()
        for area in paintAreas where area.paintSetEnabled and area.paintDocument!=undefined and findItem targets area.areaTarget>0 do (
            if cyrusBrushTarget area.paintDocument!=area.areaTarget do throw "Paint Area target mismatch; saved vector borders are preserved."
            append docs area.paintDocument;append densities area.paintDensity
        )
        local measurement=CyrusMeasureBegin 4,result
        try(result=cyrusBrushRegionFilter rows docs densities targets paintBaseFaceCounts ("CyrusStableMask1:"+(this.effectiveSeed() as string)))catch(CyrusMeasureEnd measurement layerID procEpoch "paint_mask" failed:true;throw())
        CyrusMeasureEnd measurement layerID procEpoch "paint_mask"
        result
    )
    fn procBinding plants rows sourceAware:false = (
        local stream=stringStream "",domains=CyrusReceiverVariationDomains this
        with printAllElements on (
            format "CyrusBinding2:%|" (this.effectiveSeed()) to:stream
            if sourceAware do format "EditOwner:%|" layerID to:stream
            if placementMode>1 do format "Placement:%|" (this.gridKey()) to:stream
            if not sourceAware do for n in plants do (local i=sourceRow n;format "%|" (if i>0 and i<=procSourceSlots.count then procSourceSlots[i] else "preview") to:stream)
            for key in #(#distributionMode,#diversityMode,#diversitySize,#diversitySeed,#roughness,#blurryEdge,#diversityNoise,#sourceWeights,#sourceColors,#sourceEmpty,#sourcePoint,#sourceScales,#sourceZOffsetsWU,#advancedAxes,#scaleMinimum,#scaleMaximum,#tiltDegrees,#yawMinimum,#yawMaximum,#movementRange,#sclXMin,#sclXMax,#sclYMin,#sclYMax,#sclZMin,#sclZMax,#rotXMin,#rotXMax,#rotYMin,#rotYMax,#rotZMin,#rotZMax,#movXMinWU,#movXMaxWU,#movYMinWU,#movYMaxWU,#movZMinWU,#movZMaxWU,#wholeScaleMin,#wholeScaleMax,#projectMove) where not sourceAware or findItem #(#sourceWeights,#sourceColors,#sourceEmpty,#sourcePoint,#sourceScales,#sourceZOffsetsWU) key==0 do format "%:%|" key (getProperty this key) to:stream
            if diversityMode>=3 do for key in #(#patternLines,#patternWidths,#strokeSides,#strokeModes,#strokeColorRows,#strokeColorKeys,#strokeSourceRows,#strokeSourceIDs,#sourceRowIDs,#pathIDs,#pathJoins,#strokeIDs,#strokePathIDs,#bandArrangement,#strokeStarts,#strokeEnds,#strokeStrengths,#strokeCurveEnabled,#strokeScaleModes,#strokeScaleSamples,#strokeCurveSamples,#strokeMin,#strokeMax,#analyzerNode,#edgeOffsetsWU,#edgeAlongWU,#edgeAcrossWU,#edgeKeepCorners,#edgeCornerAngle,#edgeCornerCount,#edgeFaceOut,#edgeCornerRadius,#edgeRotX,#edgeRotY,#edgeRotZ,#borderFaceOut,#streetFaceOut,#borderCornerRadius,#streetCornerRadius,#streetStraight,#streetTrimStart,#streetTrimEnd,#centerStreetOffset) where not sourceAware or findItem #(#strokeColorRows,#strokeColorKeys,#strokeSourceRows,#strokeSourceIDs,#sourceRowIDs) key==0 do format "%:%|" key (getProperty this key) to:stream
            if relaxEnabled or finalRelax do for key in #(#relaxEnabled,#relaxSpacing,#relaxIterations,#relaxStrength,#finalRelax,#finalStrength,#finalIterations,#finalMaxMove) do format "%:%|" key (getProperty this key) to:stream
            format "\nCyrusReceivers2\n" to:stream
            for entry in procReceiverGeometry do (
                local slot=entry[1],value=entry[2]
                -- Keep the receiver's binding key stable. A changed domain is
                -- changed generation data, never a newly added receiver.
                -- The default domain preserves the exact preceding binding.
                if domains[slot]!=procReceiverIDs[slot] do value+="|Variation:"+domains[slot]
                format "%=%\n" procReceiverIDs[slot] value to:stream
            )
        )
        stream as string
    )

    -- Keep the preceding descriptor byte-for-byte for provable legacy hydration.
    -- Membership and source settings are compared by native correspondence, never
    -- by a source-list index that changes when an earlier model is removed.
    fn procSourceEditBinding plants rows = (
        local legacy=this.procBinding plants rows,basis=this.procBinding plants rows sourceAware:true
        local specs=for n in plants collect (
            local row=this.sourceRow n,stream=stringStream ""
            if row<1 or row>procSourceSlots.count do throw "Edit source correspondence is missing. Update the matching setup first."
            with printAllElements on (
                format "%|%|%|%|%|%|%|" (this.sourceWeight row) (this.sourceColor row) (this.isEmptySource row) (this.isPointSource row) (this.sourceScale row) (this.sourceZOffset row) (this.sourceForward row) to:stream
                if diversityMode>=3 do (
                    local assigned=#(),group=this.colorKey (this.sourceColor row),id=sourceRowIDs[row]
                    for band=1 to strokeIDs.count do (
                        local found=false
                        if strokeModes[band]==1 then (for k=1 to strokeColorRows.count where strokeColorRows[k]==band and strokeColorKeys[k]==group do found=true)
                        else (for k=1 to strokeSourceRows.count where strokeSourceRows[k]==band and strokeSourceIDs[k]==id do found=true)
                        if found do append assigned strokeIDs[band]
                    )
                    format "Bands:%|" assigned to:stream
                )
            )
            #(procSourceSlots[row],stream as string)
        )
        cyrusSourceEditBinding legacy basis specs
    )

    fn receiverCacheStats = (#(procReceiverBuilds,procReceiverHits,procReceiverCache.count))
    fn procPlanReceivers active remaining:1000000 = (
        -- Removing the last authored source publishes an empty successor even
        -- when a retained mask/channel or grid cannot evaluate on the receiver.
        -- Keep the authored inputs for a later replacement model; do not allocate
        -- candidates or retain their previous receiver/grid snapshots.
        if (this.validSources()).count==0 do (
            procReceiverGeometry=#();procGridCache=#();procReceiverCache=#()
            procReceiverPlanData=#(#(),#(),0,0,false,0);densityCapped=false
            return procReceiverPlanData
        )
        local parent=overlapOwner.logicalParent this,allocation=this.effectivePopulation(),meters=units.decodeValue "1m"
        local requirements=cyrusEditReceiverRequirements active editLayerKey,inputs=#(),nextGrid=#(),gridInputs=#(),gridCells=0
        local domains=CyrusReceiverVariationDomains this,placementKey=this.gridKey()
        procReceiverGeometry=#()
        for node in this.validSurfaces() do (
            local slot=findItem procReceiverNodes node
            local geometry=cyrusProceduralSurfaceKey #(node) (this.requiresDensityUV()) densityUVChannel,mapKey="off"
            if this.requiresReceiverMap() do (
                if densityMap==undefined do throw "Choose a density texture map."
                mapKey=cyrusReceiverMapKey node densityMap
            )
            append procReceiverGeometry #(slot,geometry,(if meshMaskEnabled then cyrusMeshDensityKey node (this.meshMaskPayload()) else "off"),mapKey)
            if placementMode==1 then append inputs #(slot,procReceiverIDs[slot],(aminScatterSurfaceArea #(node)),requirements[slot])
            else (
                local key=geometry+"|UV:"+(distributionMode as string)+":"+(densityUVChannel as string)+"|"+placementKey+"|"+domains[slot]+"|"+((this.effectiveSeed()) as string),snapshot=undefined
                for entry in procGridCache where entry[1]==slot and entry[2]==key do snapshot=entry[3]
                if snapshot==undefined do snapshot=cyrusGridPrepare node (this.gridPayload()) (this.effectiveSeed()) domains[slot] (this.requiresDensityUV()) densityUVChannel (remaining-gridCells)
                local info=cyrusGridSnapshotInfo snapshot
                gridCells+=info[1]
                if gridCells>remaining do throw "Grid cells exceed this setup's remaining candidate budget. Increase spacing or reduce the terrain domain. The previous result is retained."
                append nextGrid #(slot,key,snapshot);append gridInputs #(slot,snapshot)
            )
        )
        local nextPlan=if placementMode>1 then cyrusGridPlan gridInputs else cyrusReceiverPlan inputs allocation[1] (if parent.populationMode==2 then allocation[2]/(meters*meters) else -1.0) (if parent.procPopulation==2 then parent.procAttemptFactor else 1) ((overlapOwner.populationAllocation this countOverride:1000000)[1])
        procReceiverPlanData=nextPlan;procGridCache=nextGrid
        densityCapped=procReceiverPlanData[5]
        procReceiverPlanData
    )


    -- Persistent source rows own artist settings. Containers only admit/park
    -- those rows; they never compact the registered list on boundary crossing.
    fn containerRoot = (if overlapOwner==undefined then this else overlapOwner)
    fn containerProvider = (
        if containerMode==1 do return undefined
        local root=this.containerRoot()
        case containerMode of (
            2:(if overlapOwner==undefined or logicalParentID=="" then root else (root.logicalParent this).containerProvider())
            3: root
            4: this
            default:(throw "Unknown source-container mode.")
        )
    )
    fn effectiveContainers = (
        local provider=this.containerProvider()
        if provider==undefined then #() else if provider==this.containerRoot() then provider.containerGlobalNodes as array else provider.containerNodes as array
    )
    fn containerSourceKey plants = (
        if this.containerProvider()==undefined then plants else (for n in plants collect (if classof n==Integer then n else if isValidNode n then getHandleByAnim n else 0))
    )
    fn containerFrames = (
        local result=#(),nodes=this.effectiveContainers()
        if nodes.count>32 do throw "A source pool supports at most 32 containers."
        for n in nodes where isValidNode n and n.collectEnabled do (
            if classof n.baseObject!=CyrusSourceContainer or n.modifiers.count>0 do throw "Use a Cyrus Source Container without modifiers."
            local tm=n.objectTransform,volume=(length tm.row1)*(length tm.row2)*(length tm.row3)
            if volume<=0 or abs(dot tm.row1 (cross tm.row2 tm.row3))<=volume*1e-8 do throw "A source container has a singular transform. Restore its scale."
            if n.width<=0 or n.length<=0 do throw "Source container dimensions must be positive."
            if isProperty n #cornerRadius and n.cornerRadius!=0 do throw "Source containers require square rectangle corners."
            append result #((inverse tm),n.width/2,n.length/2)
        )
        result
    )
    fn containerContains node frames = (
        if not isValidNode node do return false
        local pivot=node.transform.row4
        for frame in frames do (
            local p=pivot*frame[1],epsilon=(amax 1e-4 ((amax frame[2] frame[3])*1e-6))
            if abs p.x<=frame[2]+epsilon and abs p.y<=frame[3]+epsilon do return true
        )
        false
    )
    fn containerEligible node excluded = (
        if not isValidNode node or superclassof node!=GeometryClass or isGroupHead node do return false
        if not this.usableSource node or classof node.baseObject==CyrusPointDisplay or classof node.baseObject==CyrusSourceContainer do return false
        if getUserProp node "CyrusPFTransient"==true do return false
        if findItem excluded node>0 do return false
        canConvertTo node Editable_Mesh
    )
    fn containerRegister node = (
        this.ensureSourceRows()
        if findItem sources node>0 do return false
        if sources.count>=1024 do throw "Source registration is full (1,024 rows). Remove unused rows explicitly."
        -- Fill optional tabs before appending so a new source cannot inherit
        -- a prior row's sparse setting. Automatic registration survives parking.
        undo off (
            syncColors()
            for spec in #(#(#sourceWeights,1.0),#(#sourceZOffsetsWU,0.0),#(#sourceScales,1.0),#(#sourceForwardAxes,1),#(#sourceRadiiWU,0.0),#(#sourceAutoRadius,false),#(#sourceFollowScale,false),#(#sourceShowRadius,false),#(#sourcePoint,false),#(#sourceEmpty,false)) do (
                local values=getProperty this spec[1]
                while values.count<sources.count do append values spec[2]
                append values spec[2]
            )
            append sources node;append sourceRowIDs (CyrusNewLayerID());append sourceColors (this.sourceColor sources.count)
        )
        markInputDirty();true
    )
    fn containerRefresh = (
        if containerReconciling do return false
        if this.containerProvider()==undefined do (containerActive=#();containerMembershipKey="manual";return false)
        containerReconciling=true
        try (
            local nodes=this.effectiveContainers(),changed=false
            local state=for n in nodes collect (
                if isValidNode n then (
                    if classof n.baseObject!=CyrusSourceContainer do throw "Use a Cyrus Source Container."
                    #(n,n.objectTransform,n.width,n.length,n.modifiers.count,if isProperty n #cornerRadius then n.cornerRadius else 0,n.collectEnabled)
                ) else #(undefined)
            )
            local configurationChanged=containerConfigKey=="" or state.count!=containerFrameState.count
            if not configurationChanged do for i=1 to state.count while not configurationChanged do (
                if state[i].count!=containerFrameState[i].count then configurationChanged=true
                else for j=1 to state[i].count where state[i][j]!=containerFrameState[i][j] do configurationChanged=true
            )
            if configurationChanged do (containerScan=true;containerCachedFrames=this.containerFrames())
            local frames=containerCachedFrames
            local candidates=if frames.count==0 then #() else if containerScan then (geometry as array) else containerPending as array
            if containerScan and frames.count>0 do containerScans+=1
            local excluded=#()
            if candidates.count>0 do for controller in objects where classof controller.baseObject==AminScatterObject do (
                join excluded (controller.baseObject.validSurfaces())
                for leaf in controller.baseObject.layerObjects do join excluded (leaf.bakedNodes as array)
            )
            for node in candidates where findItem sources node==0 do (
                containerTests+=1
                if this.containerContains node frames and this.containerEligible node excluded do changed=(this.containerRegister node) or changed
            )
            local membershipChanged=configurationChanged or sources.count!=containerTrackedSources.count or sources.count!=containerActive.count
            if not membershipChanged do for i=1 to sources.count while not membershipChanged do (
                local node=sources[i],pivot=if isValidNode node then node.transform.row4 else undefined
                if node!=containerTrackedSources[i] or pivot!=containerTrackedPivots[i] do membershipChanged=true
            )
            if membershipChanged do (
                containerActive=for i=1 to sources.count collect (this.isEmptySource i or this.containerContains sources[i] frames)
                containerTrackedSources=sources as array
                containerTrackedPivots=for node in sources collect (if isValidNode node then node.transform.row4 else undefined)
                containerMembershipBuilds+=1
            )
            containerConfigKey="ready";containerFrameState=state;containerPending=#();containerScan=false
            local membership=stringStream ""
            with printAllElements on format "%" containerActive to:membership
            local nextMembership=membership as string
            if nextMembership!=containerMembershipKey or changed do containerUIChanged=true
            containerMembershipKey=nextMembership
            containerReconciling=false;if membershipChanged or changed do CyrusContainerRefreshAll();changed
        )catch(containerReconciling=false;throw())
    )
    fn containerFilter rows plants = (
        if this.containerProvider()==undefined do return rows
        if plants.count==0 do return rows
        local keep=for node in plants collect (
            local i=this.sourceRow node
            i>0 and i<=containerActive.count and containerActive[i]
        )
        this.filterSourceRowsByPolicy rows keep
    )
    fn containerNote event nodes = (
        local interested=false
        for leaf in layerObjects where leaf.containerProvider()!=undefined do (
            -- Deletion payloads may no longer resolve to nodes. Keep the
            -- existing conservative reconciliation for genuine deletions; the
            -- dispatcher already filters our known deleted helper handles.
            local relevant=event==#deleted,frames=undefined,rectangles=leaf.effectiveContainers()
            if relevant do leaf.containerScan=true
            for rectangle in rectangles where isValidNode rectangle do (
                local parent=rectangle
                while isValidNode parent and not relevant do (
                    if findItem nodes parent>0 do relevant=true
                    parent=parent.parent
                )
            )
            -- A moved parent may carry previously unregistered children into a
            -- rectangle. Traverse only this changed subtree, never every frame.
            -- Keep callback work bounded. A large changed subtree requests one
            -- conservative scan during normal reconciliation, not in this hook.
            -- A new array also avoids appending children to the caller's batch.
            local pending=(for i=1 to (amin nodes.count 512) collect nodes[i]),index=1
            if nodes.count>512 do (leaf.containerScan=true;relevant=true)
            while index<=pending.count do (
                local node=pending[index];index+=1
                if isValidNode node do (
                    local generated=classof node.baseObject==AminScatterObject or classof node.baseObject==CyrusPointDisplay or classof node.baseObject==CyrusSourceContainer or getUserProp node "CyrusPFTransient"==true
                    if not generated do (
                        if findItem leaf.sources node>0 then relevant=true
                        else if superclassof node==GeometryClass and not isGroupHead node do (
                            -- An unrelated helper or a model outside the pool
                            -- must not mark every container-backed layer dirty.
                            try (
                                if frames==undefined do frames=leaf.containerFrames()
                                if leaf.containerContains node frames do (appendIfUnique leaf.containerPending node;relevant=true)
                            )catch(relevant=true)
                        )
                    )
                    for child in node.children while pending.count<512 do appendIfUnique pending child
                    if pending.count>=512 do (leaf.containerScan=true;relevant=true)
                )
            )
            if relevant do (leaf.markInputDirty();interested=true)
            CyrusDiagnosticEmit "container.notification" "host_callback" leaf.layerID leaf.procEpoch (if relevant then "reconcile_needed" else "unrelated")
        )
        interested
    )
    fn procStageDependencyHandles = (
        local inputs=this.validSurfaces(),handles=#()
        join inputs (sources as array);join inputs (areaNodes as array);join inputs (patternLines as array)
        join inputs #(analyzerNode,areaAnalyzer,fallAnalyzer)
        if orientationMode==3 and isValidNode orientationTarget do appendIfUnique inputs orientationTarget
        for input in inputs where isValidNode input do (
            local dep=input
            while isValidNode dep do (
                local handle=getHandleByAnim dep
                if findItem handles handle>0 then exit
                append handles handle;dep=dep.parent
            )
        )
        handles
    )
    fn procExternalChanged event nodes deletedHandles:undefined = (
        local inputs=this.validSurfaces(),affected=false
        local staging=this.containerProvider()!=undefined and findItem #(#controllerOtherEvent,#controllerStructured,#linkChanged) event>0
        if not staging then join inputs (sources as array)
        else for source in sources where isValidNode source and (source.modifiers.count>0 or cyrusSourceWorldDependent source) do appendIfUnique inputs source
        join inputs (areaNodes as array);join inputs (patternLines as array)
        join inputs #(analyzerNode,areaAnalyzer,fallAnalyzer)
        for input in inputs where isValidNode input do (
            local dep=input
            while isValidNode dep and not affected do (
                if findItem nodes dep>0 do affected=true
                dep=dep.parent
            )
        )
        if event==#deleted do (
            -- Direct callers without the original handles remain conservative.
            -- New/pending dependencies are already dirty; published dependencies
            -- survive failed successors until a complete replacement commits.
            if deletedHandles==undefined then affected=true
            else for handle in deletedHandles while not affected do if findItem procDependencyHandles handle>0 do affected=true
        )
        local targetAffected=false
        if not affected and orientationMode==3 and isValidNode orientationTarget do (
            local dep=orientationTarget
            while isValidNode dep and not targetAffected do (if findItem nodes dep>0 do targetAffected=true;dep=dep.parent)
            -- Key/controller changes can leave today's pivot unchanged while
            -- making future frames animated. Re-arm only transform validity;
            -- an unchanged pivot still does not dirty candidate/placement data.
            if targetAffected do (orientationTimeValidity=undefined;this.orientationTimeKey())
            if targetAffected and orientationTargetObserved!=undefined do (
                if orientationTargetObserved[1]==getHandleByAnim orientationTarget and orientationTargetObserved[2]==orientationTarget.transform.row4 do targetAffected=false
            )
        )
        if affected then (CyrusInvalidateMeshMaskPreview this;procGeometryRevision+=1;markInputDirty())
        else if targetAffected do markInputDirty()
        CyrusDiagnosticEmit "input.classified" "host_callback" layerID procEpoch (if affected then "geometry_dependency" else if targetAffected then "orientation_target" else "unrelated") correlation:(if affected or targetAffected then diagnosticCauseID else 0L)
        affected or targetAffected
    )
    fn containerSetMode mode = (CyrusRequireAuthor();
        if mode<1 or mode>4 do throw "Unknown source-container mode."
        undo "Cyrus source pool" on containerMode=mode
        containerScan=true;containerConfigKey="";markInputDirty()
        local root=this.containerRoot();root.invalidateGroups();CyrusContainerRefreshAll();root.bindNativeUI()
    )
    fn containerAdd node globalPool:false = (CyrusRequireAuthor();
        if not CyrusSourceContainerFilter node do throw "Pick a Cyrus container or an unmodified square-corner Rectangle."
        local target=if globalPool then this.containerRoot() else this,key=if globalPool then #containerGlobalNodes else #containerNodes
        local nodes=(getProperty target key) as array
        if findItem nodes node==0 and nodes.count>=32 do throw "A source pool supports at most 32 containers."
        undo "Cyrus add source container" on (
            if classof node.baseObject==Rectangle do (
                local original=node
                node=CyrusSourceContainer name:(uniqueName (original.name+" Sources ")) width:original.width length:original.length
                node.transform=original.objectTransform
                local controller=this.containerRoot(),consumer=if globalPool then controller.selectedLayer() else this
                if controller.layerID=="" do controller.layerID=CyrusNewLayerID()
                node.contextRootID=controller.layerID;node.contextSetID=if consumer==undefined then "" else consumer.layerID
            )
            if not globalPool do this.containerMode=4
            if findItem nodes node==0 do (append nodes node;setProperty target key nodes)
        )
        local root=this.containerRoot();root.invalidateGroups();CyrusContainerRefreshAll();root.bindNativeUI();true
    )
    fn containerRemove index globalPool:false = (CyrusRequireAuthor();
        local target=if globalPool then this.containerRoot() else this,key=if globalPool then #containerGlobalNodes else #containerNodes
        local nodes=(getProperty target key) as array
        if index>0 and index<=nodes.count do undo "Cyrus remove source container" on (deleteItem nodes index;setProperty target key nodes)
        local root=this.containerRoot();root.invalidateGroups();CyrusContainerRefreshAll();root.bindNativeUI()
    )
    fn containerCreate globalPool:false = (CyrusRequireAuthor();
        local root=this.containerRoot(),label=if globalPool then "Global sources" else root.layerCaption (root.logicalParent this),node
        undo "Cyrus create source container" on (
            node=CyrusSourceContainer name:(uniqueName ("CS Sources - "+label+" ")) width:500 length:300
            local receivers=root.validSurfaces()
            if receivers.count>0 do (local bounds=nodeGetBoundingBox receivers[1] (matrix3 1);node.pos=[bounds[2].x+350,bounds[1].y,0])
            if root.layerID=="" do root.layerID=CyrusNewLayerID()
            local consumer=if globalPool then root.selectedLayer() else this
            node.contextRootID=root.layerID;node.contextSetID=if consumer==undefined then "" else consumer.layerID
            if not globalPool do this.containerMode=4
            this.containerAdd node globalPool:globalPool
        )
        node
    )

    fn procInputKey = (
        local stream=stringStream ""
        with printAllElements on (
            format "Proc1:%:%:%:%:%:%:%:%|" (this.inputTimeKey()) 0 procManualRevision cyrusEnabled layerEnabled (this.procEditKey()) procRuleScope procRuleA to:stream
            format "%:%:%:%:%|" procRuleB procRuleEnabled procRuleMultiplier procRuleGapWU procRulePlanar to:stream
            for parent in this.logicalLayers() do for leaf in this.layerSets parent do (
                leaf.containerRefresh()
                format "Membership:%|Filter:%|Orientation:%|" leaf.containerMembershipKey (leaf.surfaceFilterKey()) (leaf.orientationKey()) to:stream
                format "Texture:%|" (leaf.procWatchDensity()) to:stream
                format "%:%:%:%:%:%|" leaf.layerID leaf.logicalParentID leaf.procReceiverID leaf.procRadiusBinding (leaf.paintBaseInputKey (leaf.validSources()) true) (leaf.procCoverageKey()) to:stream
                for key in #(#procOrder,#procSetOrder,#procSamplingSalt,#procPopulation,#procAttemptFactor,#procRounds,#procRepair,#procSelfOverride,#procSelfEnabled,#procSelfMultiplier,#procSelfGap,#procSelfPlanar,#procLayerSelfEnabled,#procLayerSelfMultiplier,#procLayerSelfGap,#procLayerSelfPlanar,#procSiblingEnabled,#procSiblingMultiplier,#procSiblingGap,#procSiblingPlanar,#procRadiusIDs,#procRadiusModes,#procRadiusValues,#procRadiusDistances,#procSourceIDs,#sourceRadiiWU,#sourceAutoRadius,#sourceFollowScale,#finalCleanup,#finalNeighborRadius,#finalMinNeighbors,#finalMinIsland,#cleanupPlanar) where leaf.placementMode==1 or findItem #(#procPopulation,#procAttemptFactor,#procRounds,#procRepair) key==0 do format "%:%|" key (getProperty leaf key) to:stream
                for key in CyrusClearanceFields do format "%:%|" key (getProperty leaf key) to:stream
            )
        )
        stream as string
    )
    fn procQuota = (
        local parent=overlapOwner.logicalParent this,budget=parent.amount
        if parent.populationMode==2 do (
            local meters=units.decodeValue "1m",wanted=(aminScatterSurfaceArea (this.validSurfaces()))/(meters*meters)*parent.plantsPerM2
            densityCapped=wanted>1000000;budget=(amin 1000000 (floor(wanted+0.5))) as integer
        )
        (overlapOwner.populationAllocation this countOverride:budget)[1]
    )
    fn procFieldKey = (
        -- Receiver planning samples actual selected channel values only during
        -- a relevant successor calculation. Record that bounded field proof in
        -- raw/prepared caches without evaluating meshes from passive key reads.
        if not meshMaskEnabled and not this.requiresReceiverMap() do return ""
        local stream=stringStream ""
        format "ReceiverFields:" to:stream
        for entry in procReceiverGeometry do format "%:%:%|" entry[1] entry[4] entry[3] to:stream
        stream as string
    )
    fn procPreparationKey pool plants = (
        (this.paintBaseInputKey plants true)+"|Texture:"+(this.procWatchDensity() as string)+"|Pool:"+(pool as string)+"|"+(this.procCoverageKey())+"|"+(overlapOwner.procEditKey())+"|Filter:"+(this.surfaceFilterKey())+"|"+(this.orientationKey())+"|Native:1"+(this.procFieldKey())
    )
    fn procPrepare pool plants = (
        this.procNativeSources plants
        local key=this.procPreparationKey pool plants
        if key==procPreparedKey do (CyrusDiagnosticEmit "prepare.reused" "engine" layerID procEpoch "key_match" correlation:diagnosticCauseID;procPreparedHits+=1;return procPreparedRows)
        CyrusDiagnosticEmit "prepare.started" "engine" layerID procEpoch "key_changed" correlation:diagnosticCauseID
        local rows
        procCandidateCount=pool
        try(rows=this.cspImpl_placements plants previewOnly:true rawOnly:true)catch(procCandidateCount=undefined;throw())
        procCandidateCount=undefined
        if orientationMode==1 and diversityMode==4 and (borderFaceOut or streetFaceOut or (findItem strokeSides 7>0)) and rows.count>0 do (
            local forward=if plants.count==0 then #(1) else for n in plants collect sourceForward (sourceRow n)
            local offsets=if plants.count==0 then #(0.0) else for n in plants collect sourceZOffset (sourceRow n)
            rows=cyrusOrientRows rows (this.lineInputs plants previewOnly:true) forward offsets
        )
        procBindingKey=this.procSourceEditBinding plants rows
        rows=CyrusEditApplyLayer overlapOwner this rows
        CyrusNativeWorkingSetCheckpoint()
        rows=this.applySurfaceFilter rows
        rows=cyrusPlacementSealPrepared rows key procBindingKey
        procPreparedRows=rows;procPreparedKey=key;procPreparedBuilds+=1
        rows
    )
    fn procAssertSchema = (
        local message="This development scene does not use the current schema 62. Create a new Cyrus 0.87.4 setup; earlier schemas are unsupported."
        if this.needsClearanceUpgrade() do throw "This scene needs the clearance upgrade. Use Upgrade scene in the Cyrus panel; Undo restores the previous state."
        if not procSchemaValid do throw message
        for leaf in layerObjects where not leaf.procSchemaValid do throw message
        true
    )
    fn procValidateNativeRoute = (
        -- Capability validation precedes any scene or publication mutation.
        if cyrusInteractionVersion==undefined or cyrusInteractionVersion()!=8 or cyrusInteractionStageFrom==undefined or cyrusInteractionRestage==undefined or cyrusInteractionReviewModel==undefined or cyrusInteractionSourcesFresh==undefined or cyrusInteractionBake==undefined do throw "Cyrus 0.87.4 requires its revised matched native interaction modules. Restart Max with the complete package."
        if cyrusEditVersion==undefined or cyrusEditVersion()!=2 or cyrusSourceEditBinding==undefined or cyrusSourceRadiusBind==undefined or cyrusSourceRadiusEdit==undefined or cyrusEditPublishPresentation==undefined or cyrusEditRecolor==undefined or cyrusEditHydrateSources==undefined do throw "Cyrus 0.87.4 requires its matching source-aware Edit modules. Restart Max with the complete package."
