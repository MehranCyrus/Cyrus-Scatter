        pickbutton pickAnalyzer "Pick Surface Analyzer" filter:CyrusAnalyzerFilter pos:[4,192] width:(diversityUI_1.width-8)
        pickbutton pickPath "Add: pick closed line" filter:AminScatterAreaFilter pos:[4,192] width:(diversityUI_1.width-8)
        button removePath "Remove path" pos:[4,218] width:(diversityUI_1.width-8)
        listbox strokesList "Consecutive strokes" items:#() pos:[4,250] width:(diversityUI_1.width-8) height:4
        button addOutside "Add Outside" pos:[4,346] width:((diversityUI_1.width-12)/2)
        button addInside "Add Inside" pos:[(if boundaryOnly then 4 else diversityUI_1.width/2+2),346] width:(if boundaryOnly then diversityUI_1.width-8 else (diversityUI_1.width-12)/2)
        button removeStrokeButton "Remove Stroke" pos:[4,372] width:(diversityUI_1.width-8)
        spinner strokeWidth "Width:" range:[0.001,100000,1] type:#worldUnits pos:[4,406] width:(diversityUI_1.width-8) fieldWidth:64
        radiobuttons strokeMode "Assign by" labels:#("Color groups","Source objects") columns:1 pos:[4,434] width:(diversityUI_1.width-8)
        multiListBox strokeChoices "Ctrl / Shift: select several" items:#() pos:[4,506] width:(diversityUI_1.width-8) height:5
        spinner strokeScaleMin "Scale min:" range:[0.001,100,1] pos:[4,618] width:(diversityUI_1.width-8) fieldWidth:58
        spinner strokeScaleMax "Scale max:" range:[0.001,100,1] pos:[4,644] width:(diversityUI_1.width-8) fieldWidth:58
        button refreshGroups "Refresh sources / groups" pos:[4,676] width:(diversityUI_1.width-8)
        label strokeHelp "Outside strokes: empty." pos:[4,704] width:(diversityUI_1.width-8)
        spinner edgeOffsetSpin "Offset inward:" range:[-1000000,1000000,0] type:#worldunits pos:[4,814] width:(diversityUI_1.width-8) fieldWidth:52
        spinner edgeAlongSpin "Jitter along:" range:[0,1000000,0] type:#worldunits pos:[4,842] width:(diversityUI_1.width-8) fieldWidth:52
        spinner edgeAcrossSpin "Jitter across:" range:[0,1000000,0] type:#worldunits pos:[4,870] width:(diversityUI_1.width-8) fieldWidth:52
        label edgeRowHelp "Spacing sets count. Jitter 0 = exact." pos:[4,898] width:(diversityUI_1.width-8) height:36
        checkbox keepCornerCheck "Keep corner points" pos:[4,940] width:(diversityUI_1.width-8)
        spinner cornerAngleSpin "Min turn:" range:[0,180,45] type:#float pos:[4,968] width:(diversityUI_1.width-8) fieldWidth:52
        spinner cornerCountSpin "Points/corner:" range:[1,64,1] type:#integer pos:[4,996] width:(diversityUI_1.width-8) fieldWidth:52
        label cornerHelp "Turn angle in degrees. 0 = straight." pos:[4,1024] width:(diversityUI_1.width-8) height:36
        spinner edgeRotXSpin "Local X (deg):" range:[-36000,36000,0] type:#float pos:[4,1066] width:(diversityUI_1.width-8) fieldWidth:52
        spinner edgeRotYSpin "Local Y (deg):" range:[-36000,36000,0] type:#float pos:[4,1094] width:(diversityUI_1.width-8) fieldWidth:52
        spinner edgeRotZSpin "Local Z (deg):" range:[-36000,36000,0] type:#float pos:[4,1122] width:(diversityUI_1.width-8) fieldWidth:52
