                setsUI_targetList_caption.pos=[6+(mod 0 columns)*(cellWidth+4),y+(floor (0/columns))*rowHeight];setsUI_targetList_caption.width=cellWidth;setsUI_targetList_caption.enabled=setsUI_targetList.enabled
