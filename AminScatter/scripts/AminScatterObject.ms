        button resetRotation "Reset rotation" pos:[4,124] width:(randomUI_1.width-8) height:20
        button resetScale "Reset XYZ scale" pos:[4,278] width:(randomUI_1.width-8) height:20
        button resetWholeScale "Reset whole scale" pos:[4,382] width:(randomUI_1.width-8) height:20
        button resetMovement "Reset movement" pos:[4,536] width:(randomUI_1.width-8) height:20
        fn resetBoundRandomization kind = (
