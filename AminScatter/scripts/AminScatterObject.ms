            if CyrusFalloffGraph!=undefined do try(destroyDialog CyrusFalloffGraph)catch()
            local rows=areaUI_areaList.selection as array
            undo "Cyrus Scatter remove areas" on (
                areaUI_obj.ensureAreaFalloffs()
                for i=rows.count to 1 by -1 do (deleteItem areaUI_obj.areaNodes rows[i];deleteItem areaUI_obj.areaModes rows[i];deleteItem areaUI_obj.areaFallConfigs rows[i];deleteItem areaUI_obj.areaFallScaleGraphs rows[i];deleteItem areaUI_obj.areaFallDensityGraphs rows[i])
            )
