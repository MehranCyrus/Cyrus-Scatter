            )
            local metres=(units.decodeValue "1m") as double
            for rule in (CyrusRecipeGet document "spacingRelationships") do root.procSetPair (CyrusRecipeGet rule "scope") (CyrusRecipeResolve endpoints (CyrusRecipeGet rule "a")) (CyrusRecipeResolve endpoints (CyrusRecipeGet rule "b")) (CyrusRecipeGet rule "enabled") (CyrusRecipeGet rule "multiplier") ((CyrusRecipeGet rule "gap")*metres) (CyrusRecipeGet rule "planar")
            root.activeLayer=findItem root.layerObjects imported[1]
            root.setLayerTransfer false;root.procValidate()
            if calculate do (
                -- Ready Load succeeds only after its first complete calculation.
                -- Keep that work inside this hold so a late failure rolls back
                -- assets, authored layers and the previous publication together.
                -- Calling the engine directly preserves its exceptions; the
                -- ordinary interactive refresh records errors in diagnostics.
                root.evaluateProcedural()
                root.procEnsureDisplay()
            )
        )
        theHold.Accept "Cyrus import recipe";committed=true
    )catch(
        local failure=getCurrentException()
        theHold.Cancel();CyrusPointSuspended=oldSuspended
        if newSetup and isValidNode createdNode do delete createdNode
        throw()
    )
    CyrusPointSuspended=oldSuspended
    if committed do (
        if not calculate do for owner in imported do owner.markInputDirty()
        root.bindNativeUI();CyrusViewportRedraw()
    )
    #(root,imported,node)
)

fn CyrusRecipeDirectory = (
    (CyrusSharedStore()).RecipeDirectory
)
fn CyrusRecipeViewPreferences = (pathConfig.appendPath (getDir #plugcfg) "CyrusScatter-Gallery.ini")
fn CyrusRecipeBundledDirectory version = (
    if not doesFileExist (pathConfig.appendPath CyrusRecipeScriptDirectory "LibraryBinding.txt") do return pathConfig.appendPath CyrusRecipeScriptDirectory ("Library-"+version)
    dotNet.loadAssembly (pathConfig.appendPath CyrusRecipeScriptDirectory "CyrusGallery.dll")
    local shared=(dotNetClass "Cyrus.Content.LibraryLocation").ResolveRoot CyrusRecipeScriptDirectory ((maxVersion())[1]/1000+1998)
    if shared!="" then shared else pathConfig.appendPath CyrusRecipeScriptDirectory ("Library-"+version)
)
fn CyrusRecipeSuggestBindings root document = (
    local bindings=#()
    for role in (CyrusRecipeGet document "roles") do (
        local kind=CyrusRecipeGet role "kind",label=CyrusRecipeGet role "name",candidates=#()
        case kind of (
            "node":(candidates=for node in objects where node.name==label and classof node.baseObject!=AminScatterObject collect node)
            "layer":(for i=1 to root.layerObjects.count where root.layerNames[i]==label do append candidates root.layerObjects[i])
            "texture":(for owner in (join #(root) (root.layerObjects as array)) where owner.densityMap!=undefined and owner.densityMap.name==label do appendIfUnique candidates owner.densityMap)
        )
        append bindings #((CyrusRecipeGet role "id"),(if candidates.count==1 then candidates[1] else undefined))
    )
    bindings
)
fn CyrusRecipeIsBundled path version = (
    local io=dotNetClass "System.IO.Path",file=toLower (io.GetFullPath path),bundle=toLower (io.GetFullPath (CyrusRecipeBundledDirectory version))
    matchPattern file pattern:(bundle+"\\*")
)
fn CyrusRecipeEditDetails path expected version = (
    CyrusRequireAuthor()
    if CyrusRecipeIsBundled path version do throw "Bundled examples are read-only. Save a copy in My recipes first."
    local summary=cyrusRecipeInfo path
    if summary[11]!=expected do throw "Recipe changed. Refresh the library before editing its details."
    local saved=cyrusRecipeReadMetadata path,presentation=CyrusRecipeGet saved "presentation"
    local imagePath=if summary[12] then cyrusRecipeThumbnail path else "",capture=if presentation==undefined then undefined else CyrusRecipeGet presentation "capture"
    if CyrusRecipeDetailEditor!=undefined do try(destroyDialog CyrusRecipeDetailEditor)catch()
    rollout editor "Edit saved recipe details" width:430 height:370 (
        local path="",expected="",imagePath="",capture=undefined
        label identity "" pos:[12,10] width:406 height:40
        edittext savedName "Name:" pos:[12,56] width:406
        edittext savedCategory "Category:" pos:[12,88] width:406
        edittext savedTags "Tags:" pos:[12,120] width:406
        edittext savedDescription "Description:" pos:[12,152] width:406 height:76
        label note "Changes only the saved name/tags/description. Layer settings, Paint and scene objects are retained." pos:[12,238] width:406 height:44
        button commitDetails "Save details" pos:[12,288] width:196
        button closeDetails "Close" pos:[220,288] width:198
        label detailStatus "" pos:[12,322] width:406 height:40
        on editor open do (
            local data=CyrusRecipeDetailOpenData,summary=data[3]
            path=data[1];expected=data[2];imagePath=data[4];capture=data[5]
            identity.text=filenameFromPath path+" | revision "+((summary[15] as integer) as string)
            savedName.text=summary[1];savedCategory.text=summary[5];savedDescription.text=summary[7]
            local tags="";for tag in summary[6] do tags+=(if tags=="" then tag else ", "+tag)
            savedTags.text=tags
        )
        on commitDetails pressed do try (
            if CyrusPresetReviseEditor!=undefined do throw "Wait for the current preset revision to finish before saving details again."
            local tags=#()
            for value in filterString savedTags.text "," do (local tag=trimRight (trimLeft value);if tag!="" do appendIfUnique tags tag)
            local metadata=CyrusRecipeObject #(#("category",trimRight (trimLeft savedCategory.text)),#("tags",tags),#("description",savedDescription.text))
            local previous=expected
            local store=CyrusSharedStore(),ticket=store.BeginSave path expected (filenameFromPath path)
            try (
                cyrusRecipeEntryWrite ticket.RecipePath (CyrusRecipeObject #(#("name",trimRight (trimLeft savedName.text)))) metadata imagePath capture expected true
                local job=CyrusSharedSaveJob store:store ticket:ticket managed:(store.PublishMetadata ticket previous)
                CyrusSharedQueue job;CyrusSharedWatchSave job
                commitDetails.enabled=false
                detailStatus.text="Saving details; model and texture files are reused. Refresh after completion."
            )catch(store.Discard ticket;throw())
        )catch(detailStatus.text=getCurrentException())
        on closeDetails pressed do destroyDialog editor
        on editor close do CyrusRecipeDetailEditor=undefined
    )
    CyrusRecipeDetailOpenData=#(path,expected,summary,imagePath,capture);CyrusRecipeDetailEditor=editor
    createDialog editor style:#(#style_titlebar,#style_sysmenu,#style_toolwindow)
    true
)

global CyrusRecipeSaveEditor,CyrusRecipeSaveOpenData,CyrusOpenRecipeSave,CyrusRecipeLoadEditor,CyrusRecipeLoadOpenData,CyrusOpenRecipeLoad
fn CyrusOpenRecipeSave root directory path:"" expected:"" = (
    local node=CyrusRecipeOwnerNode root
    CyrusRecipeCheckRoot root node
    CyrusRequireAuthor()
    if path!="" and (cyrusRecipeInfo path)[11]!=expected do throw "Recipe changed. Refresh before updating it."
    if path!="" and CyrusRecipeIsBundled path (root.uiVersion()) do throw "Bundled examples are read-only. Save a copy in My recipes."
    if CyrusRecipeSaveEditor!=undefined do try(destroyDialog CyrusRecipeSaveEditor)catch()
    rollout editor "Save planting recipe" width:440 height:590 (
        local root,node,owners=#(),directory="",reviewPath="",reviewHash="",thumbnailFile="",thumbnailCapture=undefined,ownedCapture="",captureBindings=#()
        label title "Save selected layers, their settings and Paint" pos:[12,12] width:416
        multiListBox saveLayers "Layers - evaluation order" pos:[12,38] width:416 height:5
        edittext recipeName "Name:" pos:[12,142] width:416
        edittext recipeCategory "Collection:" pos:[12,173] width:416
        edittext recipeTags "Tags:" pos:[12,204] width:416 tooltip:"Separate tags with commas."
        edittext recipeDescription "Description:" pos:[12,235] width:416 height:66
        button chooseThumbnail "Use PNG thumbnail..." pos:[12,314] width:280
        button clearThumbnail "Clear" pos:[304,314] width:124
        button captureThumbnail "Capture viewport" pos:[12,348] width:202 tooltip:"Capture published plants without recalculating. Update pending settings first."
        button updateCapture "Update + capture" pos:[226,348] width:202 tooltip:"Explicitly update the Scatter setup, then capture the active viewport."
        label thumbnailInfo "Optional PNG, up to 1024 px and 2 MiB" pos:[12,384] width:416 height:40
        label saveNote "Complete settings and Paint are saved. Include assets for a preset that loads without model picking." pos:[12,429] width:416 height:28
        checkbox readyPreset "Include models, materials, terrain and paths" pos:[12,461] width:416 checked:true tooltip:"Save a ready-to-use preset. Static supported assets are packaged with complete Paint. Uncheck for a settings-only recipe with external bindings."
        button saveRecipe "Save new copy" pos:[12,482] width:132
        button updateRecipe "Update selected" pos:[154,482] width:132 enabled:false
        button closeButton "Close" pos:[296,482] width:132
        label status "" pos:[12,524] width:416 height:56
        fn validRoot = (CyrusRecipeCheckRoot root node)
        fn captureSelection = (
            validRoot();local selected=for i in saveLayers.selection where i<=owners.count collect owners[i]
            captureBindings=#()
            CyrusRecipeCapture root selected (trimRight (trimLeft recipeName.text)) bindingResult:captureBindings
        )
        fn metadataValues = (
            local tags=#()
            for value in filterString recipeTags.text "," do (
                local tag=trimRight (trimLeft value)
                if tag!="" do appendIfUnique tags tag
            )
            CyrusRecipeObject #(#("category",trimRight (trimLeft recipeCategory.text)),#("tags",tags),#("description",recipeDescription.text))
        )
        fn capturePreview updateFirst = (
            validRoot();local selected=for i in saveLayers.selection where i<=owners.count collect owners[i]
            if selected.count==0 do throw "Select layers to capture."
            if updateFirst do root.refreshAll()
            if root.groupSnapshotKey=="" or root.groupSnapshotKey!=root.procInputKey() do throw "Settings are pending. Use Update + capture, or Update scatter first."
            if node.isHidden do throw "Show this Scatter setup before capturing its viewport preview."
            local published=#()
            for owner in selected do (
                local index=findItem root.procPublishedOwners owner,slot=findItem root.layerObjects owner
                if index==0 or index>root.groupSnapshotRows.count do throw "A selected layer has no published result. Update first."
                if not (root.enabledLayer slot) or not (root.visibleLayer slot) do throw "Enable and show all selected layers before capturing."
                append published root.groupSnapshotRows[index]
            )
            if (for rows in published where rows.count>0 collect rows).count==0 do throw "The selected layers contain no published plants."
            local data=captureSelection(),authored=cyrusRecipeContentFingerprint data,publishedHash=cyrusRecipePublicationFingerprint published
            local viewportImage=undefined,small=undefined,newPath=pathConfig.appendPath (getDir #temp) ("CyrusCapture-"+CyrusNewLayerID()+".png")
            try (
                completeRedraw()
                viewportImage=viewport.getViewportDib captureAlpha:false gammaCorrect:true
                local ratio=amin 1.0 (512.0/(amax viewportImage.width viewportImage.height))
                small=bitmap (amax 1 ((viewportImage.width*ratio) as integer)) (amax 1 ((viewportImage.height*ratio) as integer)) filename:newPath
                copy viewportImage small
                if not (save small) do throw "Could not save the captured thumbnail."
                close small;small=undefined;close viewportImage;viewportImage=undefined
                if cyrusRecipeContentFingerprint (captureSelection())!=authored do throw "Settings changed while capturing. Capture again."
                if ownedCapture!="" do deleteFile ownedCapture
                ownedCapture=newPath;thumbnailFile=newPath
                thumbnailCapture=CyrusRecipeObject #(#("method","viewport-published"),#("authoredSHA256",authored),#("publicationSHA256",publishedHash),#("view",((viewport.getType()) as string)+" | "+((viewport.getTM()) as string)),#("capturedUTC",((dotNetClass "System.DateTime").UtcNow.ToString "o")))
                thumbnailInfo.text="Captured current viewport; Save to attach it."
                status.text="Captured published plants. Camera, selection and rendering settings were retained."
            )catch(
                if small!=undefined do close small
                if viewportImage!=undefined do close viewportImage
                if doesFileExist newPath do deleteFile newPath
                throw()
            )
        )

        fn saveEntry updating = (
            validRoot()
            if updating and (reviewPath=="" or reviewHash=="") do throw "Choose a saved recipe to update."
            local data=captureSelection()
            local job=CyrusSharedBeginSave root data (metadataValues()) thumbnailFile thumbnailCapture (if updating then reviewPath else "") (if updating then reviewHash else "") readyPreset.checked captureBindings
            status.text="Saving to the shared library. Unchanged models and textures will be reused."
            CyrusSharedWatchSave job
            job.path
        )
        on editor open do (
            root=CyrusRecipeSaveOpenData[1];node=CyrusRecipeSaveOpenData[2];directory=CyrusRecipeSaveOpenData[3]
            reviewPath=CyrusRecipeSaveOpenData[4];reviewHash=CyrusRecipeSaveOpenData[5]
            owners=root.logicalLayers();saveLayers.items=for owner in owners collect root.layerCaption owner
            saveLayers.selection=if owners.count>0 then #{1..owners.count} else #{};recipeName.text="Planting setup"
            updateRecipe.enabled=reviewPath!=""
            if reviewPath!="" do (
                local info=cyrusRecipeInfo reviewPath,document=cyrusRecipeReadMetadata reviewPath,presentation=CyrusRecipeGet document "presentation"
                recipeName.text=info[1];recipeCategory.text=info[5];recipeDescription.text=info[7]
                local tags="";for value in info[6] do tags+=(if tags=="" then value else ", "+value)
                recipeTags.text=tags
                if info[12] do (thumbnailFile=cyrusRecipeThumbnail reviewPath;thumbnailInfo.text="Existing preview. Capture again if the scene settings changed.")
                if presentation!=undefined do thumbnailCapture=CyrusRecipeGet presentation "capture"
            )
        )
        on saveRecipe pressed do try(saveEntry false)catch(status.text=getCurrentException())
        on updateRecipe pressed do try(saveEntry true)catch(status.text=getCurrentException())
        on captureThumbnail pressed do try(capturePreview false)catch(status.text=getCurrentException())
        on updateCapture pressed do try(capturePreview true)catch(status.text=getCurrentException())
        on chooseThumbnail pressed do (
            local path=getOpenFileName caption:"Choose an actual preset preview" types:"PNG image (*.png)|*.png|"
            if path!=undefined do (thumbnailFile=path;thumbnailCapture=undefined;thumbnailInfo.text="External PNG: "+filenameFromPath path)
        )
        on clearThumbnail pressed do (thumbnailFile="";thumbnailCapture=undefined;thumbnailInfo.text="No thumbnail")
        on closeButton pressed do destroyDialog editor
        on editor close do (if ownedCapture!="" do deleteFile ownedCapture;CyrusRecipeSaveEditor=undefined)
    )
    CyrusRecipeSaveOpenData=#(root,node,directory,path,expected);CyrusRecipeSaveEditor=editor
    createDialog editor style:#(#style_titlebar,#style_sysmenu,#style_toolwindow)
    true
)
fn CyrusOpenRecipeLoad root path expected = (
    local node=CyrusRecipeOwnerNode root
    CyrusRecipeCheckRoot root node
    if (cyrusRecipeInfo path)[11]!=expected do throw "Recipe changed. Refresh before loading it."
    local document=cyrusRecipeRead path
    if (cyrusRecipeInfo path)[11]!=expected do throw "Recipe changed while reading. Refresh before loading it."
    if CyrusRecipeLoadEditor!=undefined do try(destroyDialog CyrusRecipeLoadEditor)catch()
    rollout editor "Load planting recipe - review bindings" width:650 height:440 (
        local root,node,document,bindings=#(),layerChoices=#(),bindingControls=false,reviewPath="",reviewHash=""
        label title "" pos:[12,12] width:626 height:42
        button suggestButton "Match unique scene names" pos:[12,62] width:260
        listbox roleList "Terrain and model roles" pos:[12,101] width:626 height:7
        pickbutton bindNode "Pick scene object..." pos:[12,250] width:195 autoDisplay:false
        mapbutton bindMap "Pick texture..." pos:[219,250] width:195
        dropdownlist bindLayer "Layer:" items:#() pos:[426,246] width:212
        checkbox newSetupCheck "New setup" pos:[12,294] width:220
        dropdownlist importVariation items:#("New variation","Saved variation") selection:1 pos:[330,288] width:308
        button importButton "Add layers" pos:[12,328] width:300 enabled:false
        button closeButton "Close" pos:[330,328] width:308
        label status "Review every binding. Paint requires compatible geometry, frame and saved system units." pos:[12,372] width:626 height:56
        fn validRoot = (CyrusRecipeCheckRoot root node)
        fn selectedRole = (local index=roleList.selection;if document==undefined or index<1 or index>bindings.count then 0 else index)
        fn bindControls = (
            bindingControls=true
            local index=selectedRole(),kind=if index==0 then "" else CyrusRecipeGet (CyrusRecipeGet document "roles")[index] "kind"
            bindNode.enabled=kind=="node";bindMap.enabled=kind=="texture";bindLayer.enabled=kind=="layer"
            bindMap.map=if index>0 and kind=="texture" then bindings[index][2] else undefined
            bindingControls=false
        )
        fn showBindings = (
            local selected=roleList.selection,roles=CyrusRecipeGet document "roles"
            roleList.items=for i=1 to roles.count collect ((CyrusRecipeGet roles[i] "name")+" ["+(CyrusRecipeGet roles[i] "kind")+"] -> "+(if bindings[i][2]==undefined then "UNBOUND" else if (CyrusRecipeGet roles[i] "kind")=="layer" then root.layerCaption bindings[i][2] else bindings[i][2].name))
            roleList.selection=if roles.count==0 then 0 else amax 1 (amin roles.count selected)
            layerChoices=root.layerObjects as array;bindLayer.items=root.layerNames as array
            importButton.enabled=true;bindControls()
        )

        on editor open do (
            root=CyrusRecipeLoadOpenData[1];node=CyrusRecipeLoadOpenData[2];reviewPath=CyrusRecipeLoadOpenData[3];reviewHash=CyrusRecipeLoadOpenData[4];document=CyrusRecipeLoadOpenData[5]
            title.text=(CyrusRecipeGet document "name")+" | "+((CyrusRecipeGet document "layers").count as string)+" layers"
            bindings=for role in (CyrusRecipeGet document "roles") collect #((CyrusRecipeGet role "id"),undefined)
            showBindings()
        )
        on suggestButton pressed do try(validRoot();if document==undefined do throw "Review a recipe first.";bindings=CyrusRecipeSuggestBindings root document;showBindings())catch(status.text=getCurrentException())
        on roleList selected i do bindControls()
        on bindNode picked value do try(validRoot();local index=selectedRole();if index>0 do (bindings[index][2]=value;showBindings()))catch(status.text=getCurrentException())
        on bindMap picked value do if not bindingControls do try(validRoot();local index=selectedRole();if index>0 do (bindings[index][2]=value;showBindings()))catch(status.text=getCurrentException())
        on bindLayer selected i do try(validRoot();local index=selectedRole();if index>0 and i>0 and i<=layerChoices.count do (bindings[index][2]=layerChoices[i];showBindings()))catch(status.text=getCurrentException())
        on importButton pressed do try(
            validRoot();if document==undefined do throw "Review a recipe first."
            if (cyrusRecipeInfo reviewPath)[11]!=reviewHash do throw "The saved recipe changed. Close this review and load it again."
            local result=CyrusRecipeImport root document bindings newSetup:newSetupCheck.checked variation:(if importVariation.selection==2 then #same else #new)
            status.text=if result[1].updateMode==1 then "Imported as one Undo. Manual mode: Update scatter to calculate." else "Imported as one Undo. Live follows relevant changes."
        )catch(status.text=getCurrentException())
        on newSetupCheck changed value do importButton.text=if value then "Create new setup" else "Add layers"

        on closeButton pressed do destroyDialog editor
        on editor close do CyrusRecipeLoadEditor=undefined
    )
    CyrusRecipeLoadOpenData=#(root,node,path,expected,document);CyrusRecipeLoadEditor=editor
    createDialog editor style:#(#style_titlebar,#style_sysmenu,#style_toolwindow)
    true
)

-- Selective reuse projects a complete recipe onto explicit setting groups. It
-- never reads Paint payloads, replaces source/receiver arrays, or changes IDs.
global CyrusStylePlan,CyrusStyleFields,CyrusStyleSnapshot,CyrusStyleSettings,CyrusStylePrepare,CyrusStyleCommit,CyrusOpenRecipeStyle,CyrusStyleEditor,CyrusStyleOpenData,CyrusStyleCheckBounds,CyrusStyleCheckCurves,CyrusStyleCheckGraph,CyrusFallUnpack
struct CyrusStylePlan (root,node,owner,ownerID,path,digest,recordID,groups,seedPolicy,values,previous,controllers,inputKey,changed)
fn CyrusStyleCheckBounds owner = (
    local total=0
    for field in CyrusRecipeFields() where matchPattern field[2] pattern:"*tab" do (
        local value=getProperty owner (field[1] as name)
        if value.count>65536 do throw "A destination setting array exceeds the style limit."
        total+=value.count
        if total>262144 do throw "Destination setting arrays exceed the bounded style budget."
    )
    true
)
fn CyrusStyleCheckGraph samples packed multiplier = (
    if packed.count==0 do return true
    -- Evaluate with Max's own curve control, matching the authored graph editor.
    -- This detached hidden control never edits or closes an artist's open graph.
    rollout witness "Cyrus curve validation" width:32 height:32 (
        curveControl graph "" width:32 height:32 numCurves:1 x_range:[0,1] y_range:[0,100] asPopup:false
    )
    try (
        createDialog witness hidden:true
        undo off (
            local curve=witness.graph.curves[1]
            curve.numPoints=packed.count/8
            for i=1 to curve.numPoints do (
                local point=curve.points[i],j=(i-1)*8
                point.value=[packed[j+1],packed[j+2]];point.inTangent=[packed[j+3],packed[j+4]];point.outTangent=[packed[j+5],packed[j+6]]
                point.bezier=packed[j+7]>0;point.corner=packed[j+8]>0
                point.lock_x=(i==1 or i==curve.numPoints);curve.points[i]=point
            )
            for i=0 to 256 do (
                local actual=amax 0.0 ((getValue curve 0 (i/256.0))/100.0)
                if not multiplier do actual=amin 1.0 actual
                local position=i*(samples.count-1)/256.0,lo=(floor position) as integer,hi=amin (samples.count-1) (lo+1)
                local expected=samples[lo+1]+(samples[hi+1]-samples[lo+1])*(position-lo)
                if abs(actual-expected)>0.0001*(amax 1.0 (abs expected)) do throw "Recipe graph handles do not match its sampled curve. Resave it from a valid graph."
            )
        )
        destroyDialog witness
    )catch(try(destroyDialog witness)catch();throw())
    true
)
fn CyrusStyleCheckCurves owner values = (
    for fields in #(#("meshMaskSamples","meshMaskGraph","density_curve",false),#("fallDensityCurve","fallDensityGraph","density_curve",false),#("fallScaleCurve","fallScaleGraph","scale_curve",true)) do (
        local samples=undefined,graph=""
        for pair in values do (if pair[1]==fields[1] do samples=pair[2];if pair[1]==fields[2] do graph=pair[2])
        if samples!=undefined do (
            if samples.count==0 do samples=if fields[1]=="meshMaskSamples" then #(0.0,1.0) else #(1.0,1.0)
            local packed=CyrusFallUnpack graph
            cyrusPresetEncode fields[3] "Recipe style curve" #(samples,packed,fields[4])
            CyrusStyleCheckGraph samples packed fields[4]
        )
    )
    true
)
fn CyrusStyleFields group = (
    case group of (
        "Amount":#("amount","populationMode","plantsPerM2","procPopulation","procAttemptFactor","procRounds","procRepair")
        "Grid layout":#("placementMode","gridColumnWU","gridRowWU","gridOriginXWU","gridOriginYWU","gridHeading","gridJitter")
        "Transforms":(join (for field in cyrusPresetSchema "transforms" collect field[1]) #("orientationTarget"))
        "Slope and altitude":#("slopeEnabled","slopeMinimum","slopeMaximum","slopeLowerFade","slopeUpperFade","altitudeEnabled","altitudeMinimum","altitudeMaximum","altitudeLowerFade","altitudeUpperFade")
        "Surface density":#("meshMaskSource","meshMaskEnabled","meshMaskChannel","meshMaskComponent","meshMaskMinimum","meshMaskMaximum","meshMaskInvert","meshMaskSamples","meshMaskGraph")
        "Density texture":(join #("distributionMode","densityMap","invertDensity","densityUVChannel","densityResolution") (for key in AminScatterImageDensityFields collect key as string))
        "Area falloff":#("fallAnalyzer","fallDelete","fallDeleteWidth","fallScale","fallScaleWidth","fallScaleCurve","fallScaleGraph","fallDensity","fallDensityWidth","fallDensityCurve","fallDensityGraph")
        default:throw "Unsupported style group."
    )
)
fn CyrusStyleSnapshot owner = (
    CyrusStyleCheckBounds owner
    for field in CyrusRecipeFields() collect (
        local value=getProperty owner (field[1] as name)
        if matchPattern field[2] pattern:"*tab" do value=value as array
        value
    )
)
fn CyrusStyleSettings root owner values = (
    CyrusStyleCheckBounds owner
    local context=CyrusRecipeCaptureContext root:root node:(CyrusRecipeOwnerNode root) owners:#(owner) metres:((units.decodeValue "1m") as double),pairs=#()
    for field in CyrusRecipeFields() do (
        local key=field[1],kind=field[2],value=getProperty owner (key as name)
        if key=="procReceiverVariationIDs" do value=CyrusReceiverVariationDomains owner
        for pair in values where pair[1]==key do value=pair[2]
        if matchPattern kind pattern:"*tab" then (
            kind=substring kind 1 (kind.count-3)
            value=for item in value collect (CyrusRecipeCaptureValue context item kind key)
        ) else value=CyrusRecipeCaptureValue context value kind key
        append pairs #(key,value)
    )
    CyrusRecipeObject pairs
)
fn CyrusStylePrepare root owner path digest recordID groups bindings seedPolicy:#current = (
    CyrusRequireAuthor();local node=CyrusRecipeOwnerNode root
    CyrusRecipeCheckRoot root node
    if cyrusRecipeStyleValidate==undefined do throw "Apply Style requires the matching complete Cyrus 0.87.4 package."
    if owner==undefined or owner.isPaintArea or findItem root.layerObjects owner==0 do throw "Choose a current logical destination layer."
    if groups.count==0 do throw "Select at least one setting group."
    if findItem #(#current,#saved,#new) seedPolicy==0 do throw "Choose Keep, Saved or New seeds."
    if CyrusBrushSessionLayer!=undefined do throw "Stop the brush before reviewing a style."
    cyrusRecipeCheckStatic owner
    for edit in root.procModifiers() where cyrusEditRecipeHasData edit do throw "Apply Style currently requires a setup without authored Scatter Edit records. The existing edits are preserved."
    for member in (join #(owner) (owner.paintAreas as array)) where member.procRadiusIDs.count>0 do throw "Apply Style currently requires a destination without per-instance radius overrides. Existing overrides are preserved."
    if owner.interactionCollider or owner.interactionReact or owner.interactionSourceIDs.count>0 or owner.interactionProxySourceIDs.count>0 do throw "Apply Style requires a layer without contact roles, collider links or reviewed contact definitions. The existing setup is preserved."
    if (cyrusRecipeInfo path)[11]!=digest do throw "The recipe changed. Refresh and review it again."
    local document=cyrusRecipeReadMetadata path,record=undefined
    for layer in (CyrusRecipeGet document "layers") where (CyrusRecipeGet layer "id")==recordID do record=layer
    if record==undefined do throw "The saved layer was removed from the recipe."
    local settings=CyrusRecipeGet record "settings",fields=#(),values=#(),controllers=#(),metres=(units.decodeValue "1m") as double,schema=CyrusRecipeFields()
    for group in groups do for key in CyrusStyleFields group do appendIfUnique fields key
    if seedPolicy!=#current do join fields #("randomSeed","procSamplingSalt","diversitySeed")
    for key in fields do (
        local spec=undefined;for field in schema where field[1]==key do spec=field
        if spec==undefined do throw ("Unsupported style field: "+key)
        local kind=spec[2],value=CyrusRecipeGet settings key,roleID=undefined
        if findItem #("node","texturemap") kind>0 do roleID=value
        if matchPattern kind pattern:"*tab" then (
            kind=substring kind 1 (kind.count-3)
            value=for item in value collect (CyrusRecipeApplyValue bindings item kind metres)
        ) else value=CyrusRecipeApplyValue bindings value kind metres
        if roleID!=undefined and value==undefined do throw ("Bind the selected setting's dependency: "+key)
        if findItem #("node","texturemap") kind>0 and value!=undefined do (
            if kind=="node" and (not isValidNode value or classof value.baseObject==AminScatterObject) do throw "Bind a valid scene object for the selected setting."
            if key=="fallAnalyzer" and not (CyrusAnalyzerFilter value) do throw "Area falloff requires a Surface Analyzer binding."
            if kind=="texturemap" and superclassof value!=TextureMap do throw "Bind a texture map for the density role."
        )
        if seedPolicy==#new and findItem #("randomSeed","procSamplingSalt","diversitySeed") key>0 do (
            local identity=(dotNetClass "System.Guid").NewGuid();value=bit.and (identity.GetHashCode()) 2147483647
            if value==getProperty owner (key as name) do value=if value==2147483647 then 0 else value+1
        )
        append values #(key,value)
        if findItem #("float","worldunits","integer") spec[2]>0 do (
            local control=getPropertyController owner (key as name)
            if control!=undefined do append controllers #(key,control)
        )
    )
    CyrusStyleCheckCurves owner values
    cyrusRecipeStyleValidate owner (CyrusStyleSettings root owner values) fields
    -- Capture the reviewed proposal, not a live selection or a deferred random draw.
    local changed=#()
    for pair in values do (
        local old=getProperty owner (pair[1] as name)
        if classof pair[2]==Array do old=old as array
        if not (CyrusPresetSameValues old pair[2]) do append changed pair[1]
    )
    if (cyrusRecipeInfo path)[11]!=digest do throw "The recipe changed while reviewing. Refresh and review again."
    CyrusStylePlan root:root node:node owner:owner ownerID:owner.layerID path:path digest:digest recordID:recordID groups:(deepCopy groups) seedPolicy:seedPolicy values:values previous:(CyrusStyleSnapshot owner) controllers:controllers inputKey:(root.procInputKey()) changed:changed
)
fn CyrusStyleCommit plan = (
    CyrusRequireAuthor()
    if theHold.Holding() do throw "Finish the current Undo operation before applying a style."
    CyrusRecipeCheckRoot plan.root plan.node
    if findItem plan.root.layerObjects plan.owner==0 or plan.owner.layerID!=plan.ownerID do throw "The reviewed layer was removed or replaced."
    if (cyrusRecipeInfo plan.path)[11]!=plan.digest do throw "The recipe changed. Review the new version before applying."
    if not (CyrusPresetSameValues (CyrusStyleSnapshot plan.owner) plan.previous) or plan.root.procInputKey()!=plan.inputKey do throw "The destination changed after review. Review the style again."
    cyrusRecipeCheckStatic plan.owner
    for pair in plan.controllers where (getPropertyController plan.owner (pair[1] as name))!=pair[2] do throw "A destination controller changed. Review again."
    CyrusStyleCheckCurves plan.owner plan.values
    cyrusRecipeStyleValidate plan.owner (CyrusStyleSettings plan.root plan.owner plan.values) (for pair in plan.values collect pair[1])
    if plan.changed.count==0 do return false
    local oldTransfer=plan.owner.getLayerTransfer(),oldSuspended=CyrusPointSuspended
    theHold.Begin();CyrusPointSuspended=true;plan.owner.setLayerTransfer true
    try (
        with animate off (
            for pair in plan.controllers where findItem plan.changed pair[1]>0 do setPropertyController plan.owner (pair[1] as name) (copy pair[2])
            for pair in plan.values where findItem plan.changed pair[1]>0 do setProperty plan.owner (pair[1] as name) pair[2]
            plan.root.procValidate()
        )
        plan.owner.setLayerTransfer oldTransfer;CyrusPointSuspended=oldSuspended
        theHold.Accept "Cyrus apply style"
    )catch(
        theHold.Cancel();plan.owner.setLayerTransfer oldTransfer;CyrusPointSuspended=oldSuspended;throw()
    )
    plan.owner.markInputDirty();plan.root.bindNativeUI();CyrusViewportRedraw();true
)
fn CyrusOpenRecipeStyle root path digest = (
    local node=CyrusRecipeOwnerNode root,owner=root.selectedLayer()
    CyrusRecipeCheckRoot root node
    if owner==undefined do throw "Select a destination layer first."
    if (cyrusRecipeInfo path)[11]!=digest do throw "Recipe changed. Refresh before applying its style."
    local document=cyrusRecipeReadMetadata path
    if CyrusStyleEditor!=undefined do try(destroyDialog CyrusStyleEditor)catch()
    rollout editor "Apply recipe style" width:660 height:650 (
        local root,node,owner,path,digest,document,records=#(),roles=#(),bindings=#(),plan=undefined,bindingControls=false,bindControls
        label destination "" pos:[12,12] width:636 height:32
        dropdownlist sourceLayer "Saved layer:" items:#() pos:[12,50] width:636
        multiListBox groups "Setting groups" items:#("Amount","Grid layout","Transforms","Slope and altitude","Surface density","Density texture","Area falloff") pos:[12,106] width:290 height:7
        label retained "Keep: terrain, models, Paint, layer order, Bands, spacing relationships and source/receiver identities.\n\nOnly selected setting groups change. Static destination layers are supported." pos:[322,122] width:326 height:136
        dropdownlist seeds "Seeds:" items:#("Keep destination seeds","Use saved seeds","Choose new seeds") selection:1 pos:[12,266] width:636
        label seedsNote "Seed choices cover sampling and model-assignment seeds. Receiver variation domains stay with the destination." pos:[12,316] width:636 height:36
        listbox roleList "Explicit bindings used by selected groups" items:#() pos:[12,362] width:636 height:4
        pickbutton bindNode "Bind scene object..." pos:[12,458] width:308 autoDisplay:false enabled:false
        mapbutton bindMap "Bind texture..." pos:[340,458] width:308 enabled:false
        button review "Review changes" pos:[12,500] width:202
        button applyStyle "Apply Style" pos:[228,500] width:202 enabled:false
        button closeButton "Close" pos:[446,500] width:202
        label status "Review before applying. Existing authored Edit/radius records and controlled curve arrays are protected." pos:[12,542] width:636 height:96
        fn clearPlan = (plan=undefined;applyStyle.enabled=false)
        fn showRoles = (
            clearPlan();roles=#();bindings=#()
            if sourceLayer.selection<1 do return false
            local settings=CyrusRecipeGet records[sourceLayer.selection] "settings",keys=#(),allRoles=CyrusRecipeGet document "roles"
            for index in groups.selection do for key in CyrusStyleFields groups.items[index] do appendIfUnique keys key
            for field in CyrusRecipeFields() where findItem keys field[1]>0 and findItem #("node","texturemap") field[2]>0 do (
                local id=CyrusRecipeGet settings field[1]
                if id!=undefined do for role in allRoles where (CyrusRecipeGet role "id")==id do (
                    if (findItem (for pair in bindings collect pair[1]) id)==0 do (append roles role;append bindings #(id,undefined))
                )
            )
            roleList.items=for role in roles collect ((CyrusRecipeGet role "name")+" - UNBOUND")
            roleList.selection=if roles.count>0 then 1 else 0
            bindControls();true
        )
        fn bindControls = (
            bindingControls=true;local i=roleList.selection,kind=if i<1 or i>roles.count then "" else CyrusRecipeGet roles[i] "kind"
            bindNode.enabled=kind=="node";bindMap.enabled=kind=="texture"
            bindMap.map=if kind=="texture" then bindings[i][2] else undefined
            bindingControls=false
        )
        fn bound value = (
            local i=roleList.selection;if i>0 and i<=bindings.count do (
                bindings[i][2]=value
                roleList.items=for j=1 to roles.count collect ((CyrusRecipeGet roles[j] "name")+" - "+(if bindings[j][2]==undefined then "UNBOUND" else bindings[j][2].name))
                roleList.selection=i;clearPlan()
            )
        )
        on editor open do (
            root=CyrusStyleOpenData[1];node=CyrusStyleOpenData[2];owner=CyrusStyleOpenData[3];path=CyrusStyleOpenData[4];digest=CyrusStyleOpenData[5];document=CyrusStyleOpenData[6]
            destination.text="Destination: "+root.layerCaption owner
            records=CyrusRecipeGet document "layers";sourceLayer.items=for record in records collect CyrusRecipeGet record "name";sourceLayer.selection=1
            groups.selection=#{1};showRoles()
        )
        on sourceLayer selected i do showRoles()
        on groups selectionEnd do showRoles()
        on seeds selected i do clearPlan()
        on roleList selected i do bindControls()
        on bindNode picked value do bound value
        on bindMap picked value do if not bindingControls do bound value
        on review pressed do try (
            local selected=for index in groups.selection collect groups.items[index]
            plan=CyrusStylePrepare root owner path digest (CyrusRecipeGet records[sourceLayer.selection] "id") selected bindings seedPolicy:((#(#current,#saved,#new))[seeds.selection])
            status.text=if plan.changed.count==0 then "No effective changes. Apply leaves the scene and Undo history unchanged." else ((plan.changed.count as string)+" settings will change. Terrain, Paint, models and relationships are retained. Manual mode waits for Update.")
            applyStyle.enabled=true
        )catch(clearPlan();status.text=getCurrentException())
        on applyStyle pressed do try (
            if plan==undefined do throw "Review the style first."
            local changed=CyrusStyleCommit plan
            clearPlan();status.text=if changed then "Applied as one Undo. Manual mode waits for Update." else "Already applied. Scene and Undo history retained."
        )catch(clearPlan();status.text=getCurrentException())
        on closeButton pressed do destroyDialog editor
        on editor close do CyrusStyleEditor=undefined
    )
    CyrusStyleOpenData=#(root,node,owner,path,digest,document);CyrusStyleEditor=editor
    createDialog editor style:#(#style_titlebar,#style_sysmenu,#style_toolwindow)
    true
)

fn CyrusOpenRecipeLibrary root surface:undefined = (
    if root!=undefined do CyrusRecipeCheckRoot root (CyrusRecipeOwnerNode root)
    if surface==undefined do (
        local selected=for node in selection where superclassof node==GeometryClass and classof node.baseObject!=AminScatterObject collect node
        if selected.count==1 then surface=selected[1]
        else if root!=undefined do (
            local layer=root.selectedLayer(),receivers=if layer==undefined then #() else layer.validSurfaces()
            if receivers.count==1 do surface=receivers[1]
        )
    )
    if surface!=undefined do (
        CyrusLibraryCheckSurface surface
        root=CyrusLibraryDestination surface root
    )
    local node=if root==undefined then undefined else CyrusRecipeOwnerNode root
    if cyrusRecipeLibraryVersion==undefined or cyrusRecipeLibraryVersion()!=4 do throw "Restart Max with the complete Cyrus 0.87.4 package."
    local galleryPath=pathConfig.appendPath CyrusRecipeScriptDirectory "CyrusGallery.dll",galleryAssembly=dotNet.loadAssembly galleryPath
    if galleryAssembly==undefined do throw "The Cyrus gallery assembly could not load."
    local assemblyName=galleryAssembly.GetName()
    if assemblyName.Version.ToString()!="0.87.4.0" or toLower galleryAssembly.Location!=toLower galleryPath do throw "Restart Max with the complete Cyrus 0.87.4 gallery package."
    if CyrusRecipeBrowser!=undefined do (
        local window=CyrusRecipeBrowser,handle=try(window.hwnd as integer64)catch(0L)
        if (dotNetClass "CyrusScatter.UI.LibraryWindow").RestoreAndActivate handle do (
            window.bindContext root node surface
            CyrusRecipeOpenRoot=root;CyrusRecipeOpenNode=node;CyrusRecipeOpenSurface=surface
            return true
        )
        try(destroyDialog window)catch()
    )
    rollout browser "Cyrus Library" width:1000 height:680 (
        local root,node,surface,sessionID="",directory="",customDirectory="",entries=#(),collections=#(),categories=#(),page=1,scan=0L,scanState="complete",bindingControls=false,modelCatalog=undefined,modelEntries=#(),modelScan=undefined
        dotNetControl panel "CyrusScatter.UI.LibraryPanel" pos:[0,0] width:1000 height:680
        timer scanTimer interval:250 active:false
        fn validRoot = (CyrusRecipeCheckRoot root node)
        fn bindDestination owner ownerNode = (root=owner;node=ownerNode;panel.HasSetup=true)
        fn bindContext owner ownerNode receiver = (
            if root!=owner or node!=ownerNode or surface!=receiver do (
                root=owner;node=ownerNode;surface=receiver;sessionID=CyrusNewLayerID()
                panel.HasSetup=root!=undefined and isValidNode node and node.baseObject==root
            )
        )
        fn selectedEntry = (local i=panel.Gallery.SelectedIndex+1;if i<1 or i>entries.count then undefined else entries[i])
        fn selectedModel = (local i=panel.Gallery.SelectedIndex+1;if i<1 or i>modelEntries.count then undefined else modelEntries[i])
        fn modelsActive = (panel.LibraryIndex==2 or panel.LibraryIndex==4)
        fn sharedCollection = (if panel.LibraryIndex==1 and matchPattern panel.Category pattern:"@:*" then substring panel.Category 3 -1 else if panel.LibraryIndex==4 then panel.Category else "")
        fn queryCategory = (if panel.LibraryIndex==1 and matchPattern panel.Category pattern:"@:*" then "" else panel.Category)
        fn showSelected = (
            panel.HasSetup=root!=undefined and isValidNode node and node.baseObject==root
            if modelsActive() do (
                local entry=selectedModel()
                panel.DetailText=if entry==undefined then "Choose an individual model." else entry.Name+" | "+(if panel.LibraryIndex==4 then "Shared model" else entry.Category)+"\nMerge this model into the scene, or add it as a source to the selected Scatter layer."
                panel.SetSelectionActions (entry!=undefined) false false
                return true
            )
            local entry=selectedEntry(),i=panel.Gallery.SelectedIndex+1
            if panel.CollectionsView then (
                panel.DetailText=if i>0 and i<=collections.count then collections[i][1]+" | "+((collections[i][2] as integer) as string)+" recipes" else "Choose a collection, or All recipes in the library tree."
                panel.SetSelectionActions (i>0 and i<=collections.count) false scanTimer.active
            ) else (
                panel.DetailText=if entry==undefined then "No matching recipes." else entry[2][1]+" | "+((entry[2][2] as integer) as string)+" layers; "+((entry[2][3] as integer) as string)+" Paint documents. "+entry[2][17]+"\n"+entry[2][16]+"\n"+entry[2][7]
                panel.SetSelectionActions (entry!=undefined) (panel.LibraryIndex!=2) scanTimer.active
            )
        )
        fn showPage = (
            if panel.LibraryIndex==4 do (
                if modelScan!=undefined do (
                    if not modelScan.Terminal do (panel.SetPage 1 1 0 true;panel.StatusText="Reading the personal model catalog...";return false)
                    scanTimer.active=false
                    if modelScan.State!="complete" do (local error=if modelScan.State=="cancelled" then "Model catalog scan cancelled." else modelScan.Error;modelScan=undefined;throw error)
                    modelScan=undefined
                    panel.BeginCollections();for name in ((CyrusSharedStore()).ModelCollections()) do panel.AddCollection name;panel.EndCollections()
                )
                local store=CyrusSharedStore(),group=sharedCollection(),total=store.ModelCount panel.SearchText group,pages=amax 1 ((ceil (total/128.0)) as integer)
                page=amax 1 (amin page pages);modelEntries=#();bindingControls=true;panel.IndividualModels=true;panel.Gallery.BeginPage()
                for entry in (store.ModelPage panel.SearchText group page) do (
                    append modelEntries entry;panel.Gallery.AddItem entry.Id entry.Name "Shared model" entry.Thumbnail entry.ThumbnailHash entry.ThumbnailBytes
                )
                panel.Gallery.EndPage (if modelEntries.count>0 then 0 else -1);bindingControls=false
                panel.SetPage page pages total false;panel.LocationText="My models / "+(if group=="" then "All models" else group)
                panel.StatusText="Models saved with your complete recipes appear here. Their geometry and textures are reused."
                showSelected();return true
            )
            if modelsActive() do (
                if modelCatalog==undefined do throw "The installed individual model library is unavailable. Reinstall its matching Content folder."
                scanTimer.active=false;modelEntries=#();bindingControls=true
                panel.IndividualModels=true;panel.Gallery.BeginPage()
                local total=modelCatalog.MatchingCount panel.SearchText panel.Category,pages=amax 1 ((ceil (total/128.0)) as integer)
                page=amax 1 (amin page pages)
                local first=(page-1)*128,last=amin total (first+128)
                if first<last do for i=first to last-1 do (
                    local entry=modelCatalog.MatchingAt panel.SearchText panel.Category i
                    append modelEntries entry
                    panel.Gallery.AddItem entry.Id entry.Name entry.Category entry.Thumbnail entry.ThumbnailHash entry.ThumbnailBytes
                )
                panel.Gallery.EndPage (if modelEntries.count>0 then 0 else -1)
                bindingControls=false;panel.SetPage page pages total false
                panel.LocationText="Plant models / "+(if panel.Category=="" then "All models" else panel.Category)
                panel.StatusText="Ready: "+(modelCatalog.Count as string)+" individual models; "+(total as string)+" matching."
                showSelected();return true
            )
            panel.IndividualModels=false
            if scan==0 do return false
            local result=cyrusRecipeLibraryPage scan panel.SearchText (queryCategory()) page
            local pages=if panel.CollectionsView then result[12] else result[8]
            if page>pages do (page=pages as integer;result=cyrusRecipeLibraryPage scan panel.SearchText (queryCategory()) page)
            scanState=result[1];scanTimer.active=scanState=="scanning"
            if not (CyrusPresetSameValues categories result[9]) do (
                categories=result[9];panel.BeginCollections()
                for i=1 to amin 128 categories.count do panel.AddCollection categories[i]
                if panel.LibraryIndex==1 do for name in ((CyrusSharedStore()).Collections()) do panel.AddNamedCollection name ("@:"+name)
                panel.EndCollections()
            )
            local previous=if panel.CollectionsView then collections else entries,newRows=if panel.CollectionsView then result[11] else result[10]
            local changed=not (CyrusPresetSameValues previous newRows)
            entries=result[10];collections=result[11]
            if changed or panel.Gallery.ItemCount!=newRows.count do (
                local chosen=panel.Gallery.SelectedId,selected=0
                bindingControls=true;panel.Gallery.BeginPage()
                for i=1 to newRows.count do (
                    local row=newRows[i],id=row[1],title=if panel.CollectionsView then row[1] else row[2][1],detail=if panel.CollectionsView then ((row[2] as integer) as string)+" recipes" else ((row[2][2] as integer) as string)+" layers | "+row[2][17]
                    local descriptor=if panel.CollectionsView then row[3] else row[2][14]
                    panel.Gallery.AddItem id title detail (if descriptor.count==3 then descriptor[1] else "") (if descriptor.count==3 then descriptor[2] else "") (if descriptor.count==3 then descriptor[3] as integer else 0)
                    if id==chosen do selected=i
                )
                panel.Gallery.EndPage (if selected>0 then selected-1 else if newRows.count>0 then 0 else -1)
                bindingControls=false
            )
            panel.SetPage page (pages as integer) ((if panel.CollectionsView then result[13] else result[7]) as integer) scanTimer.active
            panel.LocationText=(#("My recipes","Plant models","Custom library"))[panel.LibraryIndex]+" / "+(if panel.CollectionsView then "Collections" else if panel.Category=="" then "All recipes" else panel.Category)
            panel.StatusText=(if scanTimer.active then "Scanning: " else "Ready: ")+((result[3] as integer) as string)+" recipes; "+((result[4] as integer) as string)+" invalid."+(if result[5] then " Catalog limit reached; choose a smaller folder." else "")+(if categories.count>128 then " Tree shows first 128 collections; use the paged collection tiles for all." else "")+(if result[6]!="" then " "+result[6] else "")
            showSelected();true
        )
        fn refresh = (
            if modelScan!=undefined do (modelScan.Cancel();modelScan=undefined)
            page=1;entries=#();collections=#();categories=#()
            if panel.LibraryIndex==1 do directory=CyrusRecipeDirectory()
            if panel.LibraryIndex==2 do directory=CyrusRecipeBundledDirectory (CyrusLibraryVersion())
            if panel.LibraryIndex==4 do (
                scanTimer.active=false;if scan!=0 do (try(cyrusRecipeLibraryCancel scan)catch();scan=0L)
                modelEntries=#();bindingControls=true;panel.IndividualModels=true;panel.Gallery.BeginPage();panel.Gallery.EndPage -1;bindingControls=false
                panel.SetSelectionActions false false true
                modelScan=(CyrusSharedStore()).PrepareModels();scanTimer.active=true
                return showPage()
            )
            if modelsActive() do (
                scanTimer.active=false
                if scan!=0 do (try(cyrusRecipeLibraryCancel scan)catch();scan=0L)
                modelEntries=#();modelCatalog=undefined
                panel.IndividualModels=true;panel.Gallery.BeginPage();panel.Gallery.EndPage -1
                panel.BeginCollections();panel.EndCollections();showSelected()
                if not doesFileExist (pathConfig.appendPath directory "model-catalog.json") do (
                    panel.StatusText="No plant library is configured. Keep the supplied Content folder beside the installer, then run Install or Update."
                    return false
                )
                modelCatalog=dotNetObject "CyrusScatter.UI.IndividualModelCatalog"
                modelCatalog.Load directory (CyrusLibraryVersion()) ((maxVersion())[1]/1000+1998)
                panel.BeginCollections()
                if modelCatalog.CategoryCount>0 do for i=0 to modelCatalog.CategoryCount-1 do panel.AddCollection (modelCatalog.CategoryAt i)
                panel.EndCollections();panel.IndividualModels=true
                return showPage()
            )
            panel.IndividualModels=false;modelEntries=#()
            panel.BeginCollections();panel.EndCollections()
            scan=if panel.LibraryIndex==1 then cyrusSharedLibraryStart directory (sharedCollection()) else cyrusRecipeLibraryStart #(directory)
            if panel.LibraryIndex==1 do (
                panel.BeginCollections();for name in ((CyrusSharedStore()).Collections()) do panel.AddNamedCollection name ("@:"+name);panel.EndCollections()
            )
            scanTimer.active=true;showPage()
        )
        fn navigate category overview = (
            bindingControls=true;panel.SetNavigation panel.LibraryIndex category overview
            entries=#();collections=#();page=1;bindingControls=false;showPage()
        )
        fn refreshEntry path = (
            if panel.LibraryIndex==1 do return refresh()
            if scanTimer.active do (panel.StatusText="Saved. Refresh after the active scan completes.";return false)
            local io=dotNetClass "System.IO.Path"
            if toLower (io.GetFullPath (getFilenamePath path))==toLower (io.GetFullPath (directory+"\\")) then (cyrusRecipeLibraryUpdate scan path;showPage())
            else panel.StatusText="Saved. Select its library folder to browse it."
            true
        )
        fn loadSelected = (
            if modelsActive() do (
                local entry=selectedModel()
                if entry==undefined do throw "Select an individual model."
                if root==undefined do throw "Select a Cyrus Scatter setup and its destination layer, then open the library again. Use Merge model to place a model directly in the scene."
                validRoot()
                local owner=root.selectedLayer()
                if owner==undefined do throw "Select the destination Scatter layer first."
                panel.ShowProgress ("Adding "+entry.Name+"...")
                if panel.LibraryIndex==4 then CyrusSharedImportModel entry owner:owner root:root else CyrusModelMerge modelCatalog entry owner:owner
                if panel.LibraryIndex==4 do (panel.ShowProgress ("Preparing "+entry.Name+" for the captured layer. See the import progress window.");return true)
                root.bindNativeUI()
                panel.ShowNotice ("Added "+entry.Name+" to "+(root.layerCaption owner)+". "+(if root.updateMode==1 then "Press Update scatter when ready." else "The layer will update in Live mode.")) true
                return true
            )
            if scanTimer.active do throw "Wait for the library scan or cancel it before loading."
            if panel.CollectionsView then (
                local i=panel.Gallery.SelectedIndex+1
                if i>0 and i<=collections.count do navigate collections[i][1] false
            ) else (
                local entry=selectedEntry()
                if entry==undefined do throw "Select a recipe."
                local packageDirectory=getFilenamePath entry[1]
                local readyDirectory=CyrusPresetPackageDirectory entry[1] entry[2][11]
                CyrusLibraryCheckSurface surface
                if root==undefined do (root=CyrusLibraryDestination surface undefined;node=if root==undefined then undefined else CyrusRecipeOwnerNode root)
                if root!=undefined do validRoot()
                if doesFileExist (pathConfig.appendPath readyDirectory "cyrus.package.json") then CyrusOpenReadyPreset root readyDirectory expected:entry[2][11] surface:surface
                else if doesFileExist (pathConfig.appendPath packageDirectory "cyrus.package.json") then CyrusOpenReadyPreset root packageDirectory expected:entry[2][11] surface:surface
                else throw "The models and assets for this recipe are unavailable. It may be settings-only, or its asset package is missing/incomplete. Restore the complete recipe folder or save it again with Include models, materials, terrain and paths enabled."
            )
        )
        fn action name = (
            if findItem #("save","update","style","export") name>0 do validRoot()
            case name of (
                "selection":showSelected()
                "load":loadSelected()
                "merge":(
                    if not (modelsActive()) do throw "Select an individual model."
                    local entry=selectedModel()
                    if entry==undefined do throw "Select an individual model."
                    panel.ShowProgress ("Merging "+entry.Name+"...")
                    if panel.LibraryIndex==4 then CyrusSharedImportModel entry else CyrusModelMerge modelCatalog entry
                    if panel.LibraryIndex==4 then panel.ShowProgress ("Preparing "+entry.Name+". See the import progress window.") else panel.ShowNotice ("Merged "+entry.Name+" into the scene.") true
                )
                "home":(bindingControls=true;panel.SearchText="";bindingControls=false;navigate "" true)
                "search":(if panel.SearchText!="" and panel.CollectionsView do panel.SetNavigation panel.LibraryIndex "" false;entries=#();collections=#();page=1;showPage())
                "collection":(entries=#();collections=#();page=1;if panel.LibraryIndex==1 then refresh() else showPage())
                "library":(
                    if panel.LibraryIndex==3 and customDirectory=="" then (directory=CyrusRecipeDirectory();panel.SetNavigation 1 "" true;refresh();panel.StatusText="Choose a custom library folder.")
                    else (directory=if panel.LibraryIndex==1 then CyrusRecipeDirectory() else if panel.LibraryIndex==2 then CyrusRecipeBundledDirectory (CyrusLibraryVersion()) else customDirectory;refresh())
                )
                "folder":(local chosen=getSavePath caption:"Choose Cyrus recipe library" initialDir:directory;if chosen!=undefined do (customDirectory=chosen;directory=chosen;panel.SetNavigation 3 "" true;refresh()))
                "library-import":(
                    local archive=getOpenFileName caption:"Import shared library" types:"Cyrus shared library (*.cyruslib)|*.cyruslib|"
                    if archive!=undefined do CyrusSharedWatchOperation ((CyrusSharedStore()).Import archive)
                )
                "library-import-copy":(
                    local archive=getOpenFileName caption:"Import conflicting recipes as copies" types:"Cyrus shared library (*.cyruslib)|*.cyruslib|"
                    if archive!=undefined do CyrusSharedWatchOperation ((CyrusSharedStore()).Import archive true)
                )
                "library-remove":(
                    local store=CyrusSharedStore()
                    if panel.LibraryIndex==4 then (
                        local entry=selectedModel();if entry==undefined do throw "Select one of My models."
                        if queryBox "Remove this model card? Shared data and saved scenes will be retained." title:"Shared library" do (store.RemoveModel entry.Id;refresh())
                    ) else (
                        if panel.LibraryIndex!=1 or panel.CollectionsView do throw "Select one of My recipes or My models."
                        local entry=selectedEntry();if entry==undefined do throw "Select a recipe."
                        if queryBox "Remove this recipe card? Shared data and saved scenes will be retained." title:"Shared library" do (store.RemoveRecipe (store.RecipeId entry[1]);refresh())
                    )
                )
                "library-export":(
                    local archive=getSaveFileName caption:"Export shared library" filename:"My library.cyruslib" types:"Cyrus shared library (*.cyruslib)|*.cyruslib|"
                    if archive!=undefined do CyrusSharedWatchOperation ((CyrusSharedStore()).Export (sharedCollection()) archive)
                )
                "library-collect":(
                    local store=CyrusSharedStore(),recipes="[]",models="[]"
                    if panel.LibraryIndex==4 then (local entry=selectedModel();if entry==undefined do throw "Select one of My models first.";models="[\""+entry.Id+"\"]") else (
                        if panel.LibraryIndex!=1 or panel.CollectionsView do throw "Select one of My recipes or My models first."
                        local entry=selectedEntry();if entry==undefined do throw "Select a recipe first.";recipes="[\""+(store.RecipeId entry[1])+"\"]"
                    )
                    local name=CyrusSharedAskName()
                    if name!=undefined and name!="" do CyrusSharedWatchOperation (store.AddToCollectionFromJson name recipes models)
                )
                "library-storage":CyrusSharedOpenStorage()
                "library-location":CyrusSharedConfigureRoot()
                "library-model-name":(
                    if panel.LibraryIndex!=4 do throw "Select one of My models first."
                    local entry=selectedModel();if entry==undefined do throw "Select a saved model."
                    local name=CyrusSharedAskName initial:entry.Name caption:"Model name:"
                    if name!=undefined and name!="" do CyrusSharedWatchOperation ((CyrusSharedStore()).RenameModel entry.Id name)
                )
                "library-model-save":CyrusSharedSaveModels()
                "refresh":refresh()
                "cancel":(if modelScan!=undefined then modelScan.Cancel() else cyrusRecipeLibraryCancel scan;panel.StatusText="Stopping library scan...")
                "previous":(page-=1;showPage())
                "next":(page+=1;showPage())
                "view":(
                    setINISetting (CyrusRecipeViewPreferences()) "View" "Mode" (if panel.ViewIndex==1 then "list" else "tiles")
                    setINISetting (CyrusRecipeViewPreferences()) "View" "Size" ((#("small","medium","large"))[panel.ZoomIndex+1])
                )
                "save":CyrusOpenRecipeSave root (CyrusRecipeDirectory())
                "update":(
                    local entry=selectedEntry();if entry==undefined or panel.CollectionsView do throw "Select a recipe."
                    CyrusOpenRecipeSave root directory path:entry[1] expected:entry[2][11]
                )
                "style":(
                    local entry=selectedEntry();if entry==undefined or panel.CollectionsView do throw "Select a recipe."
                    CyrusOpenRecipeStyle root entry[1] entry[2][11]
                )
                "export":(
                    local entry=selectedEntry();if entry==undefined or panel.CollectionsView do throw "Select a recipe."
                    CyrusOpenAssetExport root entry[1] entry[2][11]
                )
                "edit":(
                    local entry=selectedEntry();if entry==undefined or panel.CollectionsView do throw "Select a recipe."
                    CyrusRecipeEditDetails entry[1] entry[2][11] (CyrusLibraryVersion())
                )
            )
        )
        on browser open do (
            root=CyrusRecipeOpenRoot;node=CyrusRecipeOpenNode;surface=CyrusRecipeOpenSurface;sessionID=CyrusNewLayerID();directory=CyrusRecipeBundledDirectory (CyrusLibraryVersion())
            panel.SetNavigation 2 "" false;panel.IndividualModels=true
            -- Max may restore a previous smaller dialog size without a resized
            -- event. Bind the control to that actual size before its first scan.
            local size=getDialogSize browser
            panel.width=amax 1 size.x;panel.height=amax 1 size.y
            panel.UserScale=CustomControlsOptions.UIUserScaleFactor
            local prefs=CyrusRecipeViewPreferences(),mode=getINISetting prefs "View" "Mode",size=getINISetting prefs "View" "Size"
            bindingControls=true;panel.ViewIndex=if mode=="list" then 1 else 0;panel.ZoomIndex=if size=="large" then 2 else if size=="small" then 0 else 1;bindingControls=false
            try(refresh())catch(panel.StatusText=getCurrentException())
        )
        on panel ActionRequested sender args do if not bindingControls do try(action panel.RequestedAction)catch(panel.ShowNotice (getCurrentException()) false)
        on scanTimer tick do try(showPage())catch(scanTimer.active=false;try(cyrusRecipeLibraryCancel scan)catch();panel.StatusText=getCurrentException())
        on browser resized size do (panel.width=amax 1 size.x;panel.height=amax 1 size.y)
        on browser close do (
            if modelScan!=undefined do modelScan.Cancel()
            scanTimer.active=false;if scan!=0 do try(cyrusRecipeLibraryCancel scan)catch()
            panel.Dispose()
            CyrusRecipeBrowser=undefined
        )
    )
    CyrusRecipeOpenRoot=root;CyrusRecipeOpenNode=node;CyrusRecipeOpenSurface=surface;CyrusRecipeBrowser=browser
    createDialog browser width:1000 height:680 style:#(#style_titlebar,#style_sysmenu,#style_resizing,#style_minimizebox,#style_maximizebox)
    true
)

-- Installation preference: shared by Scatter controllers in this Max process.
-- Applying it changes future native admission only; scene data and Undo stay untouched.
global CyrusViewportMemoryInitialized,CyrusViewportMemoryDialog,CyrusViewportMemoryOwner
global CyrusViewportMemoryPreferences,CyrusInitializeViewportMemory,CyrusApplyViewportMemory
global CyrusOpenViewportMemory,CyrusViewportMemoryOwnerValid

fn CyrusViewportMemoryPreferences = pathConfig.appendPath (getDir #plugcfg) "CyrusScatterViewport.ini"
fn CyrusInitializeViewportMemory = (
    if CyrusViewportMemoryInitialized==true do return true
    if cyrusSetViewportMemoryLimit==undefined or cyrusViewportMemoryStats==undefined do
        throw "Install the complete Cyrus 0.87.4 package and restart Max."
    local value=0,stored=getINISetting (CyrusViewportMemoryPreferences()) "Memory" "LimitMiB"
    if stored!="" do try(value=stored as integer)catch(value=0)
    if value!=0 and (value<256 or value>65536) do value=0
    cyrusSetViewportMemoryLimit value
    CyrusViewportMemoryInitialized=true
    true
)
fn CyrusApplyViewportMemory value = (
    CyrusInitializeViewportMemory()
    local previous=(cyrusViewportMemoryStats())[2]
    cyrusSetViewportMemoryLimit value
    try (
        if not (setINISetting (CyrusViewportMemoryPreferences()) "Memory" "LimitMiB" (value as string)) do
            throw "The viewport memory preference could not be saved."
    ) catch (cyrusSetViewportMemoryLimit previous;throw())
    true
)
fn CyrusViewportMemoryOwnerValid controller = (
    if controller==undefined do return false
    for node in refs.dependentNodes controller where isValidNode node and node.baseObject==controller do return true
    false
)
rollout CyrusViewportMemoryDialog "Cyrus viewport memory" width:410 height:340 (
    local controller=undefined
    radiobuttons mode "Memory allowance" labels:#("Automatic","Custom") columns:2 pos:[14,12] width:380
    spinner customLimit "Custom limit (MiB):" range:[256,65536,4096] type:#integer fieldWidth:84 pos:[14,63] width:380
    label scope "Shared by all Cyrus Scatter objects in this Max installation." pos:[14,94] width:380 height:32
    label usage "" pos:[14,130] width:380 height:54
    label detail "CPU and graphics resources are estimates. Native headroom and graphics safety limits still apply." pos:[14,188] width:380 height:40
    label status "Applying this preference keeps pending Manual edits unchanged." pos:[14,234] width:380 height:40
    button applyButton "Apply" pos:[14,290] width:105 height:28
    button refreshButton "Refresh display" pos:[127,290] width:150 height:28 tooltip:"Retry the current display using published placements. Pending Manual edits remain pending."
    button closeButton "Close" pos:[285,290] width:109 height:28
    fn showUsage = (
        local stats=cyrusViewportMemoryStats()
        if stats.count!=16 or stats[1]!=1 do throw "Unsupported viewport memory statistics. Install the matching package."
        local mib=1048576.0
        usage.text="Allowance: "+(((stats[3]/mib) as integer) as string)+" MiB\nIn use: "+(((stats[4]/mib) as integer) as string)+" MiB; peak: "+(((stats[5]/mib) as integer) as string)+" MiB (estimated)"
        customLimit.enabled=mode.state==2
        refreshButton.enabled=CyrusViewportMemoryOwnerValid controller
    )
    on mode changed value do customLimit.enabled=value==2
    on applyButton pressed do try (
        CyrusApplyViewportMemory (if mode.state==1 then 0 else customLimit.value)
        showUsage()
        status.text="Saved. Existing display resources are retained. Use Refresh display to retry."
    )catch(status.text=getCurrentException())
    on refreshButton pressed do try (
        local owner=controller
        if not (CyrusViewportMemoryOwnerValid owner) do throw "Select a current Scatter and open Viewport memory again."
        owner.refreshDisplay()
        showUsage()
        status.text=owner.allStatus()
    )catch(status.text=getCurrentException())
    on closeButton pressed do destroyDialog CyrusViewportMemoryDialog
    on CyrusViewportMemoryDialog open do (
        controller=CyrusViewportMemoryOwner
        CyrusInitializeViewportMemory()
        local requested=(cyrusViewportMemoryStats())[2]
        mode.state=if requested==0 then 1 else 2
        if requested!=0 do customLimit.value=requested
        showUsage()
    )
    on CyrusViewportMemoryDialog close do (controller=undefined;CyrusViewportMemoryOwner=undefined)
)
fn CyrusOpenViewportMemory controller = (
    CyrusInitializeViewportMemory()
    if CyrusViewportMemoryDialog.hwnd!=0 do destroyDialog CyrusViewportMemoryDialog
    CyrusViewportMemoryOwner=controller
    createDialog CyrusViewportMemoryDialog style:#(#style_titlebar,#style_border,#style_sysmenu)
    true
)
if cyrusSetViewportMemoryLimit!=undefined do CyrusInitializeViewportMemory()

-- Explicit scene-source commands. Catalog provenance is never node identity.
global CyrusCaptureSourceAccess,CyrusValidateSourceAccess,CyrusShowSourceAccess,CyrusEditSourceMaterial
fn CyrusCaptureSourceAccess controller layer rows = (
    if controller==undefined or layer==undefined or findItem controller.layerObjects layer==0 do throw "Select an active source layer."
    local records=#()
    for row in rows where row>0 and row<=layer.sources.count do (
        local node=layer.sources[row]
        if not layer.isPointSource row and not layer.isEmptySource row and isValidNode node do
            append records #(layer.sourceRowIDs[row],node,getHandleByAnim node)
    )
    #(controller,controller.layerID,layer,layer.layerID,records,rows.numberSet)
)
fn CyrusValidateSourceAccess context = (
    local controller=context[1],layer=context[3],alive=false,nodes=#()
    for node in refs.dependentNodes controller where isValidNode node and node.baseObject==controller do alive=true
    if not alive or controller.layerID!=context[2] or findItem controller.layerObjects layer==0 or layer.layerID!=context[4] do throw "The source owner changed. Select its sources again."
    for record in context[5] do (
        local row=findItem layer.sourceRowIDs record[1],node=record[2]
        if row==0 or not isValidNode node or getHandleByAnim node!=record[3] or layer.sources[row]!=node or layer.isPointSource row or layer.isEmptySource row do
            throw "The selected source changed. Select it again."
        appendIfUnique nodes node
    )
    nodes
)
fn CyrusShowSourceAccess context show = (
    local nodes=CyrusValidateSourceAccess context
    if nodes.count==0 do throw "Select at least one existing model source."
    if theHold.Holding() do throw "Finish the current scene command before changing source visibility."
    theHold.Begin()
    try (
        -- Host hide flags only. In particular, never set renderable=false here.
        if show then unhide nodes else hide nodes
        theHold.Accept (if show then "Cyrus show sources" else "Cyrus hide sources")
    )catch(theHold.Cancel();throw())
    redrawViews();nodes.count
)
fn CyrusEditSourceMaterial context = (
    local nodes=CyrusValidateSourceAccess context
    if context[6]!=1 or nodes.count!=1 or nodes[1].material==undefined do throw "Select one model with an assigned scene material."
    local node=nodes[1],material=node.material
    sme.Open()
    -- Opening an editor can dispatch messages and retire/rebind the source view.
    nodes=CyrusValidateSourceAccess context
    if nodes.count!=1 or node.material!=material do throw "The source material changed while opening the editor. Select it again."
    sme.SetMtlInParamEditor material
    material
)

-- Export options retain one captured owner/document, never the current UI row.
global CyrusPaintExportDialog,CyrusOpenPaintExport,CyrusClosePaintExport
fn CyrusClosePaintExport = (try(destroyDialog CyrusPaintExportDialog)catch();CyrusPaintExportDialog=undefined)
CyrusClosePaintExport()
callbacks.removeScripts id:#CyrusPaintExportUI
callbacks.addScript #systemPreReset "CyrusClosePaintExport()" id:#CyrusPaintExportUI persistent:false
callbacks.addScript #filePreOpen "CyrusClosePaintExport()" id:#CyrusPaintExportUI persistent:false
fn CyrusOpenPaintExport controller area = (
    controller.validatePaintConversion area
    try(destroyDialog CyrusPaintExportDialog)catch()
    local document=area.paintDocument,key=area.paintKey(),target=area.areaTarget,transform=area.areaTarget.objectTransform
    local surfaceAttached=cyrusBrushAttached document
    rollout exportOptions "Paint spline export" width:330 height:250 (
        local targetController,targetArea,targetDocument,capturedKey,capturedTarget,capturedTransform,attached=false
        radiobuttons mode "Create independent spline" labels:#("Optimized","Exact snapshot") columns:2 pos:[12,12] width:306
        spinner deviation "Maximum deviation:" type:#worldunits range:[1e-9,1e9,0.1] fieldWidth:90 pos:[12,60] width:306
        label help "Optimized reduces planar boundary knots within tolerance.\nExact preserves existing snapshot/reimport behavior.\nThe original Paint is unchanged." pos:[12,94] width:306 height:48
        button createSpline "Create spline" pos:[12,150] width:178 height:26
        button cancel "Close" pos:[200,150] width:118 height:26
        label result "" pos:[12,186] width:306 height:54
        fn validateCapture = (
            if targetController==undefined or targetArea==undefined do throw "The export context is closed. Open Export spline again."
            local alive=false
            for node in refs.dependentNodes targetController where isValidNode node and node.baseObject==targetController do alive=true
            if not alive do throw "The source Scatter was removed. Open Export spline again."
            targetController.validatePaintConversion targetArea
            if targetArea.paintDocument!=targetDocument or targetArea.paintKey()!=capturedKey or targetArea.areaTarget!=capturedTarget or capturedTarget.objectTransform!=capturedTransform do
                throw "The Paint Area or receiver changed. Close this view and open Export spline again."
            true
        )
        on exportOptions open do (mode.state=if attached then 2 else 1;deviation.value=units.decodeValue "1mm";deviation.enabled=(mode.state==1))
        on mode changed value do deviation.enabled=(value==1)
        on cancel pressed do destroyDialog exportOptions
        on createSpline pressed do try (
            validateCapture()
            local owner=targetController,source=targetArea,optimized=(mode.state==1),tolerance=deviation.value
            -- Export selects its new node and can unmount the Scatter panel.
            local outcome=owner.exportPaintSpline source optimized:optimized tolerance:tolerance
            if optimized then result.text=(if outcome[5] then "Optimized: " else "Exact: ")+(outcome[2] as string)+" → "+(outcome[3] as string)+" knots\n"+(if outcome[5] then ("Certified deviation ≤ "+units.formatValue outcome[4]) else outcome[6])
            else result.text="Exact independent snapshot created. Original Paint unchanged."
        )catch(result.text=getCurrentException())
        on exportOptions close do (targetController=undefined;targetArea=undefined;targetDocument=undefined;capturedTarget=undefined)
    )
    CyrusPaintExportDialog=exportOptions
    createDialog exportOptions style:#(#style_titlebar,#style_sysmenu,#style_toolwindow)
    -- Max initializes rollout locals when creating the dialog. Bind the captured
    -- values afterwards; pre-creation assignments are reset by that lifecycle.
    exportOptions.targetController=controller;exportOptions.targetArea=area;exportOptions.targetDocument=document
    exportOptions.capturedKey=key;exportOptions.capturedTarget=target;exportOptions.capturedTransform=transform
    exportOptions.attached=surfaceAttached;exportOptions.mode.state=if surfaceAttached then 2 else 1
    exportOptions.deviation.enabled=not surfaceAttached
    try(exportOptions.validateCapture())catch(CyrusClosePaintExport();throw())
    exportOptions
)

global CyrusFalloffGraph,CyrusPointSuspended,CyrusViewportRedraw,CyrusNewLayerID,CyrusFallPack,CyrusFallUnpack,CyrusFallGraphsEqual
-- Named data presets. Scene bindings are captured here, never stored in files.
global CyrusPresetBinding,CyrusPresetBrowser,CyrusPresetOpenBinding,CyrusOpenPresets
global CyrusPresetMakeBinding,CyrusPresetCheckBinding,CyrusPresetCapture,CyrusPresetApply,CyrusPresetTransactionVersion
global CyrusPresetDirectory,CyrusPresetRead,CyrusPresetWrite,CyrusPresetEntries,CyrusPresetSameValues
struct CyrusPresetBinding (root,node,owner,ownerID,category,peer=undefined,peerID="",editor=undefined)
fn CyrusPresetTransactionVersion = 1

fn CyrusPresetMakeBinding root owner category peer:undefined editor:undefined = (
    if root==undefined or owner==undefined do throw "Select a layer before opening presets."
    local nodes=for n in refs.dependentNodes root where isValidNode n and n.baseObject==root collect n
    if nodes.count!=1 do throw "Presets require one unambiguous Scatter controller."
    CyrusPresetBinding root:root node:nodes[1] owner:owner ownerID:owner.layerID category:category peer:peer peerID:(if peer==undefined then "" else peer.layerID) editor:editor
)
fn CyrusPresetCheckBinding target = (
    if target==undefined or not isValidNode target.node or target.node.baseObject!=target.root do throw "The preset controller was removed or replaced."
    if target.owner.layerID!=target.ownerID do throw "The preset layer identity changed."
    local parent=target.root.logicalParent target.owner
    if findItem target.root.layerObjects parent==0 do throw "The preset layer was removed."
    if target.owner.isPaintArea and findItem parent.paintAreas target.owner==0 do throw "The preset Paint Area was removed."
    if target.peer!=undefined and (findItem target.root.layerObjects target.peer==0 or target.peer.layerID!=target.peerID) do throw "The other spacing layer was removed or replaced."
    if target.editor!=undefined and (target.editor!=CyrusFalloffGraph or not target.editor.presetTargetValid()) do throw "The curve target is no longer available. Reopen its graph."
    true
)
fn CyrusPresetCapture target = (
    CyrusPresetCheckBinding target
    if target.editor!=undefined do return target.editor.presetValues()
    if findItem #("density_curve","scale_curve") target.category>0 do (
        if target.owner.isPaintArea do throw "Choose the explicit receiver-bound Paint curve target."
        local density=target.category=="density_curve"
        local stored=if density then target.owner.fallDensityCurve else target.owner.fallScaleCurve,packed=if density then target.owner.fallDensityGraph else target.owner.fallScaleGraph
        if stored.count>257 or packed.count>65536 do throw "Stored curve exceeds the preset inspection bound."
        return #(stored as array,CyrusFallUnpack packed,not density)
    )
    -- Preserve stored PB2 floats across metre conversion and a later import.
    -- Float/Float division rounds the physical value before native serialization.
    local meters=(units.decodeValue "1m") as double,schema=cyrusPresetSchema target.category
    if target.category=="spacing" do (
        local values=target.owner.procSelfRule()
        if target.peer!=undefined do (
            local i=target.root.procPair 2 target.owner target.peer
            values=if i==0 then #(false,1.0,0.0,false) else #(target.root.procRuleEnabled[i],target.root.procRuleMultiplier[i],target.root.procRuleGapWU[i],target.root.procRulePlanar[i])
        )
        values[3]/=meters;return values
    )
    for field in schema collect (local v=getProperty target.owner (field[1] as name);if field[3] then v/meters else v)
)
-- PB2 numeric fields and editable graph coordinates are stored as Max floats.
-- Compare effective storage values, never formatted text or a broad epsilon.
fn CyrusPresetSameValues a b = (
    if classof a==Array then (
        if classof b!=Array or a.count!=b.count do return false
        for i=1 to a.count where not (CyrusPresetSameValues a[i] b[i]) do return false
        true
    ) else if classof a==Float or classof a==Double then (
        if classof b!=Float and classof b!=Double do return false
        (a as float)==(b as float)
    ) else a==b
)
fn CyrusPresetApply target document seedPolicy:#saved transaction:#owned = (
    if findItem #(#owned,#caller) transaction==0 do throw "Choose an owned or caller preset transaction."
    if findItem #(#saved,#current,#new) seedPolicy==0 do throw "Choose Saved, Current or New seed."
    if target.category!="population" and seedPolicy!=#saved do throw "Seed choices apply only to Amount presets."
    CyrusRequireAuthor();CyrusPresetCheckBinding target
    local ownHold=transaction==#owned
    if ownHold and theHold.Holding() do throw "Finish the current undoable operation before applying a preset."
    -- A composed command owns rollback, configuration tags and publication.
    -- Keep its owners suspended until the complete command is committed.
    -- Interactive curve views retain their separate preparation lifecycle.
    if not ownHold do (
        if not theHold.Holding() do throw "A caller preset transaction requires an active authored hold."
        if target.editor!=undefined do throw "Caller transactions require a stored native target, not a curve editor."
        if not target.root.getLayerTransfer() or not target.owner.getLayerTransfer() do throw "Suspend both preset owners for the complete caller transaction."
        if seedPolicy==#new do throw "Resolve a new seed before reviewing a caller transaction."
    )
    -- Revalidate the entire typed proposal even for callers that bypass the browser.
    document=cyrusPresetDecode (cyrusPresetEncode document[1] document[2] document[3])
    if document[1]!=target.category do throw "This preset belongs to a different category."
    local schema=cyrusPresetSchema target.category,values=deepCopy document[3],owner=target.owner,meters=(units.decodeValue "1m") as double
    local globalCurve=target.editor==undefined and findItem #("density_curve","scale_curve") target.category>0,curveSamples=undefined,curveGraph=undefined
    if globalCurve do (
        if owner.isPaintArea do throw "Choose the explicit receiver-bound Paint curve target."
        if CyrusFalloffGraph!=undefined do throw "Close the curve editor before applying a global curve preset. Pending editor changes are not committed automatically."
        if cyrusPresetCurveVersion==undefined or cyrusPresetCurveVersion()!=1 do throw "Load the matching native curve preset evaluator."
        local stored=if target.category=="density_curve" then owner.fallDensityCurve else owner.fallScaleCurve,packed=if target.category=="density_curve" then owner.fallDensityGraph else owner.fallScaleGraph
        if stored.count>257 or packed.count>65536 do throw "Stored curve exceeds the preset application bound."
        local prepared=cyrusPresetDecode (cyrusPresetPrepareCurve (cyrusPresetEncode document[1] document[2] values) (target.category=="scale_curve"))
        values=prepared[3]
        curveSamples=for v in values[1] collect (v as float)
        curveGraph=CyrusFallPack (for v in values[2] collect (v as float))
    )
    local fields=for f in schema collect (f[1] as name)
    if target.category=="population" do (
        local index=findItem fields #randomSeed
        if seedPolicy==#current then values[index]=owner.randomSeed
        else if seedPolicy==#new do (
            local identity=(dotNetClass "System.Guid").NewGuid()
            local chosen=bit.and (identity.GetHashCode()) 2147483647
            if chosen==owner.randomSeed do chosen=if chosen==2147483647 then 0 else chosen+1
            values[index]=chosen
        )
    )
    if target.category=="spacing" then (
        fields=if target.peer==undefined then #(#procSelfEnabled,#procSelfMultiplier,#procSelfGap,#procSelfPlanar) else #()
        values[3]*=meters
    ) else if target.editor==undefined do for i=1 to fields.count where schema[i][3] do values[i]*=meters
    if target.editor==undefined and not globalCurve do for v in values where classof v!=BooleanClass do if v!=v or abs v>1e30 do throw "Preset units exceed the scene's supported numeric range."
    if target.category=="transforms" do (
        local modeIndex=findItem fields #orientationMode
        if values[modeIndex]==3 and not isValidNode owner.orientationTarget do throw "Pick a destination target before applying Look at target settings, or import a complete recipe with its target binding."
    )
    local controllers=#()
    for field in fields do (
        local control=getPropertyController owner field
        if control!=undefined do (
            if findItem #(Bezier_Float,Linear_Float,TCB_Float) (classof control)==0 or (numKeys control)!=0 do throw "Apply requires static numeric settings. Animated or wired target parameters are preserved."
            append controllers #(field,control)
        )
    )
    -- A valid identical apply is passive. Inheritance/explicit relationship
    -- ownership and a pending curve edit are authored differences too.
    local unchanged=false
    if globalCurve then (
        local density=target.category=="density_curve"
        unchanged=CyrusPresetSameValues ((if density then owner.fallDensityCurve else owner.fallScaleCurve) as array) curveSamples
        unchanged=unchanged and CyrusFallGraphsEqual (if density then owner.fallDensityGraph else owner.fallScaleGraph) curveGraph
    ) else if target.editor!=undefined then (
        unchanged=not target.editor.pendingCurve and CyrusPresetSameValues (target.editor.presetValues()) values
    ) else if target.category=="spacing" then (
        local prior=CyrusPresetCapture target
        prior[3]*=meters
        unchanged=CyrusPresetSameValues prior values
        if target.peer==undefined then unchanged=unchanged and owner.procSelfOverride
        else unchanged=unchanged and (target.root.procPair 2 owner target.peer)>0
    ) else (
        local prior=for field in fields collect (getProperty owner field)
        unchanged=CyrusPresetSameValues prior values
    )
    if unchanged do return false
    -- Reconstruct and validate editor-only data before starting authored Undo.
    local curveRollback=if target.editor==undefined then undefined else target.editor.presetPrepare values
    local priorTransfer=owner.getLayerTransfer(),priorSuspended=CyrusPointSuspended
    if ownHold do theHold.Begin()
    CyrusPointSuspended=true;owner.setLayerTransfer true
    try (
        with animate off (
            -- Detach static controllers before changing their values, preserving
            -- other owners that shared the original controller.
            for pair in controllers do setPropertyController owner pair[1] (copy pair[2])
            if globalCurve then (
                if target.category=="density_curve" then (owner.fallDensityCurve=curveSamples;owner.fallDensityGraph=curveGraph)
                else (owner.fallScaleCurve=curveSamples;owner.fallScaleGraph=curveGraph)
            ) else if target.editor!=undefined then target.editor.presetApply values
            else if target.category=="spacing" and target.peer!=undefined then target.root.procSetPair 2 owner target.peer values[1] values[2] values[3] values[4]
            else (
                if target.category=="spacing" do owner.procSelfOverride=true
                for i=1 to fields.count do setProperty owner fields[i] values[i]
            )
        )
        owner.setLayerTransfer priorTransfer;CyrusPointSuspended=priorSuspended
        if ownHold do theHold.Accept "Cyrus apply preset"
    )catch(
        local failure=getCurrentException()
        if ownHold do theHold.Cancel()
        owner.setLayerTransfer priorTransfer;CyrusPointSuspended=priorSuspended
        if target.editor!=undefined do target.editor.presetRestore curveRollback
        throw()
    )
    owner.markInputDirty()
    if ownHold do (target.root.bindNativeUI();CyrusViewportRedraw())
    true
)
fn CyrusPresetDirectory = (pathConfig.appendPath (getDir #plugcfg) "CyrusScatter\\Presets")
fn CyrusPresetRead path = (
    local file=dotNetObject "System.IO.FileInfo" path
    if not file.Exists do throw "The preset file no longer exists. Refresh the list."
    if file.Length>65536 do throw "Preset files are limited to 64 KiB."
    local stream=dotNetObject "System.IO.FileStream" path (dotNetClass "System.IO.FileMode").Open (dotNetClass "System.IO.FileAccess").Read (dotNetClass "System.IO.FileShare").Read
    local reader=undefined,text=""
    try (
        if stream.Length>65536 do throw "Preset files are limited to 64 KiB."
        reader=dotNetObject "System.IO.StreamReader" stream (dotNetObject "System.Text.UTF8Encoding" false true) false
        text=reader.ReadToEnd();reader.Close()
    )catch(local failure=getCurrentException();if reader!=undefined do reader.Close();stream.Close();throw())
    cyrusPresetDecode text
)
fn CyrusPresetWrite path document replace:false = (
    local text=cyrusPresetEncode document[1] document[2] document[3],io=dotNetClass "System.IO.File",dir=dotNetClass "System.IO.Path"
    local directory=dir.GetDirectoryName path
    (dotNetClass "System.IO.Directory").CreateDirectory directory
    local temp=pathConfig.appendPath directory (CyrusNewLayerID()+".tmp")
    local backup=temp+".bak"
    try (
        io.WriteAllText temp text (dotNetObject "System.Text.UTF8Encoding" false true)
        CyrusPresetRead temp
        if replace then io.Replace temp path backup else io.Move temp path
    )catch(local failure=getCurrentException();if io.Exists temp do io.Delete temp;throw())
    -- Replacement is already committed; backup cleanup cannot undo that success.
    if io.Exists backup do try(io.Delete backup)catch()
    true
)
fn CyrusPresetEntries directory category = (
    if not (dotNetClass "System.IO.Directory").Exists directory do return #(#(),0)
    local files=getFiles (pathConfig.appendPath directory "*.cspreset.json"),items=#(),invalid=0
    if files.count>512 do throw "The preset folder contains more than 512 items. Move unused files to another folder."
    for path in files do try (
        local document=CyrusPresetRead path
        if document[1]==category do append items #(path,document[2])
    )catch(invalid+=1)
    #(items,invalid)
)
fn CyrusOpenPresets root owner category peer:undefined editor:undefined = (
    if cyrusPresetVersion==undefined or cyrusPresetVersion()!=3 do throw "Load the matching Cyrus preset native module."
    local target=CyrusPresetMakeBinding root owner category peer:peer editor:editor
    CyrusPresetCheckBinding target
    if CyrusPresetBrowser!=undefined do try(destroyDialog CyrusPresetBrowser)catch()
    rollout browser "Cyrus presets" width:420 height:385 (
        local target=undefined,entries=#(),directory=""
        label targetInfo "" pos:[12,10] width:396 height:38
        listbox presets "Saved presets" pos:[12,50] width:396 height:8
        edittext presetName "Name:" pos:[12,190] width:396
        button saveNew "Save new" pos:[12,220] width:90
        button applyPreset "Apply" pos:[112,220] width:90
        button renamePreset "Rename" pos:[212,220] width:90
        button deletePreset "Delete" pos:[312,220] width:96
        button refreshList "Refresh" pos:[12,255] width:90
        button closeButton "Close" pos:[312,255] width:96
        dropdownlist seedChoice "Amount seed:" items:#("Saved seed","Keep current seed","New seed") selection:1 pos:[12,288] width:396 tooltip:"Amount presets save a seed, not receiver variation domains. Changing this choice does not change the scene."
        label status "Selecting a preset does not change the scene." pos:[12,336] width:396 height:44
        fn refresh selectPath:undefined = (
            if selectPath==undefined and presets.selection>0 and presets.selection<=entries.count do selectPath=entries[presets.selection][1]
            local result=CyrusPresetEntries directory target.category
            entries=result[1];presets.items=for item in entries collect item[2]
            local selected=0
            for i=1 to entries.count where entries[i][1]==selectPath do selected=i
            presets.selection=if selected>0 then selected else if entries.count>0 then 1 else 0
            presetName.text=if presets.selection>0 then entries[presets.selection][2] else ""
            status.text=(entries.count as string)+" saved; "+(result[2] as string)+" invalid files skipped. Select, then Apply."
        )
        fn selectedPath = (if presets.selection<1 or presets.selection>entries.count then throw "Select a saved preset." else entries[presets.selection][1])
        fn enteredName = (local value=trimRight (trimLeft presetName.text);if value=="" do throw "Enter a preset name.";value)
        on browser open do (
            target=CyrusPresetOpenBinding;directory=CyrusPresetDirectory()
            seedChoice.visible=target.category=="population";seedChoice.enabled=seedChoice.visible
            targetInfo.text=(target.root.layerCaption (target.root.logicalParent target.owner))+" / "+target.category+(if target.peer!=undefined then " / "+target.root.layerCaption target.peer else "")
            if target.editor!=undefined do targetInfo.text+=("\nCurve is "+(if target.editor.presetEnabled() then "enabled" else "disabled")+". Apply preserves this state.")
            try(refresh())catch(status.text=getCurrentException())
        )
        on presets selected i do if i>0 and i<=entries.count do presetName.text=entries[i][2]
        on saveNew pressed do try(
            if (getFiles (pathConfig.appendPath directory "*.cspreset.json")).count>=512 do throw "The preset library is full (512 files)."
            local document=#(target.category,enteredName(),CyrusPresetCapture target)
            local path=pathConfig.appendPath directory (CyrusNewLayerID()+".cspreset.json")
            CyrusPresetWrite path document;refresh selectPath:path;status.text="Preset saved. Scene settings are unchanged."
        )catch(status.text=getCurrentException())
        on applyPreset pressed do try(
            local document=CyrusPresetRead (selectedPath())
            local changed=CyrusPresetApply target document seedPolicy:(if target.category=="population" then #(#saved,#current,#new)[seedChoice.selection] else #saved)
            status.text=if not changed then "Already applied. Scene and Undo are unchanged." else if target.root.updateMode==1 then "Applied. Manual mode: use Update scatter." else "Applied. Live update follows the normal dependency rules."
        )catch(status.text=getCurrentException())
        on renamePreset pressed do try(
            local path=selectedPath(),document=CyrusPresetRead path
            document[2]=enteredName();CyrusPresetWrite path document replace:true;refresh selectPath:path
        )catch(status.text=getCurrentException())
        on deletePreset pressed do try(
            local path=selectedPath()
            if queryBox ("Delete preset '"+entries[presets.selection][2]+"'?") title:"Cyrus presets" do ((dotNetClass "System.IO.File").Delete path;refresh())
        )catch(status.text=getCurrentException())
        on refreshList pressed do try(refresh())catch(status.text=getCurrentException())
        on closeButton pressed do destroyDialog browser
        on browser close do CyrusPresetBrowser=undefined
    )
    CyrusPresetOpenBinding=target;CyrusPresetBrowser=browser
    createDialog browser style:#(#style_titlebar,#style_sysmenu,#style_toolwindow)
    true
)

