{
  "name": "cyrus-presentation-studio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev:studio": "vite --config vite.studio.config.ts",
    "dev:player": "vite --config vite.player.config.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:browser": "playwright test",
    "build:player": "vite build --config vite.player.config.ts && node tools/embed-player.mjs",
    "build:studio": "vite build --config vite.studio.config.ts",
    "build": "npm run typecheck && npm run build:player && npm run build:studio",
    "verify:export": "node --import tsx tools/verify-export.mjs",
    "prepare:asset": "node tools/prepare-asset.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "fflate": "0.8.3",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.15",
    "@types/three": "0.186.0",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
