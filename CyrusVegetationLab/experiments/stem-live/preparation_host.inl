prep::Snapshot snapshot(INode* node){
    if(!node)throw std::runtime_error("Source is missing.");TimeValue t=GetCOREInterface()->GetTime();auto* object=node->EvalWorldState(t).obj;
    if(!object||!object->CanConvertToType(triObjectClassID))throw std::runtime_error("Source is not convertible to triangles.");
    auto* tri=static_cast<TriObject*>(object->ConvertToType(t,triObjectClassID));prep::Snapshot out;
    try {const auto& mesh=tri->GetMesh();if(mesh.numVerts<3||mesh.numVerts>1000000||mesh.numFaces<1||mesh.numFaces>2000000)throw std::runtime_error("Analysis admission: 1M vertices / 2M triangles.");
        auto tm=node->GetObjectTM(t);float unit=float(GetSystemUnitScale(UNITS_METERS));if(!std::isfinite(unit)||unit<1e-9||unit>1000)throw std::runtime_error("Unsupported system units.");out.positions.reserve(mesh.numVerts);out.faces.reserve(mesh.numFaces);out.materials.reserve(mesh.numFaces);
        for(int i=0;i<mesh.numVerts;++i){Point3 p=(mesh.verts[i]*tm)*unit;out.positions.push_back({p.x,p.y,p.z});}
        for(int i=0;i<mesh.numFaces;++i){auto f=mesh.faces[i];out.faces.push_back({f.v[0],f.v[1],f.v[2]});out.materials.push_back(f.getMatID());}
        out.fingerprint=prep::fingerprint(out);
    }catch(...){if(tri!=object)tri->DeleteThis();throw;}if(tri!=object)tri->DeleteThis();return out;
}
